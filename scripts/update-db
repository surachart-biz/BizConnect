#!/usr/bin/env bash
#
# BizConnect Database Migration Workflow - Cross-Platform Launcher
#
# This script automatically detects the environment and calls the appropriate
# database migration script:
# - PowerShell environments: calls update-db.ps1
# - Bash/Zsh/other shells: calls update-db.sh
#
# Usage:
#   ./scripts/update-db
#
# Requirements:
# - PowerShell 5+ OR Bash with jq installed
# - .NET 8 SDK with dotnet-ef tool
# - PostgreSQL client (psql)
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_header() {
    echo -e "${BLUE}🚀 BizConnect Database Migration Workflow${NC}"
    echo -e "${BLUE}===========================================${NC}"
}

# Get the script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

print_header

# Detect if we're running in PowerShell
if [ -n "$PSVersionTable" ] || [ -n "$PSHOME" ] || [ "$0" = "pwsh" ] || [ "$0" = "powershell" ]; then
    print_info "PowerShell environment detected"
    print_info "Launching PowerShell script..."
    
    # Check if PowerShell script exists
    if [ ! -f "$SCRIPT_DIR/update-db.ps1" ]; then
        print_error "PowerShell script not found: $SCRIPT_DIR/update-db.ps1"
        exit 1
    fi
    
    # Pass along PG_BIN environment variable if set
    if [ -n "${PG_BIN:-}" ]; then
        export PG_BIN
    fi

    # Try to run with pwsh first, then powershell
    if command -v pwsh >/dev/null 2>&1; then
        exec pwsh -File "$SCRIPT_DIR/update-db.ps1" "$@"
    elif command -v powershell >/dev/null 2>&1; then
        exec powershell -File "$SCRIPT_DIR/update-db.ps1" "$@"
    else
        print_error "PowerShell not found in PATH"
        print_info "Please install PowerShell Core (pwsh) or Windows PowerShell"
        exit 1
    fi
else
    # We're in a Unix-like shell (bash, zsh, etc.)
    print_info "Unix shell environment detected"
    print_info "Launching Bash script..."
    
    # Check if Bash script exists
    if [ ! -f "$SCRIPT_DIR/update-db.sh" ]; then
        print_error "Bash script not found: $SCRIPT_DIR/update-db.sh"
        exit 1
    fi
    
    # Pass along PG_BIN environment variable if set
    if [ -n "${PG_BIN:-}" ]; then
        export PG_BIN
    fi

    # Add tools directory to PATH for auto-downloaded tools (like jq.exe)
    TOOLS_DIR="$SCRIPT_DIR/tools"
    if [ -d "$TOOLS_DIR" ]; then
        export PATH="$TOOLS_DIR:$PATH"
    fi

    # Make sure the script is executable
    chmod +x "$SCRIPT_DIR/update-db.sh"

    # Execute the Bash script
    exec bash "$SCRIPT_DIR/update-db.sh" "$@"
fi
