{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=bizconnect;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KBankODD": {
    "BaseUrl": "https://ws06.kasikornbank.com",
    "PGBaseUrl": "https://ws06.kasikornbank.com",
    "AppBaseUrl": "https://bizconnect.example.com",
    "ExternalSystem": "BIZCONNECT",
    "ServiceName": "BizConnect Online Direct Debit"
    // PassPhrase is stored in secrets only:
    // - Dev: dotnet user-secrets (key: KBankODD:PassPhrase)
    // - CI/Prod: GitLab variable KBankODD__PassPhrase
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "SpecialCharacters": "!@#$%^&*()_+-=[]{}|;:,.<>?",
    "PreventUsernameInPassword": true,
    "CheckAgainstCommonPasswords": true,
    "PasswordHistoryCount": 5,
    "PasswordExpirationDays": 90,
    "PasswordExpirationWarningDays": 14,
    "MaxRepeatingCharacters": 3,
    "PreventSequentialCharacters": true,
    "MinimumStrengthScore": 60
  },
  "RateLimiting": {
    "login": {
      "MaxAttempts": 5,
      "LockoutDurationMinutes": 15,
      "AttemptWindowMinutes": 15,
      "EnableUserLockout": true,
      "EnableIpLockout": true
    },
    "api": {
      "MaxAttempts": 100,
      "LockoutDurationMinutes": 5,
      "AttemptWindowMinutes": 1,
      "EnableUserLockout": false,
      "EnableIpLockout": true
    }
  },
  "Caching": {
    "MemoryCache": {
      "SizeLimitMB": 100,
      "CompactionPercentage": 0.25,
      "DefaultSlidingExpirationMinutes": 30,
      "GetByIdExpirationMinutes": 15,
      "ShortExpirationMinutes": 2,
      "LongExpirationMinutes": 60
    },
    "Performance": {
      "EnableCacheStatistics": false,
      "LogCacheHitMiss": false,
      "EnableDetailedLogging": false
    },
    "Policies": {
      "MaxKeyLength": 250,
      "MaxValueSizeKB": 1024,
      "EnablePatternInvalidation": true
    }
  }
}
