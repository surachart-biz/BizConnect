{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=bizconnect;Username=postgres;Password=postgres;Pooling=true;MinPoolSize=5;MaxPoolSize=100;ConnectionLifetime=300"
  },
  "Database": {
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30"
  },
  "Authentication": {
    "CookieName": "BizConnect.Auth",
    "LoginPath": "/Account/Login",
    "LogoutPath": "/Account/Logout",
    "AccessDeniedPath": "/Account/AccessDenied",
    "ExpireTimeSpan": "01:00:00",
    "SlidingExpiration": true,
    "RequireHttps": false,
    "SameSiteMode": "Lax"
  },
  "SessionManagement": {
    "MaxConcurrentSessions": 3,
    "SessionTimeout": "01:00:00",
    "AbsoluteTimeout": "08:00:00",
    "EnableConcurrentSessionLimit": true,
    "EnableSessionTimeout": true,
    "LogSessionActivity": true,
    "CleanupInterval": "00:30:00"
  },
  "Security": {
    "RequireHttps": false,
    "HstsMaxAge": "30.00:00:00",
    "IncludeSubdomains": false,
    "Preload": false
  },
  "Performance": {
    "EnableResponseCompression": true,
    "EnableResponseCaching": true,
    "CompressionLevel": "Optimal",
    "CacheStaticFiles": true,
    "StaticFileCacheDuration": "365.00:00:00",
    "ApiCacheDuration": "00:05:00",
    "HtmlCacheDuration": "01:00:00",
    "CacheProfiles": {
      "Default": {
        "Duration": 60,
        "Location": "Any"
      }
    }
  },
  "Caching": {
    "DefaultExpiration": "00:30:00",
    "SlidingExpiration": "00:05:00",
    "MaxCacheSize": 1000,
    "EnableCompression": true,
    "EnableStatistics": true,
    "KeyPrefix": "bizconnect:"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bizconnect-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/audit/audit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "BizConnect"
    }
  },
  "AllowedHosts": "*",
  "PasswordHashing": {
    "WorkFactor": 10,
    "MinimumLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigits": true,
    "RequireSpecialCharacters": false
  },
  "RateLimiting": {
    "EnableGeneralRateLimit": false,
    "EnableLogging": true,
    "SkipPaths": [
      "/health",
      "/api/health",
      "/favicon.ico",
      "/css/",
      "/js/",
      "/lib/",
      "/images/"
    ]
  },
  "Security": {
    "HttpsPort": 5001,
    "Hsts": {
      "Preload": false,
      "IncludeSubDomains": false,
      "MaxAgeDays": 30
    },
    "Cookies": {
      "RequireConsent": false,
      "SameSiteMode": "Lax"
    },
    "Headers": {
      "EnableXFrameOptions": true,
      "XFrameOptions": "SAMEORIGIN",
      "EnableXContentTypeOptions": true,
      "EnableReferrerPolicy": true,
      "ReferrerPolicy": "strict-origin-when-cross-origin",
      "EnableContentSecurityPolicy": false,
      "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;",
      "EnablePermissionsPolicy": false,
      "PermissionsPolicy": "camera=(), microphone=(), geolocation=()"
    },
    "Cors": {
      "EnableCors": false,
      "AllowedOrigins": [],
      "AllowedMethods": ["GET", "POST"],
      "AllowedHeaders": ["Content-Type", "Authorization"],
      "AllowCredentials": false
    }
  },
  "InputValidation": {
    "EnableValidation": true,
    "LogWarnings": true,
    "MaxFileSize": 10485760,
    "AllowedFileExtensions": [
      ".jpg", ".jpeg", ".png", ".gif", ".pdf", ".doc", ".docx", ".txt", ".csv"
    ],
    "AllowedMimeTypes": [
      "image/jpeg", "image/png", "image/gif", "application/pdf",
      "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "text/plain", "text/csv"
    ],
    "SkipPaths": [
      "/health", "/api/health", "/favicon.ico", "/css/", "/js/", "/lib/", "/images/"
    ]
  },
  "Environment": {
    "Name": "Base",
    "DisplayName": "Base Configuration"
  }
}
