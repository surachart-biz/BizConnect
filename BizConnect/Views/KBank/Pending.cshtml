@{
    ViewData["Title"] = "Registration Processing";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <!-- Pending Header -->
            <div class="text-center mb-4">
                <div class="bc-pending-header">
                    <div class="bc-pending-icon-wrapper mb-3">
                        <i class="fas fa-clock text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="h2 mb-2 text-warning">Registration Processing</h1>
                    <p class="text-muted">Your KBank Online Direct Debit registration is being processed</p>
                </div>
            </div>

            <!-- Pending Details Card -->
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-hourglass-half me-2"></i>Processing Your Request
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Please Wait:</strong> Your KBank Online Direct Debit registration is currently being processed.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-warning mb-3">
                                <i class="fas fa-list-check me-2"></i>What's Happening?
                            </h6>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-arrow-right text-warning me-2"></i>
                                    Verifying your personal information
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-arrow-right text-warning me-2"></i>
                                    Checking account eligibility
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-arrow-right text-warning me-2"></i>
                                    Setting up automatic debit authorization
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-arrow-right text-warning me-2"></i>
                                    Finalizing registration details
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-warning mb-3">
                                <i class="fas fa-clock me-2"></i>Expected Timeline
                            </h6>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-stopwatch text-info me-2"></i>
                                    Processing time: 1-5 minutes
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check-circle text-primary me-2"></i>
                                    Confirmation will be displayed on screen
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-mobile-alt text-success me-2"></i>
                                    SMS notification upon completion
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-refresh text-secondary me-2"></i>
                                    Page will auto-refresh every 30 seconds
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-4">
                        <h6 class="text-warning mb-2">
                            <i class="fas fa-tasks me-2"></i>Processing Progress
                        </h6>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" 
                                 role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                Processing... 75%
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Information Card -->
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-lightbulb me-2"></i>While You Wait
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Please keep this page open until processing is complete</li>
                        <li>Do not refresh the page manually - it will auto-refresh</li>
                        <li>Check your email and SMS for updates</li>
                        <li>If processing takes longer than expected, contact support</li>
                    </ul>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center mt-4">
                <button onclick="window.location.reload()" class="btn btn-outline-warning me-3">
                    <i class="fas fa-sync-alt me-2"></i>Refresh Status
                </button>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="fas fa-home me-2"></i>Return to Home
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto-refresh the page every 30 seconds to check for status updates
    setTimeout(function() {
        window.location.reload();
    }, 30000);

    // Add a countdown timer
    let countdown = 30;
    const countdownElement = document.createElement('div');
    countdownElement.className = 'text-center mt-3 text-muted';
    countdownElement.innerHTML = `<small><i class="fas fa-clock me-1"></i>Auto-refresh in <span id="countdown">${countdown}</span> seconds</small>`;
    document.querySelector('.container-fluid').appendChild(countdownElement);

    const countdownTimer = setInterval(function() {
        countdown--;
        document.getElementById('countdown').textContent = countdown;
        if (countdown <= 0) {
            clearInterval(countdownTimer);
        }
    }, 1000);
</script>

<style>
    .bc-pending-header {
        margin-bottom: 2rem;
    }
    
    .bc-pending-icon-wrapper {
        display: inline-block;
        padding: 1.5rem;
        background: rgba(255, 193, 7, 0.1);
        border-radius: 50%;
        animation: pendingPulse 2s ease-in-out infinite;
    }
    
    @@keyframes pendingPulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }
    
    .card {
        border-radius: 0.5rem;
    }
    
    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }
    
    .alert-warning {
        border-left: 4px solid #ffc107;
    }
    
    .progress-bar-animated {
        animation: progress-bar-stripes 1s linear infinite;
    }
</style>
