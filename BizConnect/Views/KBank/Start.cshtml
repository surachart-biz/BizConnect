@{
    ViewData["Title"] = "Access Code Generated";
    var otacCode = ViewData["OtacCode"]?.ToString();
    var registrationId = ViewData["RegistrationId"]?.ToString();
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <!-- Page Header -->
            <div class="text-center mb-4">
                <div class="bc-page-header">
                    <div class="bc-icon-wrapper mb-3">
                        <i class="fas fa-key text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="h2 mb-2">Access Code Generated</h1>
                    <p class="text-muted">Use this code to continue with your KBank registration</p>
                </div>
            </div>

            <!-- OTAC Display Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-shield-alt me-2"></i>Your Access Code
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="otac-display mb-4">
                        <div class="otac-code-container">
                            <code class="otac-code" id="otacCode">@otacCode</code>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="copyBtn">
                            <i class="fas fa-copy me-1"></i>Copy Code
                        </button>
                    </div>

                    <div class="alert alert-warning mb-4" role="alert">
                        <i class="fas fa-clock me-2"></i>
                        <strong>Important:</strong> This code expires in <strong>30 minutes</strong>. 
                        Please proceed to the registration form promptly.
                    </div>

                    <div class="d-grid">
                        <a href="@Url.Action("RegisterForm", "KBank", new { otac = otacCode })" 
                           class="btn btn-primary btn-lg">
                            <i class="fas fa-arrow-right me-2"></i>Continue to Registration Form
                        </a>
                    </div>
                </div>
            </div>

            <!-- Instructions Card -->
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Next Steps
                    </h6>
                </div>
                <div class="card-body">
                    <ol class="mb-0">
                        <li>Copy or remember your access code: <strong>@otacCode</strong></li>
                        <li>Click "Continue to Registration Form" or navigate manually</li>
                        <li>Enter your access code when prompted</li>
                        <li>Complete the registration form with your details</li>
                        <li>You'll be redirected to KBank for final verification</li>
                    </ol>
                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-lock me-1"></i>
                    This code is valid for one-time use only and expires in 30 minutes
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const copyBtn = document.getElementById('copyBtn');
            const otacCode = document.getElementById('otacCode');

            copyBtn.addEventListener('click', function() {
                // Copy to clipboard
                navigator.clipboard.writeText(otacCode.textContent).then(function() {
                    // Show success feedback
                    const originalText = copyBtn.innerHTML;
                    copyBtn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                    copyBtn.classList.remove('btn-outline-secondary');
                    copyBtn.classList.add('btn-success');

                    // Reset after 2 seconds
                    setTimeout(function() {
                        copyBtn.innerHTML = originalText;
                        copyBtn.classList.remove('btn-success');
                        copyBtn.classList.add('btn-outline-secondary');
                    }, 2000);
                }).catch(function(err) {
                    console.error('Could not copy text: ', err);
                    // Fallback for older browsers
                    const range = document.createRange();
                    range.selectNode(otacCode);
                    window.getSelection().removeAllRanges();
                    window.getSelection().addRange(range);
                    document.execCommand('copy');
                    window.getSelection().removeAllRanges();

                    copyBtn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                    copyBtn.classList.remove('btn-outline-secondary');
                    copyBtn.classList.add('btn-success');

                    setTimeout(function() {
                        copyBtn.innerHTML = '<i class="fas fa-copy me-1"></i>Copy Code';
                        copyBtn.classList.remove('btn-success');
                        copyBtn.classList.add('btn-outline-secondary');
                    }, 2000);
                });
            });
        });
    </script>

    <style>
        .bc-page-header {
            margin-bottom: 2rem;
        }

        .bc-icon-wrapper {
            display: inline-block;
            padding: 1rem;
            background: rgba(25, 135, 84, 0.1);
            border-radius: 50%;
        }

        .otac-code-container {
            background: #f8f9fa;
            border: 2px dashed #28a745;
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .otac-code {
            font-size: 2rem;
            font-weight: bold;
            letter-spacing: 0.2em;
            color: #28a745;
            background: none;
            border: none;
            padding: 0;
        }

        .card {
            border-radius: 0.5rem;
        }

        .card-header {
            border-radius: 0.5rem 0.5rem 0 0 !important;
        }

        @@media (max-width: 576px) {
            .otac-code {
                font-size: 1.5rem;
            }
        }
    </style>
}