@model KBankOddRegisterViewModel
@{
    ViewData["Title"] = "KBank ODD Registration";
    var registrationId = ViewData["RegistrationId"];
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <!-- Page Header -->
            <div class="text-center mb-4">
                <div class="bc-page-header">
                    <div class="bc-icon-wrapper mb-3">
                        <i class="fas fa-university text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="h2 mb-2">KBank Online Direct Debit</h1>
                    <p class="text-muted">Complete your registration to enable automatic payments</p>
                </div>
            </div>

            <!-- Registration Form Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-plus me-2"></i>Registration Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="RegisterForm" method="post" id="oddRegistrationForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="registrationId" value="@registrationId" />
                        
                        <!-- Full Name Field -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label required">
                                <i class="fas fa-user me-1"></i>ชื่อ-นามสกุล (Full Name)
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="กรอกชื่อ-นามสกุล / Enter your full name" 
                                   autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Mobile Number Field -->
                        <div class="mb-3">
                            <label asp-for="MobileNo" class="form-label required">
                                <i class="fas fa-mobile-alt me-1"></i>เบอร์โทรศัพท์ (Mobile Number)
                            </label>
                            <input asp-for="MobileNo" class="form-control" placeholder="08xxxxxxxx หรือ +66xxxxxxxx" 
                                   autocomplete="tel" />
                            <div class="form-text">
                                <small>รูปแบบ: 08xxxxxxxx หรือ +66xxxxxxxx / Format: 08xxxxxxxx or +66xxxxxxxx</small>
                            </div>
                            <span asp-validation-for="MobileNo" class="text-danger"></span>
                        </div>

                        <!-- National ID Field -->
                        <div class="mb-3">
                            <label asp-for="IdValue" class="form-label required">
                                <i class="fas fa-id-card me-1"></i>เลขบัตรประชาชน (National ID)
                            </label>
                            <input asp-for="IdValue" class="form-control" placeholder="กรอกเลขบัตรประชาชน 13 หลัก / Enter 13-digit National ID" 
                                   id="nationalIdInput" maxlength="13" pattern="[0-9]{13}" />
                            <div class="form-text">
                                <small>เลขบัตรประชาชนต้องมี 13 หลัก / National ID must be exactly 13 digits</small>
                            </div>
                            <span asp-validation-for="IdValue" class="text-danger"></span>
                        </div>

                        <!-- Account Number Field -->
                        <div class="mb-3">
                            <label asp-for="AccountNo" class="form-label required">
                                <i class="fas fa-credit-card me-1"></i>เลขที่บัญชี (Account Number)
                            </label>
                            <input asp-for="AccountNo" class="form-control" placeholder="กรอกเลขที่บัญชีธนาคาร / Enter your bank account number" 
                                   autocomplete="off" />
                            <div class="form-text">
                                <small>เลขที่บัญชีต้องมี 10-15 หลัก / Account number must be 10-15 digits</small>
                            </div>
                            <span asp-validation-for="AccountNo" class="text-danger"></span>
                        </div>

                        <!-- Branch Field -->
                        <div class="mb-4">
                            <label asp-for="BranchId" class="form-label required">
                                <i class="fas fa-building me-1"></i>สาขา (Branch)
                            </label>
                            <select asp-for="BranchId" asp-items="@Model.Branches" 
                                    class="form-select">
                                <option value="">-- เลือกสาขา / Select Branch --</option>
                            </select>
                            <div class="form-text">
                                <small>กรุณาเลือกสาขาที่คุณต้องการลงทะเบียน / Please select your preferred branch</small>
                            </div>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Start", "KBank")" class="btn btn-outline-secondary me-md-2">
                                <i class="fas fa-arrow-left me-1"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-check me-1"></i>Confirm Registration
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Information Card -->
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Important Information
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>You will be redirected to KBank's secure registration page after submitting this form</li>
                        <li>Please ensure all information is accurate before proceeding</li>
                        <li>Your mobile number will be used for SMS verification</li>
                        <li>Keep your ID document ready for verification</li>
                        <li>Ensure your bank account number is correct (10-15 digits)</li>
                        <li>Select the appropriate branch for your registration</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nationalIdInput = document.getElementById('nationalIdInput');
            const form = document.getElementById('oddRegistrationForm');
            const submitBtn = document.getElementById('submitBtn');

            // National ID validation
            if (nationalIdInput) {
                nationalIdInput.addEventListener('input', function(e) {
                    let value = e.target.value;
                    // Remove non-numeric characters
                    value = value.replace(/[^\d]/g, '');
                    e.target.value = value;
                    
                    // Real-time validation
                    validateNationalId(e.target);
                });

                nationalIdInput.addEventListener('blur', function(e) {
                    validateNationalId(e.target);
                });
            }

            function validateNationalId(input) {
                const value = input.value.trim();
                const nationalIdPattern = /^[0-9]{13}$/;
                
                if (!value) {
                    input.classList.remove('is-valid', 'is-invalid');
                    return;
                }
                
                if (nationalIdPattern.test(value) && isValidThaiNationalId(value)) {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                    // Remove custom error message
                    const errorSpan = input.parentNode.querySelector('.national-id-error');
                    if (errorSpan) errorSpan.remove();
                } else {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    // Add custom error message
                    let errorSpan = input.parentNode.querySelector('.national-id-error');
                    if (!errorSpan) {
                        errorSpan = document.createElement('div');
                        errorSpan.className = 'national-id-error text-danger small mt-1';
                        input.parentNode.appendChild(errorSpan);
                    }
                    errorSpan.textContent = 'เลขบัตรประชาชนไม่ถูกต้อง กรุณาตรวจสอบ / Invalid National ID format';
                }
            }

            // Thai National ID validation algorithm
            function isValidThaiNationalId(id) {
                if (id.length !== 13) return false;
                
                let sum = 0;
                for (let i = 0; i < 12; i++) {
                    sum += parseInt(id.charAt(i)) * (13 - i);
                }
                
                const remainder = sum % 11;
                const checkDigit = (11 - remainder) % 10;
                
                return checkDigit === parseInt(id.charAt(12));
            }

            // Form submission with loading state
            form.addEventListener('submit', function(e) {
                if (form.checkValidity()) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                }
            });

            // Enhanced mobile number validation
            const mobileInput = document.querySelector('input[name="MobileNo"]');
            if (mobileInput) {
                mobileInput.addEventListener('input', function(e) {
                    let value = e.target.value;
                    // Remove non-numeric characters except + and -
                    value = value.replace(/[^\d+\-]/g, '');
                    e.target.value = value;
                });
                
                mobileInput.addEventListener('blur', function(e) {
                    validateMobileNumber(e.target);
                });
            }

            function validateMobileNumber(input) {
                const value = input.value.trim();
                const thaiMobilePattern = /^(08|09|06|07)\d{8}$/;
                const internationalPattern = /^\+66[6-9]\d{8}$/;
                
                if (value && !thaiMobilePattern.test(value) && !internationalPattern.test(value)) {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    // Add custom error message
                    let errorSpan = input.parentNode.querySelector('.mobile-error');
                    if (!errorSpan) {
                        errorSpan = document.createElement('div');
                        errorSpan.className = 'mobile-error text-danger small mt-1';
                        input.parentNode.appendChild(errorSpan);
                    }
                    errorSpan.textContent = 'กรุณาใส่เบอร์โทรศัพท์ที่ถูกต้อง (08xxxxxxxx หรือ +66xxxxxxxx) / Please enter a valid mobile number';
                } else if (value) {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                    // Remove error message
                    const errorSpan = input.parentNode.querySelector('.mobile-error');
                    if (errorSpan) errorSpan.remove();
                } else {
                    input.classList.remove('is-valid', 'is-invalid');
                }
            }

            // Real-time validation feedback
            const inputs = form.querySelectorAll('input, select');
            inputs.forEach(input => {
                input.addEventListener('blur', validateField);
                input.addEventListener('input', clearFieldError);
            });

            function validateField(e) {
                const field = e.target;
                
                // Skip mobile number and national ID as they have custom validation
                if (field.name === 'MobileNo' || field.id === 'nationalIdInput') return;

                if (field.checkValidity()) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                }
            }

            function clearFieldError(e) {
                const field = e.target;
                field.classList.remove('is-invalid');
                // Clear custom error messages
                const errorSpan = field.parentNode.querySelector('.mobile-error, .national-id-error');
                if (errorSpan) errorSpan.remove();
            }
        });
    </script>
}