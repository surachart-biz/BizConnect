@using BizConnect.ViewModels.Modern
@model ModernRegistrationViewModel
@{
    await Html.PartialAsync("_LanguageTexts");
    ViewData["Title"] = ViewBag.IsThaiLanguage ? "ลงทะเบียนหักบัญชีอัตโนมัติ" : "Direct Debit Registration";
}

@section Styles {
    <style>
        .register-container {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 2rem 0;
        }

        .register-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
            padding: 3rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .register-header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .register-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #0066CC, #004499);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: white;
            font-size: 2rem;
        }

        .register-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }

        .register-subtitle {
            color: #6c757d;
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }

        .otac-display {
            background: linear-gradient(135deg, #e8f5e8, #d4edda);
            border: 2px solid #28a745;
            border-radius: 15px;
            padding: 1rem;
            margin: 1.5rem 0;
            text-align: center;
        }

        .otac-code {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.5rem;
            font-weight: bold;
            color: #155724;
            letter-spacing: 0.3em;
            text-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .form-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 0.5rem;
        }

        .section-icon {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #0066CC, #004499);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 1rem;
            font-size: 1rem;
        }

        .form-floating {
            margin-bottom: 1.5rem;
        }

        .form-floating > .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            padding: 1rem 0.75rem;
            transition: all 0.3s ease;
        }

        .form-floating > .form-control:focus {
            border-color: #0066CC;
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
        }

        .form-floating > .form-control.is-invalid {
            border-color: #dc3545;
            background: #fff5f5;
        }

        .form-floating > label {
            color: #6c757d;
            font-weight: 500;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group-text {
            background: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-right: none;
            border-radius: 12px 0 0 12px;
            color: #6c757d;
            font-weight: 500;
        }

        .register-btn {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            color: white;
            padding: 1rem 3rem;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 50px;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 2rem;
        }

        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(40, 167, 69, 0.3);
            color: white;
        }

        .register-btn:disabled {
            background: #6c757d;
            transform: none;
            box-shadow: none;
        }

        .security-notice {
            background: #e3f2fd;
            border: 1px solid #bbdefb;
            border-radius: 15px;
            padding: 1.5rem;
            margin-top: 2rem;
            text-align: center;
        }

        .security-notice-title {
            color: #0066CC;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .progress-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 2rem;
        }

        .step {
            display: flex;
            align-items: center;
            color: #6c757d;
        }

        .step.active {
            color: #0066CC;
        }

        .step.completed {
            color: #28a745;
        }

        .step-number {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 0.5rem;
        }

        .step.active .step-number {
            background: #0066CC;
            color: white;
        }

        .step.completed .step-number {
            background: #28a745;
            color: white;
        }

        .step-connector {
            width: 50px;
            height: 2px;
            background: #e9ecef;
            margin: 0 1rem;
        }

        .step.completed + * .step-connector {
            background: #28a745;
        }

        .input-hint {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: rgba(108, 117, 125, 0.05);
            border-radius: 6px;
            border-left: 3px solid #6c757d;
        }

        .required-field::after {
            content: " *";
            color: #dc3545;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .register-card {
                padding: 2rem 1.5rem;
                margin: 1rem;
                border-radius: 15px;
            }

            .register-title {
                font-size: 2rem;
            }

            .progress-indicator {
                flex-direction: column;
                gap: 1rem;
            }

            .step-connector {
                width: 2px;
                height: 30px;
                margin: 0.5rem 0;
            }

            .section-title {
                font-size: 1.1rem;
            }

            .form-floating > .form-control {
                font-size: 16px; /* Prevent zoom on iOS */
            }
        }

        /* Loading Animation */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Form Validation Styling */
        .was-validated .form-control:valid {
            border-color: #28a745;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='m2.3 6.73.79-.79L4.25 4.77l-.79-.79L2.3 5.14l-.79-.79L.72 5.14z'/%3e%3c/svg%3e");
        }

        .was-validated .form-control:invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 4.6.4.4.4-.4m-.4.4v1.8'/%3e%3c/svg%3e");
        }
    </style>
}

<div class="register-container">
    <div class="register-card">
        <!-- Progress Indicator -->
        <div class="progress-indicator">
            <div class="step completed">
                <div class="step-number">
                    <i class="fas fa-check"></i>
                </div>
                <span data-text-th="ยืนยัน OTAC" data-text-en="Verify OTAC">@ViewBag.TextVerifyOtac</span>
            </div>
            <div class="step-connector"></div>
            <div class="step active">
                <div class="step-number">2</div>
                <span data-text-th="กรอกข้อมูล" data-text-en="Fill Information">@ViewBag.TextFillInformation</span>
            </div>
            <div class="step-connector"></div>
            <div class="step">
                <div class="step-number">3</div>
                <span>@ViewBag.TextRegister</span>
            </div>
        </div>

        <!-- Header -->
        <div class="register-header">
            <div class="register-logo">
                <i class="fas fa-user-plus"></i>
            </div>
            <h1 class="register-title">@ViewData["Title"]</h1>
            <p class="register-subtitle">
                <span data-text-th="กรุณากรอกข้อมูลของท่านให้ครบถ้วนและถูกต้อง" data-text-en="Please fill in your information completely and accurately">@ViewBag.TextPleaseFillInfo</span>
            </p>

            <!-- OTAC Display -->
            <div class="otac-display">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="fas fa-shield-check text-success me-2"></i>
                    <small class="text-muted me-2" data-text-th="รหัส OTAC ที่ยืนยันแล้ว:" data-text-en="Verified OTAC Code:">@ViewBag.TextVerifiedOtacCode</small>
                    <span class="otac-code">@Model.OtacCode</span>
                </div>
            </div>
        </div>

        <!-- Registration Form -->
        <form asp-action="Register" method="post" id="registerForm" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="OtacCode" type="hidden" />

            <!-- Personal Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <span data-text-th="ข้อมูลส่วนตัว" data-text-en="Personal Information">@ViewBag.TextPersonalInfo</span>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="FullName" 
                                   class="form-control" 
                                   placeholder="@ViewBag.TextFullNameLabel"
                                   data-placeholder-th="ชื่อ-นามสกุล" data-placeholder-en="Full Name"
                                   required />
                            <label asp-for="FullName" class="required-field" data-text-th="ชื่อ-นามสกุล" data-text-en="Full Name">@ViewBag.TextFullNameLabel</label>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                            <div class="input-hint">
                                <i class="fas fa-info-circle me-1"></i>
                                <span data-text-th="กรุณากรอกชื่อ-นามสกุลตามเอกสารทางราชการ" data-text-en="Please enter full name as per official documents">@ViewBag.TextFullNameHint</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <!-- IdType is always "National ID" as per requirements - no field needed for ModernRegistrationViewModel -->
                        <div class="form-floating">
                            <input asp-for="IdValue" 
                                   class="form-control" 
                                   placeholder="@ViewBag.TextNationalIdLabel"
                                   data-placeholder-th="เลขบัตรประชาชน" data-placeholder-en="National ID Number"
                                   id="idValueInput"
                                   required />
                            <label asp-for="IdValue" class="required-field" data-text-th="เลขบัตรประชาชน (13 หลัก)" data-text-en="National ID Number (13 digits)">@ViewBag.TextNationalIdLabel</label>
                            <span asp-validation-for="IdValue" class="text-danger"></span>
                            <div class="input-hint" id="idHint">
                                <i class="fas fa-info-circle me-1"></i>
                                <span id="idHintText" data-text-th="ใช้เฉพาะบัตรประชาชนไทยเท่านั้น - กรอกตัวเลข 13 หลัก" data-text-en="Thai National ID only - enter 13 digits">@ViewBag.TextNationalIdHint</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <span data-text-th="ข้อมูลการติดต่อ" data-text-en="Contact Information">@ViewBag.TextContactInfo</span>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-mobile-alt"></i>
                            </span>
                            <div class="form-floating">
                                <input asp-for="MobileNo" 
                                       class="form-control" 
                                       placeholder="@ViewBag.TextMobileLabel"
                                       data-placeholder-th="เบอร์มือถือ" data-placeholder-en="Mobile Number"
                                       id="mobileInput"
                                       required />
                                <label asp-for="MobileNo" class="required-field" data-text-th="เบอร์มือถือ" data-text-en="Mobile Number">@ViewBag.TextMobileLabel</label>
                            </div>
                        </div>
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                        <div class="input-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            <span data-text-th="รูปแบบ: 08XXXXXXXX หรือ 09XXXXXXXX (10 หลัก)" data-text-en="Format: 08XXXXXXXX or 09XXXXXXXX (10 digits)">@ViewBag.TextMobileHint</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <span data-text-th="ข้อมูลบัญชีธนาคาร" data-text-en="Bank Account Information">@ViewBag.TextBankAccountInfo</span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="AccountNo" 
                                   class="form-control" 
                                   placeholder="@ViewBag.TextAccountLabel"
                                   data-placeholder-th="เลขที่บัญชี" data-placeholder-en="Account Number"
                                   id="accountInput"
                                   required />
                            <label asp-for="AccountNo" class="required-field" data-text-th="เลขที่บัญชี" data-text-en="Account Number">@ViewBag.TextAccountLabel</label>
                            <span asp-validation-for="AccountNo" class="text-danger"></span>
                            <div class="input-hint">
                                <i class="fas fa-info-circle me-1"></i>
                                <span data-text-th="เลขบัญชี KBank 10-15 หลัก (ไม่ต้องใส่เครื่องหมายขีด)" data-text-en="KBank account number 10-15 digits (no dashes)">@ViewBag.TextAccountHint</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="BranchId" class="form-select" required>
                                <option value="" data-text-th="เลือกสาขา" data-text-en="Select Branch">@ViewBag.TextSelectBranch</option>
                                @foreach (var branch in Model.Branches)
                                {
                                    <option value="@branch.Value">@branch.Text</option>
                                }
                            </select>
                            <label asp-for="BranchId" class="required-field" data-text-th="สาขาที่เปิดบัญชี" data-text-en="Branch where account was opened">@ViewBag.TextBranchLabel</label>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terms and Submit -->
            <div class="form-section">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                    <label class="form-check-label" for="agreeTerms">
                        <span data-text-th="ข้าพเจ้าได้อ่านและยอมรับ" data-text-en="I have read and accept">@ViewBag.TextIHaveReadAndAccept</span>
                        <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#termsModal">
                            <strong data-text-th="ข้อกำหนดและเงื่อนไข" data-text-en="Terms and Conditions">@ViewBag.TextTermsAndConditions</strong>
                        </a>
                        และ
                        <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#privacyModal">
                            <strong data-text-th="นโยบายความเป็นส่วนตัว" data-text-en="Privacy Policy">@ViewBag.TextPrivacyPolicy</strong>
                        </a>
                        <span class="text-danger">*</span>
                    </label>
                    <div class="invalid-feedback">
                        <span data-text-th="กรุณายอมรับข้อกำหนดและเงื่อนไขก่อนดำเนินการต่อ" data-text-en="Please accept the terms and conditions before proceeding">@ViewBag.TextMustAcceptTerms</span>
                    </div>
                </div>

                <button type="submit" class="btn register-btn" id="submitBtn">
                    <i class="fas fa-paper-plane me-2"></i>
                    <span data-text-th="ลงทะเบียนหักบัญชีอัตโนมัติ" data-text-en="Register for Direct Debit">@ViewBag.TextRegisterDirectDebit</span>
                </button>
            </div>
        </form>

        <!-- Security Notice -->
        <div class="security-notice">
            <div class="security-notice-title">
                <i class="fas fa-shield-alt me-2"></i>
                <span data-text-th="การรักษาความปลอดภัย" data-text-en="Security">@ViewBag.TextSecurityTitle</span>
            </div>
            <p class="mb-0 text-muted">
                <span data-text-th="ข้อมูลของท่านจะถูกเข้ารหัสและส่งต่อไปยังระบบ KBank อย่างปลอดภัย โดยเป็นไปตามมาตรฐานความปลอดภัยระดับธนาคาร" data-text-en="Your data will be encrypted and securely transmitted to KBank system in accordance with banking-level security standards">@ViewBag.TextSecurityNotice</span>
            </p>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="termsModalLabel">
                    <i class="fas fa-file-contract me-2"></i><span data-text-th="ข้อกำหนดและเงื่อนไข" data-text-en="Terms and Conditions">@ViewBag.TextTermsModalTitle</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="terms-content">
                    <h6><span data-text-th="1. การใช้บริการ" data-text-en="1. Service Usage">1. @ViewBag.TextTermsServiceUsage</span></h6>
                    <p><span data-text-th="ท่านตกลงใช้บริการหักบัญชีอัตโนมัติตามเงื่อนไขที่กำหนดโดย KBank และ BizConnect" data-text-en="You agree to use the direct debit service according to the terms and conditions set by KBank and BizConnect">@ViewBag.TextTermsServiceUsageContent</span></p>
                    
                    <h6><span data-text-th="2. ความถูกต้องของข้อมูล" data-text-en="2. Data Accuracy">2. @ViewBag.TextTermsDataAccuracy</span></h6>
                    <p>@ViewBag.TextTermsDataAccuracyContent</p>
                    
                    <h6><span data-text-th="3. ความรับผิดชอบ" data-text-en="3. Responsibility">3. @ViewBag.TextTermsResponsibility</span></h6>
                    <p>@ViewBag.TextTermsResponsibilityContent</p>
                    
                    <h6><span data-text-th="4. การแก้ไขข้อกำหนด" data-text-en="4. Terms Modifications">4. @ViewBag.TextTermsModifications</span></h6>
                    <p>@ViewBag.TextTermsModificationsContent</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-text-th="ปิด" data-text-en="Close">@ViewBag.TextClose</button>
                <button type="button" class="btn btn-primary" onclick="acceptTerms()" data-text-th="ยอมรับ" data-text-en="Accept">@ViewBag.TextAccept</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="privacyModalLabel">
                    <i class="fas fa-user-shield me-2"></i><span data-text-th="นโยบายความเป็นส่วนตัว" data-text-en="Privacy Policy">@ViewBag.TextPrivacyModalTitle</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="privacy-content">
                    <h6><span data-text-th="การเก็บรวบรวมข้อมูล" data-text-en="Data Collection">@ViewBag.TextPrivacyDataCollection</span></h6>
                    <p>@ViewBag.TextPrivacyDataCollectionContent</p>
                    
                    <h6><span data-text-th="การใช้ข้อมูล" data-text-en="Data Usage">@ViewBag.TextPrivacyDataUsage</span></h6>
                    <p>@ViewBag.TextPrivacyDataUsageContent</p>
                    
                    <h6><span data-text-th="การเปิดเผยข้อมูล" data-text-en="Data Disclosure">@ViewBag.TextPrivacyDataDisclosure</span></h6>
                    <p>@ViewBag.TextPrivacyDataDisclosureContent</p>
                    
                    <h6><span data-text-th="ความปลอดภัย" data-text-en="Security">@ViewBag.TextPrivacyDataSecurity</span></h6>
                    <p>@ViewBag.TextPrivacyDataSecurityContent</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-text-th="ปิด" data-text-en="Close">@ViewBag.TextClose</button>
                <button type="button" class="btn btn-info" onclick="acceptPrivacy()" data-text-th="ยอมรับ" data-text-en="Accept">@ViewBag.TextAccept</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const submitBtn = document.getElementById('submitBtn');
            const agreeTerms = document.getElementById('agreeTerms');

            // Form validation configuration - National ID only
            const nationalIdValidator = {
                pattern: /^[0-9]{13}$/,
                message: '@ViewBag.TextNationalIdValidation',
                hint: '@ViewBag.TextNationalIdHintValidation'
            };

            // Initialize input formatting and validation
            initializeInputs();
            
            // Form submission handler
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (validateForm()) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="loading-spinner me-2"></span>@ViewBag.TextSubmittingData';
                    
                    // Submit form after validation
                    setTimeout(() => {
                        form.submit();
                    }, 500);
                }
            });

            function initializeInputs() {
                // Setup for National ID only (no dropdown)
                const idValueInput = document.getElementById('idValueInput');

                // ID Value input formatting (National ID only - 13 digits)
                idValueInput.addEventListener('input', function() {
                    // Always National ID - only allow 13 digits
                    let value = this.value.replace(/[^0-9]/g, '').substring(0, 13);
                    this.value = value;
                    validateField(this);
                });

                // Mobile number formatting
                const mobileInput = document.getElementById('mobileInput');
                mobileInput.addEventListener('input', function() {
                    let value = this.value.replace(/[^0-9]/g, '');
                    
                    // Auto-add 0 prefix if not present
                    if (value.length > 0 && !value.startsWith('0')) {
                        if (value.startsWith('8') || value.startsWith('9')) {
                            value = '0' + value;
                        }
                    }
                    
                    // Limit length
                    value = value.substring(0, 10);
                    this.value = value;
                    validateField(this);
                });

                // Account number formatting
                const accountInput = document.getElementById('accountInput');
                accountInput.addEventListener('input', function() {
                    let value = this.value.replace(/[^0-9]/g, '').substring(0, 15);
                    this.value = value;
                    validateField(this);
                });

                // Real-time validation for all inputs
                const inputs = form.querySelectorAll('input[required], select[required]');
                inputs.forEach(input => {
                    input.addEventListener('blur', () => validateField(input));
                    input.addEventListener('input', () => clearValidationState(input));
                });
            }

            function validateField(field) {
                const value = field.value.trim();
                const fieldName = field.name || field.id;
                let isValid = true;
                let errorMessage = '';

                switch (fieldName) {
                    case 'FullName':
                        isValid = value.length >= 2 && value.length <= 200;
                        errorMessage = '@ViewBag.TextFullNameValidation';
                        break;

                    case 'IdValue':
                        // Always National ID - validate 13 digits
                        isValid = /^[0-9]{13}$/.test(value);
                        errorMessage = '@ViewBag.TextNationalIdValidation';
                        break;

                    case 'MobileNo':
                        isValid = /^0[89][0-9]{8}$/.test(value);
                        errorMessage = '@ViewBag.TextMobileValidation';
                        break;

                    case 'AccountNo':
                        isValid = /^[0-9]{10,15}$/.test(value);
                        errorMessage = '@ViewBag.TextAccountValidation';
                        break;

                    case 'BranchId':
                        isValid = value !== '';
                        errorMessage = '@ViewBag.TextBranchValidation';
                        break;
                }

                updateFieldValidation(field, isValid, errorMessage);
                return isValid;
            }

            function updateFieldValidation(field, isValid, errorMessage) {
                const feedback = field.parentNode.querySelector('.invalid-feedback') || 
                               field.parentNode.parentNode.querySelector('.text-danger');
                
                if (isValid) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                    if (feedback) feedback.textContent = '';
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                    if (feedback) feedback.textContent = errorMessage;
                }
            }

            function clearValidationState(field) {
                field.classList.remove('is-valid', 'is-invalid');
            }

            function validateForm() {
                const inputs = form.querySelectorAll('input[required], select[required]');
                let isFormValid = true;

                inputs.forEach(input => {
                    if (!validateField(input)) {
                        isFormValid = false;
                    }
                });

                // Check terms agreement
                if (!agreeTerms.checked) {
                    agreeTerms.classList.add('is-invalid');
                    isFormValid = false;
                } else {
                    agreeTerms.classList.remove('is-invalid');
                }

                if (!isFormValid) {
                    showAlert('warning', '@ViewBag.TextCheckFormData');
                    
                    // Focus on first invalid field
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }

                return isFormValid;
            }

            // Display TempData messages
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                showAlert('danger', '@Html.Raw(TempData["ErrorMessage"])');
                </text>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showAlert('success', '@Html.Raw(TempData["SuccessMessage"])');
                </text>
            }
        });

        // Modal functions
        function acceptTerms() {
            document.getElementById('agreeTerms').checked = true;
            const modal = bootstrap.Modal.getInstance(document.getElementById('termsModal'));
            modal.hide();
        }

        function acceptPrivacy() {
            document.getElementById('agreeTerms').checked = true;
            const modal = bootstrap.Modal.getInstance(document.getElementById('privacyModal'));
            modal.hide();
        }

        // Alert helper function
        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1060; min-width: 300px; max-width: 500px;';
            alertDiv.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);

            // Auto-remove after 6 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 150);
                }
            }, 6000);
        }
    </script>
}