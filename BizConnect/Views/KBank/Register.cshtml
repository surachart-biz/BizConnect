@using BizConnect.ViewModels.Modern
@model ModernRegistrationViewModel
@{
    await Html.PartialAsync("_LanguageTexts");
    ViewData["Title"] = ViewBag.IsThaiLanguage ? "ลงทะเบียนหักบัญชีอัตโนมัติ" : "Direct Debit Registration";
}

@section Styles {
    <style>
        .register-container {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 2rem 0;
        }

        .register-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
            padding: 3rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .register-header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .register-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #0066CC, #004499);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: white;
            font-size: 2rem;
        }

        .register-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }

        .register-subtitle {
            color: #6c757d;
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }

        .otac-display {
            background: linear-gradient(135deg, #e8f5e8, #d4edda);
            border: 2px solid #28a745;
            border-radius: 15px;
            padding: 1rem;
            margin: 1.5rem 0;
            text-align: center;
        }

        .otac-code {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.5rem;
            font-weight: bold;
            color: #155724;
            letter-spacing: 0.3em;
            text-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .form-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 0.5rem;
        }

        .section-icon {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #0066CC, #004499);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 1rem;
            font-size: 1rem;
        }

        .form-floating {
            margin-bottom: 1.5rem;
        }

        .form-floating > .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            padding: 1rem 0.75rem;
            transition: all 0.3s ease;
        }

        .form-floating > .form-control:focus {
            border-color: #0066CC;
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
        }

        .form-floating > .form-control.is-invalid {
            border-color: #dc3545;
            background: #fff5f5;
        }

        .form-floating > label {
            color: #6c757d;
            font-weight: 500;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group-text {
            background: #f8f9fa;
            border: 2px solid #e0e0e0;
            border-right: none;
            border-radius: 12px 0 0 12px;
            color: #6c757d;
            font-weight: 500;
        }

        .register-btn {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            color: white;
            padding: 1rem 3rem;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 50px;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 2rem;
        }

        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(40, 167, 69, 0.3);
            color: white;
        }

        .register-btn:disabled {
            background: #6c757d;
            transform: none;
            box-shadow: none;
        }

        .security-notice {
            background: #e3f2fd;
            border: 1px solid #bbdefb;
            border-radius: 15px;
            padding: 1.5rem;
            margin-top: 2rem;
            text-align: center;
        }

        .security-notice-title {
            color: #0066CC;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .progress-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 2rem;
        }

        .step {
            display: flex;
            align-items: center;
            color: #6c757d;
        }

        .step.active {
            color: #0066CC;
        }

        .step.completed {
            color: #28a745;
        }

        .step-number {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 0.5rem;
        }

        .step.active .step-number {
            background: #0066CC;
            color: white;
        }

        .step.completed .step-number {
            background: #28a745;
            color: white;
        }

        .step-connector {
            width: 50px;
            height: 2px;
            background: #e9ecef;
            margin: 0 1rem;
        }

        .step.completed + * .step-connector {
            background: #28a745;
        }

        .input-hint {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: rgba(108, 117, 125, 0.05);
            border-radius: 6px;
            border-left: 3px solid #6c757d;
        }

        .required-field::after {
            content: " *";
            color: #dc3545;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .register-card {
                padding: 2rem 1.5rem;
                margin: 1rem;
                border-radius: 15px;
            }

            .register-title {
                font-size: 2rem;
            }

            .progress-indicator {
                flex-direction: column;
                gap: 1rem;
            }

            .step-connector {
                width: 2px;
                height: 30px;
                margin: 0.5rem 0;
            }

            .section-title {
                font-size: 1.1rem;
            }

            .form-floating > .form-control {
                font-size: 16px; /* Prevent zoom on iOS */
            }
        }

        /* Loading Animation */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Form Validation Styling */
        .was-validated .form-control:valid {
            border-color: #28a745;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='m2.3 6.73.79-.79L4.25 4.77l-.79-.79L2.3 5.14l-.79-.79L.72 5.14z'/%3e%3c/svg%3e");
        }

        .was-validated .form-control:invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 4.6.4.4.4-.4m-.4.4v1.8'/%3e%3c/svg%3e");
        }
    </style>
}

<div class="register-container">
    <div class="register-card">
        <!-- Progress Indicator -->
        <div class="progress-indicator">
            <div class="step completed">
                <div class="step-number">
                    <i class="fas fa-check"></i>
                </div>
                <span>@(ViewBag.IsThaiLanguage ? "ยืนยัน OTAC" : "Verify OTAC")</span>
            </div>
            <div class="step-connector"></div>
            <div class="step active">
                <div class="step-number">2</div>
                <span>@(ViewBag.IsThaiLanguage ? "กรอกข้อมูล" : "Fill Information")</span>
            </div>
            <div class="step-connector"></div>
            <div class="step">
                <div class="step-number">3</div>
                <span>@ViewBag.TextRegister</span>
            </div>
        </div>

        <!-- Header -->
        <div class="register-header">
            <div class="register-logo">
                <i class="fas fa-user-plus"></i>
            </div>
            <h1 class="register-title">@ViewData["Title"]</h1>
            <p class="register-subtitle">
                @(ViewBag.IsThaiLanguage ? "กรุณากรอกข้อมูลของท่านให้ครบถ้วนและถูกต้อง" : "Please fill in your information completely and accurately")
            </p>

            <!-- OTAC Display -->
            <div class="otac-display">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="fas fa-shield-check text-success me-2"></i>
                    <small class="text-muted me-2">@(ViewBag.IsThaiLanguage ? "รหัส OTAC ที่ยืนยันแล้ว:" : "Verified OTAC Code:"):</small>
                    <span class="otac-code">@Model.OtacCode</span>
                </div>
            </div>
        </div>

        <!-- Registration Form -->
        <form asp-action="Register" method="post" id="registerForm" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="OtacCode" type="hidden" />

            <!-- Personal Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    ข้อมูลส่วนตัว
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="FullName" 
                                   class="form-control" 
                                   placeholder="ชื่อ-นามสกุล"
                                   required />
                            <label asp-for="FullName" class="required-field">ชื่อ-นามสกุล</label>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                            <div class="input-hint">
                                <i class="fas fa-info-circle me-1"></i>
                                กรุณากรอกชื่อ-นามสกุลตามเอกสารทางราชการ
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <!-- IdType is always "National ID" as per requirements - no field needed for ModernRegistrationViewModel -->
                        <div class="form-floating">
                            <input asp-for="IdValue" 
                                   class="form-control" 
                                   placeholder="เลขบัตรประชาชน"
                                   id="idValueInput"
                                   required />
                            <label asp-for="IdValue" class="required-field">เลขบัตรประชาชน (13 หลัก)</label>
                            <span asp-validation-for="IdValue" class="text-danger"></span>
                            <div class="input-hint" id="idHint">
                                <i class="fas fa-info-circle me-1"></i>
                                <span id="idHintText">ใช้เฉพาะบัตรประชาชนไทยเท่านั้น - กรอกตัวเลข 13 หลัก</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    ข้อมูลการติดต่อ
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-mobile-alt"></i>
                            </span>
                            <div class="form-floating">
                                <input asp-for="MobileNo" 
                                       class="form-control" 
                                       placeholder="เบอร์มือถือ"
                                       id="mobileInput"
                                       required />
                                <label asp-for="MobileNo" class="required-field">เบอร์มือถือ</label>
                            </div>
                        </div>
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                        <div class="input-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            รูปแบบ: 08XXXXXXXX หรือ 09XXXXXXXX (10 หลัก)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Information Section -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-icon">
                        <i class="fas fa-university"></i>
                    </div>
                    ข้อมูลบัญชีธนาคาร
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="AccountNo" 
                                   class="form-control" 
                                   placeholder="เลขที่บัญชี"
                                   id="accountInput"
                                   required />
                            <label asp-for="AccountNo" class="required-field">เลขที่บัญชี</label>
                            <span asp-validation-for="AccountNo" class="text-danger"></span>
                            <div class="input-hint">
                                <i class="fas fa-info-circle me-1"></i>
                                เลขบัญชี KBank 10-15 หลัก (ไม่ต้องใส่เครื่องหมายขีด)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="BranchId" class="form-select" required>
                                <option value="">เลือกสาขา</option>
                                @foreach (var branch in Model.Branches)
                                {
                                    <option value="@branch.Value">@branch.Text</option>
                                }
                            </select>
                            <label asp-for="BranchId" class="required-field">สาขาที่เปิดบัญชี</label>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terms and Submit -->
            <div class="form-section">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                    <label class="form-check-label" for="agreeTerms">
                        ข้าพเจ้าได้อ่านและยอมรับ
                        <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#termsModal">
                            <strong>ข้อกำหนดและเงื่อนไข</strong>
                        </a>
                        และ
                        <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#privacyModal">
                            <strong>นโยบายความเป็นส่วนตัว</strong>
                        </a>
                        <span class="text-danger">*</span>
                    </label>
                    <div class="invalid-feedback">
                        กรุณายอมรับข้อกำหนดและเงื่อนไขก่อนดำเนินการต่อ
                    </div>
                </div>

                <button type="submit" class="btn register-btn" id="submitBtn">
                    <i class="fas fa-paper-plane me-2"></i>
                    ลงทะเบียนหักบัญชีอัตโนมัติ
                </button>
            </div>
        </form>

        <!-- Security Notice -->
        <div class="security-notice">
            <div class="security-notice-title">
                <i class="fas fa-shield-alt me-2"></i>
                การรักษาความปลอดภัย
            </div>
            <p class="mb-0 text-muted">
                ข้อมูลของท่านจะถูกเข้ารหัสและส่งต่อไปยังระบบ KBank อย่างปลอดภัย
                โดยเป็นไปตามมาตรฐานความปลอดภัยระดับธนาคาร
            </p>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="termsModalLabel">
                    <i class="fas fa-file-contract me-2"></i>ข้อกำหนดและเงื่อนไข
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="terms-content">
                    <h6>1. การใช้บริการ</h6>
                    <p>ท่านตกลงใช้บริการหักบัญชีอัตโนมัติตามเงื่อนไขที่กำหนดโดย KBank และ BizConnect</p>
                    
                    <h6>2. ความถูกต้องของข้อมูล</h6>
                    <p>ท่านรับรองว่าข้อมูลที่ให้ไว้ถูกต้องและเป็นปัจจุบัน</p>
                    
                    <h6>3. ความรับผิดชอบ</h6>
                    <p>ท่านรับผิดชอบต่อการใช้บริการและธุรกรรมที่เกิดขึ้น</p>
                    
                    <h6>4. การแก้ไขข้อกำหนด</h6>
                    <p>บริษัทขอสงวนสิทธิ์ในการแก้ไขข้อกำหนดโดยแจ้งให้ทราบล่วงหน้า</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" onclick="acceptTerms()">ยอมรับ</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="privacyModalLabel">
                    <i class="fas fa-user-shield me-2"></i>นโยบายความเป็นส่วนตัว
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="privacy-content">
                    <h6>การเก็บรวบรวมข้อมูล</h6>
                    <p>เราเก็บรวบรวมข้อมูลที่จำเป็นสำหรับการให้บริการเท่านั้น</p>
                    
                    <h6>การใช้ข้อมูล</h6>
                    <p>ข้อมูลจะใช้เพื่อการให้บริการและการปรับปรุงบริการ</p>
                    
                    <h6>การเปิดเผยข้อมูล</h6>
                    <p>เราจะไม่เปิดเผยข้อมูลให้บุคคลที่สาม ยกเว้นตามที่กฎหมายกำหนด</p>
                    
                    <h6>ความปลอดภัย</h6>
                    <p>เรามีมาตรการรักษาความปลอดภัยข้อมูลตามมาตรฐานสากล</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-info" onclick="acceptPrivacy()">ยอมรับ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const submitBtn = document.getElementById('submitBtn');
            const agreeTerms = document.getElementById('agreeTerms');

            // Form validation configuration - National ID only
            const nationalIdValidator = {
                pattern: /^[0-9]{13}$/,
                message: 'เลขประจำตัวประชาชนต้องเป็นตัวเลข 13 หลัก',
                hint: 'กรอกเลขประจำตัวประชาชน 13 หลัก'
            };

            // Initialize input formatting and validation
            initializeInputs();
            
            // Form submission handler
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (validateForm()) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="loading-spinner me-2"></span>กำลังส่งข้อมูล...';
                    
                    // Submit form after validation
                    setTimeout(() => {
                        form.submit();
                    }, 500);
                }
            });

            function initializeInputs() {
                // Setup for National ID only (no dropdown)
                const idValueInput = document.getElementById('idValueInput');

                // ID Value input formatting (National ID only - 13 digits)
                idValueInput.addEventListener('input', function() {
                    // Always National ID - only allow 13 digits
                    let value = this.value.replace(/[^0-9]/g, '').substring(0, 13);
                    this.value = value;
                    validateField(this);
                });

                // Mobile number formatting
                const mobileInput = document.getElementById('mobileInput');
                mobileInput.addEventListener('input', function() {
                    let value = this.value.replace(/[^0-9]/g, '');
                    
                    // Auto-add 0 prefix if not present
                    if (value.length > 0 && !value.startsWith('0')) {
                        if (value.startsWith('8') || value.startsWith('9')) {
                            value = '0' + value;
                        }
                    }
                    
                    // Limit length
                    value = value.substring(0, 10);
                    this.value = value;
                    validateField(this);
                });

                // Account number formatting
                const accountInput = document.getElementById('accountInput');
                accountInput.addEventListener('input', function() {
                    let value = this.value.replace(/[^0-9]/g, '').substring(0, 15);
                    this.value = value;
                    validateField(this);
                });

                // Real-time validation for all inputs
                const inputs = form.querySelectorAll('input[required], select[required]');
                inputs.forEach(input => {
                    input.addEventListener('blur', () => validateField(input));
                    input.addEventListener('input', () => clearValidationState(input));
                });
            }

            function validateField(field) {
                const value = field.value.trim();
                const fieldName = field.name || field.id;
                let isValid = true;
                let errorMessage = '';

                switch (fieldName) {
                    case 'FullName':
                        isValid = value.length >= 2 && value.length <= 200;
                        errorMessage = 'ชื่อ-นามสกุลต้องมี 2-200 ตัวอักษร';
                        break;

                    case 'IdValue':
                        // Always National ID - validate 13 digits
                        isValid = /^[0-9]{13}$/.test(value);
                        errorMessage = 'เลขประจำตัวประชาชนต้องเป็นตัวเลข 13 หลัก';
                        break;

                    case 'MobileNo':
                        isValid = /^0[89][0-9]{8}$/.test(value);
                        errorMessage = 'เบอร์มือถือต้องขึ้นต้นด้วย 08 หรือ 09 และมี 10 หลัก';
                        break;

                    case 'AccountNo':
                        isValid = /^[0-9]{10,15}$/.test(value);
                        errorMessage = 'เลขที่บัญชีต้องเป็นตัวเลข 10-15 หลัก';
                        break;

                    case 'BranchId':
                        isValid = value !== '';
                        errorMessage = 'กรุณาเลือกสาขา';
                        break;
                }

                updateFieldValidation(field, isValid, errorMessage);
                return isValid;
            }

            function updateFieldValidation(field, isValid, errorMessage) {
                const feedback = field.parentNode.querySelector('.invalid-feedback') || 
                               field.parentNode.parentNode.querySelector('.text-danger');
                
                if (isValid) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                    if (feedback) feedback.textContent = '';
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                    if (feedback) feedback.textContent = errorMessage;
                }
            }

            function clearValidationState(field) {
                field.classList.remove('is-valid', 'is-invalid');
            }

            function validateForm() {
                const inputs = form.querySelectorAll('input[required], select[required]');
                let isFormValid = true;

                inputs.forEach(input => {
                    if (!validateField(input)) {
                        isFormValid = false;
                    }
                });

                // Check terms agreement
                if (!agreeTerms.checked) {
                    agreeTerms.classList.add('is-invalid');
                    isFormValid = false;
                } else {
                    agreeTerms.classList.remove('is-invalid');
                }

                if (!isFormValid) {
                    showAlert('warning', 'กรุณาตรวจสอบข้อมูลที่กรอกให้ครบถ้วนและถูกต้อง');
                    
                    // Focus on first invalid field
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }

                return isFormValid;
            }

            // Display TempData messages
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                showAlert('danger', '@Html.Raw(TempData["ErrorMessage"])');
                </text>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showAlert('success', '@Html.Raw(TempData["SuccessMessage"])');
                </text>
            }
        });

        // Modal functions
        function acceptTerms() {
            document.getElementById('agreeTerms').checked = true;
            const modal = bootstrap.Modal.getInstance(document.getElementById('termsModal'));
            modal.hide();
        }

        function acceptPrivacy() {
            document.getElementById('agreeTerms').checked = true;
            const modal = bootstrap.Modal.getInstance(document.getElementById('privacyModal'));
            modal.hide();
        }

        // Alert helper function
        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1060; min-width: 300px; max-width: 500px;';
            alertDiv.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);

            // Auto-remove after 6 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 150);
                }
            }, 6000);
        }
    </script>
}