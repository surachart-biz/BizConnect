@model KBankOddRegisterViewModel
@{
    ViewData["Title"] = "KBank ODD Registration";
    var registrationId = ViewData["RegistrationId"];
}


<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <!-- Enhanced Page Header -->
            <div class="text-center mb-4">
                <div class="bc-page-header">
                    <div class="bc-icon-wrapper mb-3">
                        <i class="fas fa-shield-alt fa-4x"></i>
                    </div>
                    <h1 class="mb-2" data-th="ลงทะเบียนหักบัญชีอัตโนมัติ KBank" data-en="KBank Online Direct Debit">ลงทะเบียนหักบัญชีอัตโนมัติ KBank</h1>
                    <p data-th="กรอกข้อมูลเพื่อเปิดใช้งานการหักเงินอัตโนมัติที่ปลอดภัย" data-en="Complete your registration to enable secure automatic payments">กรอกข้อมูลเพื่อเปิดใช้งานการหักเงินอัตโนมัติที่ปลอดภัย</p>
                    <div class="bc-security-badge">
                        <i class="fas fa-lock"></i>
                        <span data-th="ปลอดภัยด้วย SSL และมาตรฐานธนาคาร" data-en="SSL Secured & Bank-Grade Security">ปลอดภัยด้วย SSL และมาตรฐานธนาคาร</span>
                    </div>
                </div>
            </div>

            <!-- Enhanced Registration Form Card -->
            <div class="card shadow-sm border-0 kbank-registration-form" style="max-width: 800px; margin: 0 auto;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        <span data-th="ข้อมูลการลงทะเบียน" data-en="Registration Information">ข้อมูลการลงทะเบียน</span>
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Register" method="post" id="oddRegistrationForm" novalidate class="needs-validation">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="registrationId" value="@registrationId" />
                        
                        <div class="form-sections-container">
                        <!-- Section 1: Personal Information -->
                        <div class="form-section personal-info-section mb-4">
                            <div class="section-header">
                                <h6 class="section-title">
                                    <i class="fas fa-user section-icon"></i>
                                    <span data-th="ข้อมูลส่วนตัว" data-en="Personal Information">ข้อมูลส่วนตัว</span>
                                </h6>
                                <div class="section-divider"></div>
                            </div>
                            
                            <div class="row g-4">
                                <!-- Full Name -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="FullName" class="form-label required">
                                            <i class="fas fa-user"></i>
                                            <span data-th="ชื่อ-นามสกุล" data-en="Full Name">ชื่อ-นามสกุล</span>
                                        </label>
                                        <input asp-for="FullName" class="form-control" 
                                               data-placeholder-th="กรอกชื่อ-นามสกุล" 
                                               data-placeholder-en="Enter your full name"
                                               placeholder="กรอกชื่อ-นามสกุล" 
                                               autocomplete="name" required aria-describedby="fullNameHelp" />
                                        <div class="form-text" id="fullNameHelp">
                                            <span data-th="กรอกชื่อและนามสกุลภาษาไทยหรืออังกฤษ" data-en="Enter your name in Thai or English">กรอกชื่อและนามสกุลภาษาไทยหรืออังกฤษ</span>
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Mobile Number -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="MobileNo" class="form-label required">
                                            <i class="fas fa-mobile-alt"></i>
                                            <span data-th="เบอร์โทรศัพท์" data-en="Mobile Number">เบอร์โทรศัพท์</span>
                                        </label>
                                        <input asp-for="MobileNo" class="form-control" 
                                               data-placeholder-th="08xxxxxxxx หรือ +66xxxxxxxx" 
                                               data-placeholder-en="08xxxxxxxx or +66xxxxxxxx"
                                               placeholder="08xxxxxxxx หรือ +66xxxxxxxx" 
                                               autocomplete="tel" required aria-describedby="mobileHelp" />
                                        <div class="form-text" id="mobileHelp">
                                            <span data-th="รูปแบบที่ถูกต้อง: 08xxxxxxxx หรือ +66xxxxxxxx" data-en="Valid format: 08xxxxxxxx or +66xxxxxxxx">รูปแบบที่ถูกต้อง: 08xxxxxxxx หรือ +66xxxxxxxx</span>
                                        </div>
                                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- National ID -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="IdValue" class="form-label required">
                                            <i class="fas fa-id-card"></i>
                                            <span data-th="เลขบัตรประจำตัวประชาชน" data-en="National ID Number">เลขบัตรประจำตัวประชาชน</span>
                                        </label>
                                        <input asp-for="IdValue" class="form-control" 
                                               data-placeholder-th="กรอกเลขบัตรประชาชน 13 หลัก" 
                                               data-placeholder-en="Enter 13-digit National ID"
                                               placeholder="กรอกเลขบัตรประชาชน 13 หลัก" 
                                               id="nationalIdInput" maxlength="13" pattern="[0-9]{13}" required aria-describedby="idHelp" />
                                        <div class="form-text" id="idHelp">
                                            <span data-th="เลขบัตรประชาชนต้องมี 13 หลักตัวเลข" data-en="National ID must be exactly 13 digits">เลขบัตรประชาชนต้องมี 13 หลักตัวเลข</span>
                                        </div>
                                        <span asp-validation-for="IdValue" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fas fa-envelope"></i>
                                            <span data-th="อีเมล" data-en="Email">อีเมล</span>
                                        </label>
                                        <input type="email" class="form-control" 
                                               data-placeholder-th="example@email.com" 
                                               data-placeholder-en="example@email.com"
                                               placeholder="example@email.com" 
                                               autocomplete="email" aria-describedby="emailHelp" />
                                        <div class="form-text" id="emailHelp">
                                            <span data-th="อีเมลสำหรับติดต่อ (ไม่จำเป็น)" data-en="Contact email (optional)">อีเมลสำหรับติดต่อ (ไม่จำเป็น)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Bank Account Information -->
                        <div class="form-section bank-info-section mb-4">
                            <div class="section-header">
                                <h6 class="section-title">
                                    <i class="fas fa-university section-icon"></i>
                                    <span data-th="ข้อมูลบัญชีธนาคาร" data-en="Bank Account Information">ข้อมูลบัญชีธนาคาร</span>
                                </h6>
                                <div class="section-divider"></div>
                            </div>
                            
                            <div class="row g-4">
                                <!-- Bank Name (Read-only) -->
                                <div class="col-md-12 mb-3">
                                    <div class="bank-display-card">
                                        <div class="bank-logo-section">
                                            <i class="fas fa-university text-success"></i>
                                            <div class="bank-info">
                                                <h6 class="bank-name mb-1">
                                                    <span data-th="ธนาคารกสิกรไทย" data-en="Kasikornbank">ธนาคารกสิกรไทย</span>
                                                </h6>
                                                <small class="text-muted">
                                                    <span data-th="KBank Online Direct Debit" data-en="KBank Online Direct Debit">KBank Online Direct Debit</span>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Account Number -->
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label asp-for="AccountNo" class="form-label required">
                                            <i class="fas fa-credit-card"></i>
                                            <span data-th="เลขที่บัญชี" data-en="Account Number">เลขที่บัญชี</span>
                                        </label>
                                        <input asp-for="AccountNo" class="form-control" 
                                               data-placeholder-th="กรอกเลขที่บัญชีธนาคาร" 
                                               data-placeholder-en="Enter your bank account number"
                                               placeholder="กรอกเลขที่บัญชีธนาคาร" 
                                               autocomplete="off" required aria-describedby="accountHelp" />
                                        <div class="form-text" id="accountHelp">
                                            <span data-th="เลขที่บัญชีธนาคารกสิกรไทย 10-15 หลัก" data-en="KBank account number 10-15 digits">เลขที่บัญชีธนาคารกสิกรไทย 10-15 หลัก</span>
                                        </div>
                                        <span asp-validation-for="AccountNo" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Branch -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="BranchId" class="form-label required">
                                            <i class="fas fa-building"></i>
                                            <span data-th="สาขา" data-en="Branch">สาขา</span>
                                        </label>
                                        <select asp-for="BranchId" asp-items="@Model.Branches" 
                                                class="form-select" required aria-describedby="branchHelp">
                                            <option value="" data-th="-- เลือกสาขา --" data-en="-- Select Branch --">-- เลือกสาขา --</option>
                                        </select>
                                        <div class="form-text" id="branchHelp">
                                            <span data-th="เลือกสาขาที่คุณต้องการดำเนินการ" data-en="Select your preferred branch for processing">เลือกสาขาที่คุณต้องการดำเนินการ</span>
                                        </div>
                                        <span asp-validation-for="BranchId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div> <!-- End form-sections-container -->

                        <!-- Enhanced Form Actions -->
                        <div class="form-actions">
                            <a href="@Url.Action("Start", "KBank")" class="btn btn-outline-secondary" id="backBtn">
                                <i class="fas fa-arrow-left me-2"></i>
                                <span data-th="ย้อนกลับ" data-en="Back">ย้อนกลับ</span>
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <span class="btn-content">
                                    <i class="fas fa-shield-alt me-2"></i>
                                    <span data-th="ยืนยันการลงทะเบียน" data-en="Confirm Registration">ยืนยันการลงทะเบียน</span>
                                </span>
                                <span class="btn-loading d-none">
                                    <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
                                    <span data-th="กำลังดำเนินการ..." data-en="Processing...">กำลังดำเนินการ...</span>
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Information Card -->
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <span data-th="ข้อมูลสำคัญ" data-en="Important Information">ข้อมูลสำคัญ</span>
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li data-th="คุณจะถูกเปลี่ยนเส้นทางไปยังหน้าลงทะเบียนที่ปลอดภัยของ KBank หลังจากส่งแบบฟอร์มนี้" data-en="You will be redirected to KBank's secure registration page after submitting this form">คุณจะถูกเปลี่ยนเส้นทางไปยังหน้าลงทะเบียนที่ปลอดภัยของ KBank หลังจากส่งแบบฟอร์มนี้</li>
                        <li data-th="กรุณาตรวจสอบความถูกต้องของข้อมูลทั้งหมดก่อนดำเนินการ" data-en="Please ensure all information is accurate before proceeding">กรุณาตรวจสอบความถูกต้องของข้อมูลทั้งหมดก่อนดำเนินการ</li>
                        <li data-th="เตรียมเอกสารประจำตัวให้พร้อมสำหรับการยืนยันตัวตน" data-en="Keep your ID document ready for verification">เตรียมเอกสารประจำตัวให้พร้อมสำหรับการยืนยันตัวตน</li>
                        <li data-th="ตรวจสอบให้แน่ใจว่าเลขที่บัญชีธนาคารถูกต้อง (10-15 หลัก)" data-en="Ensure your bank account number is correct (10-15 digits)">ตรวจสอบให้แน่ใจว่าเลขที่บัญชีธนาคารถูกต้อง (10-15 หลัก)</li>
                        <li data-th="เลือกสาขาที่เหมาะสมสำหรับการลงทะเบียนของคุณ" data-en="Select the appropriate branch for your registration">เลือกสาขาที่เหมาะสมสำหรับการลงทะเบียนของคุณ</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/kbank-registration-enhanced.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nationalIdInput = document.getElementById('nationalIdInput');
            const form = document.getElementById('oddRegistrationForm');
            const submitBtn = document.getElementById('submitBtn');

            // Language switching is now handled by the layout
            const currentLang = localStorage.getItem('preferredLanguage') || 'th';
            
            // Apply current language if layout hasn't initialized yet
            if (window.BizConnectLanguage) {
                window.BizConnectLanguage.switchLanguage(currentLang, false);
            }

            // Enhanced form validation with proper timing
            let validFields = new Set();
            const requiredFields = ['FullName', 'MobileNo', 'IdValue', 'AccountNo', 'BranchId'];

            // Enhanced National ID validation with formatting
            if (nationalIdInput) {
                let hasUserInteracted = false;
                
                nationalIdInput.addEventListener('input', function(e) {
                    let value = e.target.value;
                    // Remove non-numeric characters
                    value = value.replace(/[^\d]/g, '');
                    
                    // Format with dashes for better readability (display only)
                    if (value.length > 1 && value.length <= 5) {
                        e.target.dataset.formatted = value.substring(0, 1) + '-' + value.substring(1);
                    } else if (value.length > 5 && value.length <= 10) {
                        e.target.dataset.formatted = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5);
                    } else if (value.length > 10 && value.length <= 12) {
                        e.target.dataset.formatted = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10);
                    } else if (value.length === 13) {
                        e.target.dataset.formatted = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10, 12) + '-' + value.substring(12);
                    }
                    
                    e.target.value = value;
                    
                    // Clear any existing error states when typing
                    if (hasUserInteracted) {
                        e.target.classList.remove('is-invalid');
                        removeCustomError(e.target, 'national-id-error');
                    }
                });

                nationalIdInput.addEventListener('blur', function(e) {
                    hasUserInteracted = true;
                    validateNationalId(e.target);
                });

                nationalIdInput.addEventListener('focus', function(e) {
                    // Show formatted version in placeholder or helper text
                    if (e.target.dataset.formatted) {
                        e.target.title = 'Formatted: ' + e.target.dataset.formatted;
                    }
                    // Clear validation state on focus
                    e.target.classList.remove('is-valid', 'is-invalid');
                });
            }

            function validateNationalId(input) {
                const value = input.value.trim();
                const nationalIdPattern = /^[0-9]{13}$/;
                
                if (!value) {
                    input.classList.remove('is-valid', 'is-invalid');
                    validFields.delete('IdValue');
                    removeCustomError(input, 'national-id-error');
                    return;
                }
                
                if (nationalIdPattern.test(value) && isValidThaiNationalId(value)) {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                    validFields.add('IdValue');
                    removeCustomError(input, 'national-id-error');
                    showFieldSuccess(input, 'National ID verified successfully');
                } else {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    validFields.delete('IdValue');
                    const currentLang = localStorage.getItem('preferredLanguage') || 'th';
                    const errorMessage = currentLang === 'th' ? 
                        'เลขบัตรประชาชนไม่ถูกต้อง กรุณาตรวจสอบ' : 
                        'Invalid National ID format';
                    showCustomError(input, 'national-id-error', errorMessage);
                }
            }

            // Thai National ID validation algorithm
            function isValidThaiNationalId(id) {
                if (id.length !== 13) return false;
                
                let sum = 0;
                for (let i = 0; i < 12; i++) {
                    sum += parseInt(id.charAt(i)) * (13 - i);
                }
                
                const remainder = sum % 11;
                const checkDigit = (11 - remainder) % 10;
                
                return checkDigit === parseInt(id.charAt(12));
            }

            // Enhanced mobile number validation with international support
            const mobileInput = document.querySelector('input[name="MobileNo"]');
            if (mobileInput) {
                let hasUserInteracted = false;
                
                mobileInput.addEventListener('input', function(e) {
                    let value = e.target.value;
                    // Allow only digits, +, and - characters
                    value = value.replace(/[^\d+\-]/g, '');
                    e.target.value = value;
                    
                    // Auto-format for Thai numbers
                    if (value.startsWith('08') || value.startsWith('09') || value.startsWith('06') || value.startsWith('07')) {
                        // Format as 0X-XXXX-XXXX
                        if (value.length > 2 && value.length <= 6) {
                            e.target.dataset.formatted = value.substring(0, 2) + '-' + value.substring(2);
                        } else if (value.length > 6) {
                            e.target.dataset.formatted = value.substring(0, 2) + '-' + value.substring(2, 6) + '-' + value.substring(6);
                        }
                    }
                    
                    // Clear any existing error states when typing
                    if (hasUserInteracted) {
                        e.target.classList.remove('is-invalid');
                        removeCustomError(e.target, 'mobile-error');
                    }
                });
                
                mobileInput.addEventListener('blur', function(e) {
                    hasUserInteracted = true;
                    validateMobileNumber(e.target);
                });
                
                mobileInput.addEventListener('focus', function(e) {
                    // Clear validation state on focus
                    e.target.classList.remove('is-valid', 'is-invalid');
                });
            }

            function validateMobileNumber(input) {
                const value = input.value.trim();
                const thaiMobilePattern = /^(08|09|06|07)\d{8}$/;
                const internationalPattern = /^\+66[6-9]\d{8}$/;
                
                if (!value) {
                    input.classList.remove('is-valid', 'is-invalid');
                    validFields.delete('MobileNo');
                    removeCustomError(input, 'mobile-error');
                    return;
                }
                
                if (thaiMobilePattern.test(value) || internationalPattern.test(value)) {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                    validFields.add('MobileNo');
                    removeCustomError(input, 'mobile-error');
                    showFieldSuccess(input, 'Mobile number verified');
                } else {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    validFields.delete('MobileNo');
                    const currentLang = localStorage.getItem('preferredLanguage') || 'th';
                    const errorMessage = currentLang === 'th' ? 
                        'กรุณาใส่เบอร์โทรศัพท์ที่ถูกต้อง (08xxxxxxxx หรือ +66xxxxxxxx)' : 
                        'Please enter a valid mobile number (08xxxxxxxx or +66xxxxxxxx)';
                    showCustomError(input, 'mobile-error', errorMessage);
                }
            }

            // Enhanced account number validation
            const accountInput = document.querySelector('input[name="AccountNo"]');
            if (accountInput) {
                let hasUserInteracted = false;
                
                accountInput.addEventListener('input', function(e) {
                    let value = e.target.value;
                    // Only allow digits
                    value = value.replace(/[^\d]/g, '');
                    e.target.value = value;
                    
                    // Clear any existing error states when typing
                    if (hasUserInteracted) {
                        e.target.classList.remove('is-invalid');
                    }
                });

                accountInput.addEventListener('blur', function(e) {
                    hasUserInteracted = true;
                    validateAccountNumber(e.target);
                });
                
                accountInput.addEventListener('focus', function(e) {
                    // Clear validation state on focus
                    e.target.classList.remove('is-valid', 'is-invalid');
                });
            }

            function validateAccountNumber(input) {
                const value = input.value.trim();
                const accountPattern = /^\d{10,15}$/;
                
                if (!value) {
                    input.classList.remove('is-valid', 'is-invalid');
                    validFields.delete('AccountNo');
                    return;
                }
                
                if (accountPattern.test(value)) {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                    validFields.add('AccountNo');
                    showFieldSuccess(input, 'Account number format is valid');
                } else {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    validFields.delete('AccountNo');
                }
            }

            // Enhanced form submission with loading states
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Final validation check - validate all fields
                const allInputs = form.querySelectorAll('input[required], select[required]');
                let formIsValid = true;
                
                allInputs.forEach(input => {
                    if (input.name === 'MobileNo') {
                        validateMobileNumber(input);
                    } else if (input.id === 'nationalIdInput') {
                        validateNationalId(input);
                    } else if (input.name === 'AccountNo') {
                        validateAccountNumber(input);
                    } else {
                        validateRequiredField(input);
                    }
                    
                    if (input.classList.contains('is-invalid') || (!input.value.trim() && input.hasAttribute('required'))) {
                        formIsValid = false;
                    }
                });
                
                if (!formIsValid) {
                    const currentLang = localStorage.getItem('preferredLanguage') || 'th';
                    const errorMessage = currentLang === 'th' ? 
                        'กรุณากรอกข้อมูลให้ครบถ้วนและถูกต้อง' : 
                        'Please fill all required fields correctly';
                    if (typeof showNotification === 'function') {
                        showNotification(errorMessage, 'error');
                    }
                    
                    // Reset button state if validation fails
                    resetButtonState(submitBtn);
                    return false;
                }

                // Show loading state
                const btnContent = submitBtn.querySelector('.btn-content');
                const btnLoading = submitBtn.querySelector('.btn-loading');
                
                if (btnContent && btnLoading) {
                    btnContent.classList.add('d-none');
                    btnLoading.classList.remove('d-none');
                    submitBtn.disabled = true;
                } else {
                    // Fallback if structure is different
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = `
                        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
                        <span>กำลังดำเนินการ...</span>
                    `;
                }
                
                // Show processing notification
                const currentLang = localStorage.getItem('preferredLanguage') || 'th';
                const processingMessage = currentLang === 'th' ? 
                    'กำลังดำเนินการ กรุณารอสักครู่...' : 
                    'Processing your request, please wait...';
                if (typeof showNotification === 'function') {
                    showNotification(processingMessage, 'info', {
                        duration: 0, // Don't auto-dismiss
                        showCloseButton: false
                    });
                }
                
                // Simulate processing time (remove in production)
                setTimeout(() => {
                    form.submit();
                }, 1500);
            });

            // Enhanced field validation for all inputs
            const allInputs = form.querySelectorAll('input[required], select[required]');
            allInputs.forEach(input => {
                let hasUserInteracted = false;
                
                input.addEventListener('blur', function(e) {
                    hasUserInteracted = true;
                    validateRequiredField(e.target);
                });
                
                input.addEventListener('input', function(e) {
                    if (hasUserInteracted) {
                        clearFieldError(e.target);
                        if (e.target.value.trim()) {
                            validateRequiredField(e.target);
                        }
                    }
                });
                
                input.addEventListener('focus', function(e) {
                    // Clear validation state on focus
                    e.target.classList.remove('is-valid', 'is-invalid');
                });
            });

            function validateRequiredField(field) {
                const fieldName = field.name;
                
                // Skip fields with custom validation
                if (fieldName === 'MobileNo' || field.id === 'nationalIdInput' || fieldName === 'AccountNo') {
                    return;
                }

                if (field.checkValidity() && field.value.trim()) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                    validFields.add(fieldName);
                    
                    if (fieldName === 'FullName') {
                        showFieldSuccess(field, 'Name entered successfully');
                    } else if (fieldName === 'BranchId') {
                        showFieldSuccess(field, 'Branch selected successfully');
                    }
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                    validFields.delete(fieldName);
                }
            }

            function clearFieldError(field) {
                field.classList.remove('is-invalid');
                validFields.delete(field.name);
                removeCustomError(field, 'mobile-error');
                removeCustomError(field, 'national-id-error');
            }

            // Helper function to reset button state
            function resetButtonState(button) {
                const btnContent = button.querySelector('.btn-content');
                const btnLoading = button.querySelector('.btn-loading');
                
                if (btnContent && btnLoading) {
                    btnContent.classList.remove('d-none');
                    btnLoading.classList.add('d-none');
                }
                
                button.disabled = false;
            }

            // Helper functions for error/success messages
            function showCustomError(input, className, message) {
                removeCustomError(input, className);
                const errorSpan = document.createElement('div');
                errorSpan.className = className + ' text-danger small mt-1';
                errorSpan.textContent = message;
                input.parentNode.appendChild(errorSpan);
            }

            function removeCustomError(input, className) {
                const errorSpan = input.parentNode.querySelector('.' + className);
                if (errorSpan) errorSpan.remove();
            }

            function showFieldSuccess(input, message) {
                // Optional: Show success tooltip or brief message
                if (input.title !== message) {
                    input.title = message;
                    setTimeout(() => {
                        input.title = '';
                    }, 3000);
                }
            }

            // No need to initialize validation on page load - wait for user interaction
        });
    </script>
}