@using BizConnect.ViewModels.Modern
@model ModernRegistrationViewModel
@{
    await Html.PartialAsync("_LanguageTexts");
    ViewData["Title"] = ViewBag.IsThaiLanguage ? "ลงทะเบียนหักบัญชีอัตโนมัติ" : "Direct Debit Registration";
}

@section Styles {
    <!-- Consistent Registration Form Styles -->
    <link href="~/css/kbank-register-consistent.css" rel="stylesheet" />
}

<div class="landing-wrapper">
    <div class="register-container">
        <!-- Progress Steps Section -->
        <section class="steps-section mb-4">
            <div class="steps-container">
                <div class="section-header">
                    <h2 class="section-title" data-text-th="ขั้นตอนการลงทะเบียน" data-text-en="Registration Process">@ViewBag.TextRegistrationProcess</h2>
                    <p class="section-subtitle" 
                       data-text-th="เพียง 3 ขั้นตอนง่ายๆ คุณก็สามารถลงทะเบียนบริการหักบัญชีอัตโนมัติได้แล้ว"
                       data-text-en="Just 3 simple steps to register for automatic direct debit service">
                        @ViewBag.TextRegistrationStepsDesc
                    </p>
                </div>

                <div class="steps-grid">
                    <div class="step-card completed">
                        <div class="step-indicator">
                            <div class="step-number">1</div>
                            <div class="step-icon-overlay">
                                <i class="fas fa-check"></i>
                            </div>
                        </div>
                        <div class="step-content">
                            <h3 class="step-title" data-text-th="ยืนยัน OTAC" data-text-en="Verify OTAC">@ViewBag.TextVerifyOtac</h3>
                            <p class="step-description"
                               data-text-th="ยืนยันรหัส OTAC ที่ได้รับจากเจ้าหน้าที่เพื่อเริ่มกระบวนการลงทะเบียน รหัสนี้ใช้ได้เพียงครั้งเดียว"
                               data-text-en="Verify OTAC code received from staff to start registration process. This code is for one-time use only">
                                @ViewBag.TextVerifyOtacDesc
                            </p>
                        </div>
                    </div>

                    <div class="step-card active">
                        <div class="step-indicator">
                            <div class="step-number">2</div>
                            <div class="step-icon-overlay">
                                <i class="fas fa-edit"></i>
                            </div>
                        </div>
                        <div class="step-content">
                            <h3 class="step-title" data-text-th="กรอกข้อมูล" data-text-en="Fill Information">@ViewBag.TextFillInformation</h3>
                            <p class="step-description"
                               data-text-th="กรอกข้อมูลส่วนตัว หมายเลขบัญชี และรายละเอียดที่จำเป็นสำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ"
                               data-text-en="Fill in personal information, account number, and required details for automatic direct debit service registration">
                                @ViewBag.TextFillInformationDesc
                            </p>
                        </div>
                    </div>

                    <div class="step-card">
                        <div class="step-indicator">
                            <div class="step-number">3</div>
                            <div class="step-icon-overlay">
                                <i class="fas fa-university"></i>
                            </div>
                        </div>
                        <div class="step-content">
                            <h3 class="step-title" data-text-th="ยืนยันผ่าน KBank" data-text-en="Confirm via KBank">@ViewBag.TextConfirmViaKBank</h3>
                            <p class="step-description"
                               data-text-th="ระบบจะเชื่อมต่อกับ KBank เพื่อยืนยันข้อมูลและเปิดใช้งานบริการหักบัญชีอัตโนมัติให้คุณ"
                               data-text-en="System will connect to KBank to verify information and activate automatic direct debit service for you">
                                @ViewBag.TextConfirmViaKBankDesc
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Registration Card -->
        <div class="otac-card register-form-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-university"></i>
                </div>
                <h3 class="card-title">@ViewData["Title"]</h3>
                <p class="card-subtitle">
                    <span data-text-th="กรุณากรอกข้อมูลของท่านให้ครบถ้วนและถูกต้องเพื่อลงทะเบียนบริการหักบัญชีอัตโนมัติของ KBank" data-text-en="Please fill in your information completely and accurately to register for KBank's automatic direct debit service">@ViewBag.TextPleaseFillInfo</span>
                </p>

                <!-- OTAC Status Display -->
                <div class="hero-badge mb-3">
                    <i class="fas fa-shield-alt"></i>
                    <span data-text-th="รหัส OTAC ที่ยืนยันแล้ว: @Model.OtacCode" data-text-en="Verified OTAC Code: @Model.OtacCode">@ViewBag.TextVerifiedOtacCode @Model.OtacCode</span>
                </div>
            </div>

            <!-- Registration Form -->
            @using (Html.BeginForm("Register", "KBank", FormMethod.Post, new { @class = "otac-form", @id = "registerForm", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                <input asp-for="OtacCode" type="hidden" />

                <!-- Personal Information Section -->
                <div class="form-section mb-4">
                    <h4 class="section-heading">
                        <i class="fas fa-user me-2"></i>
                        <span data-text-th="ข้อมูลส่วนตัว" data-text-en="Personal Information">@ViewBag.TextPersonalInfo</span>
                    </h4>

                    <div class="row">
                        <div class="col-12">
                            <div class="otac-input-group mb-3">
                                <label class="input-label required-field" for="FullName" 
                                       data-text-th="ชื่อ-นามสกุล" 
                                       data-text-en="Full Name">@ViewBag.TextFullNameLabel</label>
                                @Html.TextBoxFor(m => m.FullName, new { 
                                    @class = "otac-input", 
                                    @id = "FullName", 
                                    placeholder = ViewBag.TextFullNameLabel,
                                    @data_placeholder_th = "ชื่อ-นามสกุล",
                                    @data_placeholder_en = "Full Name", 
                                    @required = "required" 
                                })
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1", style = "display: none;" })
                                <div class="input-hint">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span data-text-th="กรุณากรอกชื่อ-นามสกุลตามเอกสารทางราชการ" data-text-en="Please enter full name as per official documents">@ViewBag.TextFullNameHint</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="otac-input-group mb-3">
                                <label class="input-label required-field" for="IdValue" 
                                       data-text-th="เลขบัตรประชาชน (13 หลัก)" 
                                       data-text-en="National ID Number (13 digits)">@ViewBag.TextNationalIdLabel</label>
                                @Html.TextBoxFor(m => m.IdValue, new { 
                                    @class = "otac-input", 
                                    @id = "idValueInput", 
                                    placeholder = ViewBag.TextNationalIdLabel,
                                    @data_placeholder_th = "เลขบัตรประชาชน",
                                    @data_placeholder_en = "National ID Number", 
                                    @required = "required" 
                                })
                                @Html.ValidationMessageFor(m => m.IdValue, "", new { @class = "text-danger small mt-1", style = "display: none;" })
                                <div class="input-hint" id="idHint">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span id="idHintText" data-text-th="ใช้เฉพาะบัตรประชาชนไทยเท่านั้น - กรอกตัวเลข 13 หลัก" data-text-en="Thai National ID only - enter 13 digits">@ViewBag.TextNationalIdHint</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Information Section -->
                <div class="form-section mb-4">
                    <h4 class="section-heading">
                        <i class="fas fa-phone me-2"></i>
                        <span data-text-th="ข้อมูลการติดต่อ" data-text-en="Contact Information">@ViewBag.TextContactInfo</span>
                    </h4>

                    <div class="row">
                        <div class="col-12">
                            <div class="otac-input-group mb-3">
                                <label class="input-label required-field" for="MobileNo" 
                                       data-text-th="เบอร์มือถือ" 
                                       data-text-en="Mobile Number">@ViewBag.TextMobileLabel</label>
                                @Html.TextBoxFor(m => m.MobileNo, new { 
                                    @class = "otac-input", 
                                    @id = "mobileInput", 
                                    placeholder = ViewBag.TextMobileLabel,
                                    @data_placeholder_th = "เบอร์มือถือ",
                                    @data_placeholder_en = "Mobile Number", 
                                    @required = "required" 
                                })
                                @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger small mt-1", style = "display: none;" })
                                <div class="input-hint">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span data-text-th="รูปแบบ: 08XXXXXXXX หรือ 09XXXXXXXX (10 หลัก)" data-text-en="Format: 08XXXXXXXX or 09XXXXXXXX (10 digits)">@ViewBag.TextMobileHint</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Information Section -->
                <div class="form-section mb-4">
                    <h4 class="section-heading">
                        <i class="fas fa-university me-2"></i>
                        <span data-text-th="ข้อมูลบัญชีธนาคาร" data-text-en="Bank Account Information">@ViewBag.TextBankAccountInfo</span>
                    </h4>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="otac-input-group mb-3">
                                <label class="input-label required-field" for="AccountNo" 
                                       data-text-th="เลขที่บัญชี" 
                                       data-text-en="Account Number">@ViewBag.TextAccountLabel</label>
                                @Html.TextBoxFor(m => m.AccountNo, new { 
                                    @class = "otac-input", 
                                    @id = "accountInput", 
                                    placeholder = ViewBag.TextAccountLabel,
                                    @data_placeholder_th = "เลขที่บัญชี",
                                    @data_placeholder_en = "Account Number", 
                                    @required = "required" 
                                })
                                @Html.ValidationMessageFor(m => m.AccountNo, "", new { @class = "text-danger small mt-1", style = "display: none;" })
                                <div class="input-hint">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span data-text-th="เลขบัญชี KBank 10-15 หลัก (ไม่ต้องใส่เครื่องหมายขีด)" data-text-en="KBank account number 10-15 digits (no dashes)">@ViewBag.TextAccountHint</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="otac-input-group mb-3">
                                <label class="input-label required-field" for="BranchId" 
                                       data-text-th="สาขาที่เปิดบัญชี" 
                                       data-text-en="Branch where account was opened">@ViewBag.TextBranchLabel</label>
                                <select asp-for="BranchId" asp-items="Model.Branches" class="otac-input" required>
                                    <option value="">@ViewBag.TextSelectBranch</option>
                                </select>
                                @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger small mt-1", style = "display: none;" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms and Submit -->
                <div class="form-section mb-4">
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            <span data-text-th="ข้าพเจ้าได้อ่านและยอมรับ" data-text-en="I have read and accept">@ViewBag.TextIHaveReadAndAccept</span>
                            <a href="#" class="text-primary fw-bold" data-bs-toggle="modal" data-bs-target="#termsModal">
                                <span data-text-th="ข้อกำหนดและเงื่อนไข" data-text-en="Terms and Conditions">@ViewBag.TextTermsAndConditions</span>
                            </a>
                            <span data-text-th="และ" data-text-en="and"> และ </span>
                            <a href="#" class="text-primary fw-bold" data-bs-toggle="modal" data-bs-target="#privacyModal">
                                <span data-text-th="นโยบายความเป็นส่วนตัว" data-text-en="Privacy Policy">@ViewBag.TextPrivacyPolicy</span>
                            </a>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="invalid-feedback" style="display: none;">
                            <span data-text-th="กรุณายอมรับข้อกำหนดและเงื่อนไขก่อนดำเนินการต่อ" data-text-en="Please accept the terms and conditions before proceeding">@ViewBag.TextMustAcceptTerms</span>
        </div>
                    </div>

                    <button type="submit" class="card-action" id="submitBtn">
                        <span class="btn-text">
                            <i class="fas fa-arrow-right"></i>
                            <span data-text-th="ลงทะเบียนหักบัญชีอัตโนมัติ" data-text-en="Register for Direct Debit">@ViewBag.TextRegisterDirectDebit</span>
                        </span>
                        <span class="btn-spinner d-none">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span data-text-th="กำลังดำเนินการ..." data-text-en="Processing...">กำลังดำเนินการ...</span>
                        </span>
                    </button>
                </div>
            }
        </div>

        <!-- Security Section (matching landing page style) -->
        <section class="security-section">
            <div class="security-container">
                <div class="security-content">
                    <h2 data-text-th="ความปลอดภัยระดับธนาคาร" data-text-en="Bank-Grade Security">@ViewBag.TextSecurityTitle</h2>

                    <div class="security-features">
                        <div class="security-feature">
                            <div class="security-icon">
                                <i class="fas fa-lock"></i>
                            </div>
                            <div class="security-text">
                                <h3 data-text-th="เข้ารหัสระดับสูง" data-text-en="High-Level Encryption">@ViewBag.TextHighLevelEncryption</h3>
                                <p data-text-th="ข้อมูลทั้งหมดได้รับการเข้ารหัส SSL/TLS และมาตรฐานความปลอดภัยของธนาคาร" 
                                   data-text-en="All data is encrypted with SSL/TLS and bank-grade security standards">@ViewBag.TextEncryptionDesc</p>
                            </div>
                        </div>

                        <div class="security-feature">
                            <div class="security-icon">
                                <i class="fas fa-key"></i>
                            </div>
                            <div class="security-text">
                                <h3 data-text-th="รหัส OTAC แบบใช้ครั้งเดียว" data-text-en="One-Time OTAC Code">@ViewBag.TextOneTimeOtac</h3>
                                <p data-text-th="รหัสมีอายุจำกัดและใช้ได้เพียงครั้งเดียว ป้องกันการใช้งานโดยไม่ได้รับอนุญาต"
                                   data-text-en="Code has limited validity and can only be used once, preventing unauthorized access">@ViewBag.TextOtacSecurityDesc</p>
                            </div>
                        </div>

                        <div class="security-feature">
                            <div class="security-icon">
                                <i class="fas fa-eye"></i>
                            </div>
                            <div class="security-text">
                                <h3 data-text-th="ติดตามและตรวจสอบ" data-text-en="Monitoring & Tracking">@ViewBag.TextMonitoringTracking</h3>
                                <p data-text-th="ระบบมีการบันทึกและติดตามการใช้งานทุกขั้นตอนเพื่อความปลอดภัย"
                                   data-text-en="System logs and tracks all usage activities for enhanced security">@ViewBag.TextMonitoringDesc</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="security-visual">
                    <div class="otac-card">
                        <div class="card-header">
                            <div class="card-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3 class="card-title" data-text-th="การรักษาความปลอดภัย" data-text-en="Security Protection">@ViewBag.TextSecurityProtection</h3>
                            <p class="card-subtitle" data-text-th="มาตรฐานระดับธนาคาร" data-text-en="Bank-Grade Standard">@ViewBag.TextBankGradeStandard</p>
                        </div>

                        <div style="padding: 1rem 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                <span style="color: var(--text-secondary);" data-text-th="เข้ารหัสข้อมูล" data-text-en="Data Encryption">@ViewBag.TextDataEncryption</span>
                                <span style="color: var(--success); font-weight: 600;" data-text-th="✓ เปิดใช้งาน" data-text-en="✓ Enabled">@ViewBag.TextEnabled</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                <span style="color: var(--text-secondary);" data-text-th="ยืนยันตัวตน" data-text-en="Identity Verification">@ViewBag.TextIdentityVerification</span>
                                <span style="color: var(--success); font-weight: 600;" data-text-th="✓ เปิดใช้งาน" data-text-en="✓ Enabled">@ViewBag.TextEnabled</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="color: var(--text-secondary);" data-text-th="การตรวจสอบ" data-text-en="Monitoring">@ViewBag.TextMonitoring</span>
                                <span style="color: var(--success); font-weight: 600;" data-text-th="✓ เปิดใช้งาน" data-text-en="✓ Enabled">@ViewBag.TextEnabled</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="termsModalLabel">
                    <i class="fas fa-file-contract me-2"></i><span data-text-th="ข้อกำหนดและเงื่อนไข" data-text-en="Terms and Conditions">@ViewBag.TextTermsModalTitle</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="terms-content">
                    <h6><span data-text-th="1. การใช้บริการ" data-text-en="1. Service Usage">1. @ViewBag.TextTermsServiceUsage</span></h6>
                    <p><span data-text-th="ท่านตกลงใช้บริการหักบัญชีอัตโนมัติตามเงื่อนไขที่กำหนดโดย KBank และ BizConnect" data-text-en="You agree to use the direct debit service according to the terms and conditions set by KBank and BizConnect">@ViewBag.TextTermsServiceUsageContent</span></p>
                    
                    <h6><span data-text-th="2. ความถูกต้องของข้อมูล" data-text-en="2. Data Accuracy">2. @ViewBag.TextTermsDataAccuracy</span></h6>
                    <p>@ViewBag.TextTermsDataAccuracyContent</p>
                    
                    <h6><span data-text-th="3. ความรับผิดชอบ" data-text-en="3. Responsibility">3. @ViewBag.TextTermsResponsibility</span></h6>
                    <p>@ViewBag.TextTermsResponsibilityContent</p>
                    
                    <h6><span data-text-th="4. การแก้ไขข้อกำหนด" data-text-en="4. Terms Modifications">4. @ViewBag.TextTermsModifications</span></h6>
                    <p>@ViewBag.TextTermsModificationsContent</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-text-th="ปิด" data-text-en="Close">@ViewBag.TextClose</button>
                <button type="button" class="btn btn-primary" onclick="acceptTerms()" data-text-th="ยอมรับ" data-text-en="Accept">@ViewBag.TextAccept</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="privacyModalLabel">
                    <i class="fas fa-user-shield me-2"></i><span data-text-th="นโยบายความเป็นส่วนตัว" data-text-en="Privacy Policy">@ViewBag.TextPrivacyModalTitle</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="privacy-content">
                    <h6><span data-text-th="การเก็บรวบรวมข้อมูล" data-text-en="Data Collection">@ViewBag.TextPrivacyDataCollection</span></h6>
                    <p>@ViewBag.TextPrivacyDataCollectionContent</p>
                    
                    <h6><span data-text-th="การใช้ข้อมูล" data-text-en="Data Usage">@ViewBag.TextPrivacyDataUsage</span></h6>
                    <p>@ViewBag.TextPrivacyDataUsageContent</p>
                    
                    <h6><span data-text-th="การเปิดเผยข้อมูล" data-text-en="Data Disclosure">@ViewBag.TextPrivacyDataDisclosure</span></h6>
                    <p>@ViewBag.TextPrivacyDataDisclosureContent</p>
                    
                    <h6><span data-text-th="ความปลอดภัย" data-text-en="Security">@ViewBag.TextPrivacyDataSecurity</span></h6>
                    <p>@ViewBag.TextPrivacyDataSecurityContent</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-text-th="ปิด" data-text-en="Close">@ViewBag.TextClose</button>
                <button type="button" class="btn btn-info" onclick="acceptPrivacy()" data-text-th="ยอมรับ" data-text-en="Accept">@ViewBag.TextAccept</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set validation messages for JavaScript use
        window.validationMessages = {
            nationalIdValidation: '@ViewBag.TextNationalIdValidation',
            nationalIdHintValidation: '@ViewBag.TextNationalIdHintValidation',
            fullNameValidation: '@ViewBag.TextFullNameValidation',
            mobileValidation: '@ViewBag.TextMobileValidation',
            accountValidation: '@ViewBag.TextAccountValidation',
            branchValidation: '@ViewBag.TextBranchValidation',
            checkFormData: '@ViewBag.TextCheckFormData',
            submittingData: '@ViewBag.TextSubmittingData'
        };
        
        // Check for server-side validation errors and show them only on form submission attempt
        document.addEventListener('DOMContentLoaded', function() {
            // Check if there are model validation errors (server-side)
            const hasValidationErrors = @(Html.ViewData.ModelState.IsValid ? "false" : "true");
            
            if (hasValidationErrors) {
                // Show validation errors only if this is a form submission response
                const errorElements = document.querySelectorAll('.text-danger');
                errorElements.forEach(element => {
                    if (element.textContent.trim() !== '') {
                        element.style.display = 'flex';
                    }
                });
                
                // Add visual feedback for invalid inputs
                const form = document.getElementById('registerForm');
                if (form) {
                    const inputs = form.querySelectorAll('input[required], select[required]');
                    inputs.forEach(input => {
                        const errorElement = input.parentNode.querySelector('.text-danger');
                        if (errorElement && errorElement.textContent.trim() !== '') {
                            input.classList.add('is-invalid');
                        }
                    });
                }
            }
        });
        
        // Display TempData messages
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                showAlert('danger', '@Html.Raw(TempData["ErrorMessage"])');
            });
            </text>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                showAlert('success', '@Html.Raw(TempData["SuccessMessage"])');
            });
            </text>
        }
    </script>
    <script src="~/js/kbank-register.js"></script>
}