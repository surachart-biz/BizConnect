        /* Mobile responsive notifications */
        @@media (max-width: 768px) {
            .notification-container {
                top: 70px !important;
                right: 10px !important;
                left: 10px !important;
                max-width: none !important;
            }
            
            .enhanced-notification {
                min-width: auto !important;
                max-width: none !important;
                width: 100% !important;
            }
