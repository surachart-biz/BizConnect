<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BizConnect</title>

    <!-- PWA Meta Tags -->
    <meta name="description" content="Your comprehensive business networking and collaboration platform. Connect with professionals, manage projects, and grow your business network." />
    <meta name="theme-color" content="#007bff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="BizConnect" />
    <meta name="msapplication-TileColor" content="#007bff" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192x192.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16x16.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Security Meta Tags -->
    <meta name="csrf-token" content="@Html.AntiForgeryToken().ToString()">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="user-authenticated" content="true">
        <meta name="user-roles" content="@string.Join(",", User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))">
    }

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BizConnect.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="modern-header">
        <nav class="navbar navbar-expand-lg modern-navbar">
            <div class="container">
                <!-- Brand Logo -->
                <a class="modern-brand" asp-controller="Home" asp-action="Index">
                    <div class="modern-brand-icon">
                        <i class="fas fa-network-wired"></i>
                    </div>
                    <span>BizConnect</span>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Main Navigation -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="modern-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i>Home
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="modern-nav-link" href="#" onclick="return false;">
                                    <i class="fas fa-users"></i>Network
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="modern-nav-link" href="#" onclick="return false;">
                                    <i class="fas fa-briefcase"></i>Opportunities
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="modern-nav-link" asp-controller="Home" asp-action="Dashboard" asp-area="Admin">
                                        <i class="fas fa-tachometer-alt"></i>Admin
                                    </a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="modern-nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-shield-alt"></i>Privacy
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown dropdown-modern">
                                <a class="modern-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-question-circle"></i>Help
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-header">Getting Started</li>
                                    <li><a class="dropdown-item" href="#" onclick="BizConnectGuidedTour.startDashboardTour()">
                                        <i class="fas fa-play me-2"></i>Dashboard Tour
                                    </a></li>
                                    <li><a class="dropdown-item" href="#" onclick="BizConnectGuidedTour.startNetworkingTour()">
                                        <i class="fas fa-users me-2"></i>Networking Tour
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Onboarding" asp-action="Index">
                                        <i class="fas fa-redo me-2"></i>Restart Onboarding
                                    </a></li>
                                    <li><a class="dropdown-item" href="#" onclick="showHelpModal()">
                                        <i class="fas fa-info-circle me-2"></i>Getting Started
                                    </a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- User Menu -->
                    <ul class="navbar-nav">
                        <!-- Language Toggle -->
                        <li class="nav-item me-3">
                            @await Html.PartialAsync("_LanguageToggle")
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Security Status Widget (Header) -->
                            <li class="nav-item me-2">
                                <div id="headerSecurityWidget" class="d-none"></div>
                            </li>
                        }
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Notifications (placeholder) -->
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="#" onclick="return false;" title="Notifications">
                                    <i class="fas fa-bell"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                        3
                                        <span class="visually-hidden">unread notifications</span>
                                    </span>
                                </a>
                            </li>

                            <!-- User Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bc-avatar me-2">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <span class="d-none d-md-inline">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-modern" aria-labelledby="userDropdown">
                                    <li>
                                        <h6 class="dropdown-header">
                                            <i class="fas fa-user-circle me-2"></i>@User.Identity.Name
                                        </h6>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="return false;">
                                            <i class="fas fa-user-edit me-2"></i>Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="return false;">
                                            <i class="fas fa-cog me-2"></i>Settings
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="Dashboard" asp-area="Admin">
                                                <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="modern-nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i>Login
                                </a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn-modern btn-kbank" href="#" onclick="return false;">
                                    <i class="fas fa-user-plus"></i>Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-card mt-5 mx-4 mb-4 p-4 text-center">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div class="text-kbank fw-semibold">
                &copy; 2025 BizConnect - Powered by KBank Technology
            </div>
            <div class="d-flex gap-3">
                <a class="text-decoration-none text-muted" asp-controller="Home" asp-action="Privacy">
                    <i class="fas fa-shield-alt me-1"></i>Privacy Policy
                </a>
                <a class="text-decoration-none text-muted" href="#">
                    <i class="fas fa-file-contract me-1"></i>Terms of Service
                </a>
                <a class="text-decoration-none text-muted" href="#">
                    <i class="fas fa-phone me-1"></i>Support
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <!-- Modern UI System -->
    <script src="~/js/modern-ui.js" asp-append-version="true"></script>
    <script src="~/js/real-time-updates.js" asp-append-version="true"></script>
    
    <!-- Legacy Scripts -->
    <script src="~/js/language-switcher.js" asp-append-version="true"></script>
    <script src="~/js/loading.js" asp-append-version="true"></script>
    <script src="~/js/interactions.js" asp-append-version="true"></script>
    <script src="~/js/guided-tour.js" asp-append-version="true"></script>
    <script src="~/js/home-enhancements.js" asp-append-version="true"></script>
    <script src="~/js/ui-interactions.js" asp-append-version="true"></script>
    <script src="~/js/performance-monitor.js" asp-append-version="true"></script>
    <script src="~/js/ui-tester.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sw-register.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Security System Scripts -->
        <script src="~/js/security-validation.js" asp-append-version="true"></script>
        <script src="~/js/security-monitor.js" asp-append-version="true"></script>
        <script src="~/js/session-manager.js" asp-append-version="true"></script>
        <script src="~/js/security-widgets.js" asp-append-version="true"></script>
        <script src="~/js/api-security.js" asp-append-version="true"></script>
        <script src="~/js/security-integration.js" asp-append-version="true"></script>
        
        <script>
            // Configure security system for current user
            window.sessionConfig = {
                sessionTimeout: @(Context.Session.GetInt32("SessionTimeout") ?? 30),
                warningTime: @(Context.Session.GetInt32("WarningTime") ?? 25),
                enableAutoRefresh: true,
                enableActivityTracking: true,
                enableSecurityIntegration: true
            };

            window.securityWidgetsConfig = {
                enableFloatingWidget: @(Context.Request.Path.StartsWithSegments("/Admin") ? "false" : "true"),
                enableHeaderWidget: true,
                enableFormWidgets: true,
                position: 'bottom-right',
                theme: 'auto'
            };

            window.apiSecurityConfig = {
                enableRequestSigning: false, // Enable when API keys are configured
                enableRateLimiting: true,
                enableResponseValidation: true,
                enableRequestFingerprinting: true
            };
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
