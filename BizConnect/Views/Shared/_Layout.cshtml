    <script>
        // Minimal global functions - most functionality moved to separate JS files
        
        // Enhanced global notification function with auto-dismiss and manual close
        function showNotification(message, type = 'info', options = {}) {
            // Create notification container if it doesn't exist
            let container = document.getElementById('notificationContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'notificationContainer';
                container.className = 'position-fixed notification-container';
                container.style.cssText = 'top: 80px; right: 20px; max-width: 380px; z-index: 9999; pointer-events: none;';
                document.body.appendChild(container);
            }
            
            // Default options
            const defaults = {
                title: type.charAt(0).toUpperCase() + type.slice(1),
                duration: 5000,
                autoDismiss: true,
                showCloseButton: true
            };
            const config = { ...defaults, ...options };
            
            // Create enhanced notification element
            const notificationId = 'notification_' + Date.now();
            const notification = document.createElement('div');
            const colors = {
                success: 'alert-success',
                error: 'alert-danger', 
                warning: 'alert-warning',
                info: 'alert-info'
            };
            const icons = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-triangle',
                warning: 'fa-exclamation-circle',
                info: 'fa-info-circle'
            };
            
            notification.id = notificationId;
            notification.className = `alert ${colors[type]} alert-dismissible fade show shadow-lg enhanced-notification`;
            notification.style.cssText = `
                min-width: 350px; 
                max-width: 380px; 
                border-radius: 12px; 
                border: none;
                backdrop-filter: blur(10px);
                animation: slideInRight 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                margin-bottom: 1rem;
                pointer-events: auto;
                position: relative;
                overflow: hidden;
            `;
            
            // Add auto-dismiss progress bar
            let progressBarHtml = '';
            if (config.autoDismiss && config.duration > 0) {
                notification.classList.add('auto-dismiss');
                progressBarHtml = '<div class="progress-bar" style="position: absolute; bottom: 0; left: 0; height: 3px; background: rgba(255,255,255,0.6); width: 100%; animation: progressBar ' + (config.duration/1000) + 's linear forwards;"></div>';
            }
            
            notification.innerHTML = `
                <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.25rem 0;">
                    <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                        <i class="fas ${icons[type]}"></i>
                    </div>
                    <div style="flex: 1; line-height: 1.5;">
                        <div style="font-weight: 600; margin-bottom: 0.25rem; font-size: 0.9rem;">${config.title}</div>
                        <div style="font-size: 0.85rem;">${message}</div>
                    </div>
                    ${config.showCloseButton ? '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="opacity: 0.8; transition: all 0.2s ease;" onmouseover="this.style.opacity=1; this.style.transform=\'scale(1.1)\'" onmouseout="this.style.opacity=0.8; this.style.transform=\'scale(1)\'"></button>' : ''}
                </div>
                ${progressBarHtml}
            `;
            
            container.appendChild(notification);
            
            // Auto remove with enhanced animation
            if (config.autoDismiss && config.duration > 0) {
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.style.animation = 'slideOutRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards';
                        setTimeout(() => {
                            if (notification.parentNode) {
                                notification.remove();
                            }
                        }, 300);
                    }
                }, config.duration);
            }
            
            // Manual close button functionality
            const closeBtn = notification.querySelector('.btn-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', function() {
                    notification.style.animation = 'slideOutRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            notification.remove();
                        }
                    }, 300);
                });
            }
            
            return notification;
        }

        // Dynamic height adjustment for viewport optimization
        function adjustHeroHeight() {
            const header = document.querySelector('.header');
            const heroSection = document.querySelector('.hero-section');
            
            if (header && heroSection) {
                const headerHeight = header.offsetHeight;
                const viewportHeight = window.innerHeight;
                const calculatedHeight = viewportHeight - headerHeight;
                
                // Set minimum height based on actual header height
                heroSection.style.minHeight = calculatedHeight + 'px';
                
                // Debug logging (remove in production)
                console.log('Header height:', headerHeight);
                console.log('Viewport height:', viewportHeight);
                console.log('Calculated hero height:', calculatedHeight);
                
                // Warn if content might cause scrolling
                const heroContent = heroSection.offsetHeight;
                if (heroContent > calculatedHeight) {
                    console.warn('Hero content might cause scrolling. Content height:', heroContent, 'Available height:', calculatedHeight);
                }
            }
        }

        // Run on load and resize
        window.addEventListener('load', adjustHeroHeight);
        window.addEventListener('resize', adjustHeroHeight);

        // Global scroll effects for header
        window.addEventListener('scroll', function() {
            const header = document.querySelector('.header');
            if (header) {
                if (window.scrollY > 50) {
                    header.style.background = 'rgba(255, 255, 255, 0.98)';
                    header.style.backdropFilter = 'blur(15px)';
                } else {
                    header.style.background = 'rgba(255, 255, 255, 0.95)';
                    header.style.backdropFilter = 'blur(12px)';
                }
            }
        });

        // Make showNotification available globally
        window.showNotification = showNotification;
        
        // Bootstrap readiness check
        window.isBootstrapReady = function() {
            return typeof bootstrap !== 'undefined' && bootstrap.Modal;
        };
        
        // Wait for Bootstrap to be ready
        window.waitForBootstrap = function(callback, maxWait = 5000) {
            const startTime = Date.now();
            
            function check() {
                if (window.isBootstrapReady()) {
                    callback(true);
                } else if (Date.now() - startTime < maxWait) {
                    setTimeout(check, 50);
                } else {
                    console.warn('Bootstrap ready timeout reached');
                    callback(false);
                }
            }
            
            check();
        };
    </script>
    <!-- Bootstrap JS with fallback -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" 
            crossorigin="anonymous" 
            onerror="loadBootstrapFallback()"></script>
    
    <script>
        // Bootstrap fallback loader
        function loadBootstrapFallback() {
            console.log('⚠️ CDN Bootstrap failed, loading local fallback...');
            
            // Try to load local Bootstrap
            const fallbackScript = document.createElement('script');
            fallbackScript.src = '/lib/bootstrap/dist/js/bootstrap.bundle.min.js';
            fallbackScript.onerror = function() {
                console.error('❌ Local Bootstrap fallback also failed');
                // Create minimal modal functionality
                window.bootstrap = window.bootstrap || {};
                window.bootstrap.Modal = window.bootstrap.Modal || function(element, options) {
                    return {
                        show: function() {
                            element.style.display = 'block';
                            element.classList.add('show');
                            document.body.classList.add('modal-open');
                        },
                        hide: function() {
                            element.style.display = 'none';
                            element.classList.remove('show');
                            document.body.classList.remove('modal-open');
                        },
                        dispose: function() { /* no-op */ }
                    };
                };
                console.log('✅ Minimal Bootstrap Modal polyfill created');
            };
            document.head.appendChild(fallbackScript);
        }
        
        // Check if Bootstrap loaded correctly after a brief delay
        setTimeout(function() {
            if (typeof bootstrap === 'undefined' || !bootstrap.Modal) {
                console.log('⚠️ Bootstrap not detected after timeout, loading fallback...');
                loadBootstrapFallback();
            } else {
                console.log('✅ Bootstrap loaded successfully from CDN');
            }
        }, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>