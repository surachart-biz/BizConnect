@using Microsoft.AspNetCore.Localization
@using System.Globalization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en-US";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="language-toggle-container">
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle language-toggle-btn" type="button" 
                id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false" 
                title="Change Language / เปลี่ยนภาษา">
            @if (currentCulture.StartsWith("th"))
            {
                <span class="flag-icon">🇹🇭</span>
                <span class="d-none d-md-inline ms-1">ไทย</span>
            }
            else
            {
                <span class="flag-icon">🇺🇸</span>
                <span class="d-none d-md-inline ms-1">English</span>
            }
        </button>
        <ul class="dropdown-menu dropdown-menu-end language-dropdown" aria-labelledby="languageDropdown">
            <li>
                <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="en-US" />
                    <input type="hidden" name="returnUrl" value="@Html.Encode(returnUrl)" />
                    <button type="submit" class="dropdown-item @(currentCulture.StartsWith("en") ? "active" : "")" 
                            data-culture="en-US">
                        <span class="flag-icon me-2">🇺🇸</span>
                        <span>English</span>
                        @if (currentCulture.StartsWith("en"))
                        {
                            <i class="fas fa-check ms-auto text-success"></i>
                        }
                    </button>
                </form>
            </li>
            <li>
                <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="th-TH" />
                    <input type="hidden" name="returnUrl" value="@Html.Encode(returnUrl)" />
                    <button type="submit" class="dropdown-item @(currentCulture.StartsWith("th") ? "active" : "")" 
                            data-culture="th-TH">
                        <span class="flag-icon me-2">🇹🇭</span>
                        <span>ไทย (Thai)</span>
                        @if (currentCulture.StartsWith("th"))
                        {
                            <i class="fas fa-check ms-auto text-success"></i>
                        }
                    </button>
                </form>
            </li>
        </ul>
    </div>
</div>

<style>
.language-toggle-container {
    display: flex;
    align-items: center;
}

.language-toggle-btn {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    background: white;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    min-width: 80px;
}

.language-toggle-btn:hover {
    border-color: #007bff;
    background: #f8f9fa;
}

.language-toggle-btn:focus {
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.flag-icon {
    font-size: 1.1em;
    line-height: 1;
}

.language-dropdown {
    min-width: 160px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    padding: 0.5rem 0;
}

.language-dropdown .dropdown-item {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    transition: all 0.2s ease;
}

.language-dropdown .dropdown-item:hover {
    background: #f8f9fa;
    color: #007bff;
}

.language-dropdown .dropdown-item.active {
    background: #e3f2fd;
    color: #1976d2;
    font-weight: 500;
}

.language-dropdown .dropdown-item .flag-icon {
    font-size: 1em;
}

.language-dropdown .dropdown-item .fas {
    font-size: 0.75rem;
}

/* Admin theme adjustments */
.admin-topbar .language-toggle-btn {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: white;
    font-weight: 500;
}

.admin-topbar .language-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.admin-topbar .language-toggle-btn:focus {
    box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.2);
}

.admin-topbar .language-dropdown {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(10px);
}

.admin-topbar .language-dropdown .dropdown-item {
    color: #333;
    font-weight: 500;
}

.admin-topbar .language-dropdown .dropdown-item:hover {
    background: #f8f9fa;
    color: #007bff;
}

.admin-topbar .language-dropdown .dropdown-item.active {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    color: #1976d2;
}

/* Mobile responsive */
@@media (max-width: 768px) {
    .language-toggle-btn {
        min-width: 60px;
        padding: 0.25rem 0.5rem;
    }
    
    .language-dropdown {
        min-width: 140px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    
    try {
        // Enhanced security: Validate DOM elements exist before manipulation
        const languageForms = document.querySelectorAll('form[action*="SetCulture"]');
        
        if (!languageForms.length) {
            console.warn('BizConnect: No culture forms found');
            return;
        }
        
        languageForms.forEach(form => {
            // Validate form structure
            if (!form || typeof form.submit !== 'function') {
                console.warn('BizConnect: Invalid form element found');
                return;
            }
            
            const button = form.querySelector('button[data-culture]');
            const antiForgeryToken = form.querySelector('input[name="__RequestVerificationToken"]');
            
            if (!button || !antiForgeryToken) {
                console.warn('BizConnect: Form missing required security elements');
                return;
            }
            
            // Secure event handling with proper validation
            button.addEventListener('click', function(e) {
                e.preventDefault();
                
                try {
                    // Validate culture value against whitelist
                    const culture = button.getAttribute('data-culture');
                    const allowedCultures = ['en-US', 'th-TH'];
                    
                    if (!culture || !allowedCultures.includes(culture)) {
                        console.error('BizConnect: Invalid culture value');
                        return false;
                    }
                    
                    // Validate anti-forgery token exists
                    if (!antiForgeryToken.value) {
                        console.error('BizConnect: Security token missing');
                        return false;
                    }
                    
                    // Store preference securely (validate before storing)
                    if (typeof Storage !== 'undefined') {
                        try {
                            localStorage.setItem('preferredCulture', culture);
                        } catch (storageError) {
                            // Continue without localStorage if not available
                            console.warn('BizConnect: Local storage unavailable');
                        }
                    }
                    
                    // Show secure loading indicator
                    const originalContent = button.innerHTML;
                    const loadingHtml = '<i class="fas fa-spinner fa-spin me-2"></i><span>Changing...</span>';
                    
                    button.innerHTML = loadingHtml;
                    button.disabled = true;
                    
                    // Submit form with security validation
                    setTimeout(() => {
                        // Double-check form is still valid before submission
                        if (form && typeof form.submit === 'function' && antiForgeryToken.value) {
                            form.submit();
                        } else {
                            // Restore button if submission failed
                            button.innerHTML = originalContent;
                            button.disabled = false;
                            console.error('BizConnect: Form submission security check failed');
                        }
                    }, 150); // Reduced delay for better UX
                    
                } catch (error) {
                    console.error('BizConnect: Error in culture switching:', error);
                    // Restore button state on error
                    if (button && button.innerHTML.includes('fa-spinner')) {
                        button.disabled = false;
                        // Restore original content if possible
                        const flagIcon = button.querySelector('.flag-icon');
                        if (flagIcon) {
                            const culture = button.getAttribute('data-culture');
                            const isEnglish = culture === 'en-US';
                            button.innerHTML = flagIcon.outerHTML + ' ' + (isEnglish ? 'English' : 'ไทย (Thai)');
                        }
                    }
                    return false;
                }
            });
        });
        
        // Store current culture preference securely
        const currentCultureFromServer = '@Html.Raw(Html.Encode(currentCulture))';
        if (currentCultureFromServer && typeof Storage !== 'undefined') {
            try {
                // Validate culture value before storing
                const allowedCultures = ['en-US', 'th-TH'];
                if (allowedCultures.includes(currentCultureFromServer)) {
                    localStorage.setItem('currentCulture', currentCultureFromServer);
                }
            } catch (error) {
                console.warn('BizConnect: Could not store current culture:', error);
            }
        }
        
    } catch (error) {
        console.error('BizConnect: Critical error in language toggle initialization:', error);
    }
});

// Content Security Policy compatibility - no inline event handlers
// All event handling done through proper DOM event listeners
</script>