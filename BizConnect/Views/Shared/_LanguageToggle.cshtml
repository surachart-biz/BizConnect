@using Microsoft.AspNetCore.Localization
@using System.Globalization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en-US";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="language-toggle-container">
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle language-toggle-btn" type="button" 
                id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false" 
                title="Change Language / เปลี่ยนภาษา">
            @if (currentCulture.StartsWith("th"))
            {
                <span class="flag-icon">🇹🇭</span>
                <span class="d-none d-md-inline ms-1">ไทย</span>
            }
            else
            {
                <span class="flag-icon">🇺🇸</span>
                <span class="d-none d-md-inline ms-1">English</span>
            }
        </button>
        <ul class="dropdown-menu dropdown-menu-end language-dropdown" aria-labelledby="languageDropdown">
            <li>
                <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
                    <input type="hidden" name="culture" value="en-US" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="dropdown-item @(currentCulture.StartsWith("en") ? "active" : "")" 
                            data-culture="en-US">
                        <span class="flag-icon me-2">🇺🇸</span>
                        <span>English</span>
                        @if (currentCulture.StartsWith("en"))
                        {
                            <i class="fas fa-check ms-auto text-success"></i>
                        }
                    </button>
                </form>
            </li>
            <li>
                <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
                    <input type="hidden" name="culture" value="th-TH" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="dropdown-item @(currentCulture.StartsWith("th") ? "active" : "")" 
                            data-culture="th-TH">
                        <span class="flag-icon me-2">🇹🇭</span>
                        <span>ไทย (Thai)</span>
                        @if (currentCulture.StartsWith("th"))
                        {
                            <i class="fas fa-check ms-auto text-success"></i>
                        }
                    </button>
                </form>
            </li>
        </ul>
    </div>
</div>

<style>
.language-toggle-container {
    display: flex;
    align-items: center;
}

.language-toggle-btn {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    background: white;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    min-width: 80px;
}

.language-toggle-btn:hover {
    border-color: #007bff;
    background: #f8f9fa;
}

.language-toggle-btn:focus {
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.flag-icon {
    font-size: 1.1em;
    line-height: 1;
}

.language-dropdown {
    min-width: 160px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    padding: 0.5rem 0;
}

.language-dropdown .dropdown-item {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    transition: all 0.2s ease;
}

.language-dropdown .dropdown-item:hover {
    background: #f8f9fa;
    color: #007bff;
}

.language-dropdown .dropdown-item.active {
    background: #e3f2fd;
    color: #1976d2;
    font-weight: 500;
}

.language-dropdown .dropdown-item .flag-icon {
    font-size: 1em;
}

.language-dropdown .dropdown-item .fas {
    font-size: 0.75rem;
}

/* Admin theme adjustments */
.admin-topbar .language-toggle-btn {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: white;
}

.admin-topbar .language-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
}

/* Mobile responsive */
@@media (max-width: 768px) {
    .language-toggle-btn {
        min-width: 60px;
        padding: 0.25rem 0.5rem;
    }
    
    .language-dropdown {
        min-width: 140px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Store language preference in localStorage
    const languageButtons = document.querySelectorAll('[data-culture]');
    
    languageButtons.forEach(button => {
        button.addEventListener('click', function() {
            const culture = this.getAttribute('data-culture');
            localStorage.setItem('preferredCulture', culture);
            
            // Show loading indicator
            const originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Changing...';
            this.disabled = true;
            
            // Form will submit automatically
        });
    });
    
    // Apply stored preference on page load
    const preferredCulture = localStorage.getItem('preferredCulture');
    if (preferredCulture) {
        const currentCulture = '@currentCulture';
        if (preferredCulture !== currentCulture) {
            // Auto-switch if preference differs from server culture
            // This helps maintain consistency across page loads
        }
    }
});
</script>