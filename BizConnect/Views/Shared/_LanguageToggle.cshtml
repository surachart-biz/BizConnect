@using Microsoft.AspNetCore.Localization
@using System.Globalization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en-US";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="language-toggle-modern">
    <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="culture" value="en-US" />
        <input type="hidden" name="returnUrl" value="@Html.Encode(returnUrl)" />
        <button type="submit" class="language-option @(currentCulture.StartsWith("en") ? "active" : "")" 
                data-culture="en-US" title="Switch to English">
            🇺🇸
        </button>
    </form>
    <form asp-controller="Culture" asp-action="SetCulture" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="culture" value="th-TH" />
        <input type="hidden" name="returnUrl" value="@Html.Encode(returnUrl)" />
        <button type="submit" class="language-option @(currentCulture.StartsWith("th") ? "active" : "")" 
                data-culture="th-TH" title="เปลี่ยนเป็นภาษาไทย">
            🇹🇭
        </button>
    </form>
</div>


