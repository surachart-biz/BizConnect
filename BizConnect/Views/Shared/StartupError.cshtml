@model string?

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuration Error - BizConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .error-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 3rem;
            max-width: 800px;
            margin: 0 auto;
        }
        .error-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            color: white;
            font-size: 2.5rem;
        }
        .error-title {
            color: #2c3e50;
            font-weight: 700;
            margin-bottom: 1rem;
        }
        .error-message {
            color: #5a6c7d;
            line-height: 1.6;
            margin-bottom: 2rem;
        }
        .troubleshooting-card {
            background: #f8f9fa;
            border-left: 4px solid #007bff;
            padding: 1.5rem;
            margin: 1rem 0;
            border-radius: 0 8px 8px 0;
        }
        .step-number {
            background: #007bff;
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: bold;
            margin-right: 0.5rem;
        }
        .code-block {
            background: #2d3748;
            color: #e2e8f0;
            padding: 1rem;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            margin: 0.5rem 0;
            overflow-x: auto;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 25px;
            font-weight: 600;
            transition: transform 0.2s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #5a6fd8, #6a419a);
        }
        .alert-warning {
            border-left: 4px solid #ffc107;
            background: #fff3cd;
            border-color: #ffeaa7;
        }
        .contact-info {
            background: #e3f2fd;
            border-radius: 8px;
            padding: 1rem;
            margin-top: 2rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="error-container">
            <div class="text-center">
                <div class="error-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h1 class="error-title">Configuration Error</h1>
                <p class="error-message">
                    BizConnect encountered a configuration issue during startup. Don't worry - this is usually easy to fix!
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model))
            {
                <div class="alert alert-warning" role="alert">
                    <h5><i class="bi bi-info-circle"></i> Error Details:</h5>
                    <pre style="white-space: pre-wrap; margin: 0;">@Model</pre>
                </div>
            }

            <div class="troubleshooting-card">
                <h4><i class="bi bi-tools"></i> Quick Setup Guide</h4>
                <p>Follow these steps to get BizConnect running:</p>

                <div class="mb-3">
                    <span class="step-number">1</span>
                    <strong>Create Local Configuration File</strong>
                    <p class="ms-4 mt-2">Create <code>appsettings.Local.json</code> in the BizConnect project directory:</p>
                    <div class="code-block">
{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=bizconnect_local;Username=postgres;Password=your_password",
    "HangfireConnection": "Host=localhost;Database=bizconnect_hangfire;Username=postgres;Password=your_password"
  }
}
                    </div>
                </div>

                <div class="mb-3">
                    <span class="step-number">2</span>
                    <strong>Ensure PostgreSQL is Running</strong>
                    <p class="ms-4 mt-2">Start your PostgreSQL service and create the required databases:</p>
                    <div class="code-block">
# Connect to PostgreSQL
psql -U postgres

# Create databases
CREATE DATABASE bizconnect_local;
CREATE DATABASE bizconnect_hangfire;
                    </div>
                </div>

                <div class="mb-3">
                    <span class="step-number">3</span>
                    <strong>Run Database Migrations</strong>
                    <p class="ms-4 mt-2">Execute the database setup script:</p>
                    <div class="code-block">
# Cross-platform (recommended)
./scripts/update-db

# Windows PowerShell
.\scripts\update-db.ps1

# Unix/macOS/WSL
bash ./scripts/update-db.sh
                    </div>
                </div>

                <div class="mb-3">
                    <span class="step-number">4</span>
                    <strong>Verify Configuration</strong>
                    <p class="ms-4 mt-2">Test your configuration:</p>
                    <div class="code-block">
# Run configuration test
.\scripts\test-configuration.ps1

# Start the application
dotnet run --project BizConnect
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <h5><i class="bi bi-lightbulb"></i> Common Issues</h5>
                <ul class="mb-0">
                    <li><strong>Database Connection Failed:</strong> Check PostgreSQL is running and credentials are correct</li>
                    <li><strong>Database Not Found:</strong> Create the databases using the SQL commands above</li>
                    <li><strong>Permission Denied:</strong> Ensure the PostgreSQL user has proper permissions</li>
                    <li><strong>Port Already in Use:</strong> Check if another application is using port 5000/5001</li>
                </ul>
            </div>

            <div class="contact-info">
                <h5><i class="bi bi-question-circle"></i> Need More Help?</h5>
                <p class="mb-2">Check out these resources:</p>
                <ul class="mb-0">
                    <li><strong>README.md</strong> - Comprehensive setup instructions</li>
                    <li><strong>CLAUDE.md</strong> - Project architecture and development guide</li>
                    <li><strong>db/migrations/README.md</strong> - Database migration guidelines</li>
                </ul>
            </div>

            <div class="text-center mt-4">
                <button onclick="window.location.reload()" class="btn btn-primary">
                    <i class="bi bi-arrow-clockwise"></i> Try Again
                </button>
                <a href="https://github.com/your-repo/BizConnect/issues" class="btn btn-outline-secondary ms-2" target="_blank">
                    <i class="bi bi-bug"></i> Report Issue
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>