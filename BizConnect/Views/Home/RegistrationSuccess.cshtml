@{
    ViewData["Title"] = "OTAC Verification Success - BizConnect";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card mt-5">
                <div class="card-body text-center p-5">
                    <!-- Success Icon -->
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>

                    <!-- Success Message -->
                    <h2 class="card-title text-success mb-3">ยืนยันสำเร็จ!</h2>
                    <p class="card-text mb-4">
                        รหัส OTAC <strong>@ViewBag.OtacCode</strong> ได้รับการยืนยันเรียบร้อยแล้ว
                    </p>

                    <!-- Next Steps Info -->
                    <div class="alert alert-info">
                        <h5 class="alert-heading">
                            <i class="fas fa-info-circle me-2"></i>
                            ขั้นตอนต่อไป
                        </h5>
                        <p class="mb-0">
                            ในระบบจริง คุณจะถูกเปลี่ยนเส้นทางไปยังฟอร์มลงทะเบียน KBank
                            เพื่อกรอกข้อมูลส่วนตัวและข้อมูลบัญชี
                        </p>
                    </div>

                    <!-- Demo Actions -->
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg me-3">
                            <i class="fas fa-arrow-left me-2"></i>
                            ลองใหม่อีกครั้ง
                        </a>
                        <button class="btn btn-success btn-lg" onclick="showNextStepInfo()">
                            <i class="fas fa-arrow-right me-2"></i>
                            ดูขั้นตอนถัดไป
                        </button>
                    </div>

                    <!-- Test Codes Info -->
                    <div class="mt-4 pt-4 border-top">
                        <small class="text-muted">
                            <strong>Demo Test Codes:</strong> ABC12345, TEST1234, DEMO5678, OTAC9999
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Next Step Modal -->
<div class="modal fade" id="nextStepModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-list-ol me-2 text-primary"></i>
                    ขั้นตอนถัดไปในระบบจริง
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-marker bg-success">
                            <i class="fas fa-check"></i>
                        </div>
                        <div class="timeline-content">
                            <h6 class="text-success">OTAC Verification ✓</h6>
                            <p class="text-muted mb-0">รหัส OTAC ได้รับการยืนยันแล้ว</p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-marker bg-primary">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="timeline-content">
                            <h6 class="text-primary">Registration Form</h6>
                            <p class="text-muted mb-0">กรอกข้อมูลส่วนตัว, เลขประจำตัว, เบอร์โทร</p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-marker bg-warning">
                            <i class="fas fa-university"></i>
                        </div>
                        <div class="timeline-content">
                            <h6 class="text-warning">Bank Account Info</h6>
                            <p class="text-muted mb-0">กรอกข้อมูลบัญชี KBank และสาขา</p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-marker bg-info">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <div class="timeline-content">
                            <h6 class="text-info">Submit to KBank</h6>
                            <p class="text-muted mb-0">ส่งข้อมูลไปยัง KBank เพื่อดำเนินการ</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 3rem;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: -2.25rem;
            top: 2rem;
            width: 2px;
            height: 100%;
            background: #dee2e6;
        }

    .timeline-marker {
        position: absolute;
        left: -3rem;
        top: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.9rem;
    }

    .timeline-content h6 {
        margin-bottom: 0.5rem;
    }
</style>

<script>
    function showNextStepInfo() {
        var modal = new bootstrap.Modal(document.getElementById('nextStepModal'));
        modal.show();
    }
</script>