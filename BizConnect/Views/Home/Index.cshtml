@model BizConnect.Models.ViewModels.LandingPageViewModel
@{
    ViewData["Title"] = "BizConnect - KBank OTAC Registration";
}

<div class="landing-wrapper">
<!-- Site Header with Authentication - Styled to match _Layout.cshtml -->
<header class="header">
    <nav class="nav-container">
        <div class="logo-section">
            <div class="logo">BC</div>
            <span class="brand-name">BizConnect</span>
            <span class="kbank-badge">KBank Partner</span>
        </div>

        <div class="nav-actions">
            <!-- Language Toggle -->
            <div class="language-toggle">
                <button class="lang-btn" id="langEN" data-lang="en">EN</button>
                <button class="lang-btn active" id="langTH" data-lang="th">TH</button>
            </div>
            
            <!-- Sign In Container -->
            <div id="signInContainer">
                <button class="btn-signin" id="signInBtn" type="button" data-text-th="เข้าสู่ระบบ" data-text-en="Sign In">
                    <i class="fas fa-user me-2"></i>
                    <span class="signin-text">เข้าสู่ระบบ</span>
                </button>
            </div>
            
            <!-- User Dropdown Container (hidden by default) -->
            <div id="userDropdownContainer" class="d-none">
                <div class="dropdown" id="userMenu">
                    <button class="btn-signin dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle me-2"></i>
                        <span id="userName">ผู้ใช้งาน</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li id="adminMenuSection">
                            <a class="dropdown-item" href="#" id="adminDashboardLink" data-text-th="แผงควบคุมผู้ดูแล" data-text-en="Admin Dashboard">
                                <i class="fas fa-tachometer-alt me-2"></i>
                                <span class="menu-text">แผงควบคุมผู้ดูแล</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/Account/Profile" data-text-th="จัดการโปรไฟล์" data-text-en="Manage Profile">
                                <i class="fas fa-user-cog me-2"></i>
                                <span class="menu-text">จัดการโปรไฟล์</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="#" id="signOutBtn" data-text-th="ออกจากระบบ" data-text-en="Sign Out">
                                <i class="fas fa-sign-out-alt me-2"></i>
                                <span class="menu-text">ออกจากระบบ</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
</header>


<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-shield-alt"></i>
            <span data-text-th="ระบบปลอดภัย รับรองโดย KBank" data-text-en="Secure System Certified by KBank">
                ระบบปลอดภัย รับรองโดย KBank
            </span>
        </div>

        <h1 class="hero-title" data-text-th="ลงทะเบียนหักบัญชีอัตโนมัติ" data-text-en="Automatic Direct Debit Registration">
            ลงทะเบียนหักบัญชีอัตโนมัติ
        </h1>

        <p class="hero-subtitle" data-text-th="สะดวก รวดเร็ว และปลอดภัย ด้วยระบบ OTAC จาก KBank สำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ" data-text-en="Convenient, Fast, and Secure with KBank OTAC system for automatic direct debit service registration">
            สะดวก รวดเร็ว และปลอดภัย ด้วยระบบ OTAC จาก KBank สำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ
        </p>

        <div class="hero-features">
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-check"></i>
                </div>
                <span data-text-th="ปลอดภัยด้วยรหัส OTAC แบบใช้ครั้งเดียว" data-text-en="Secure with one-time OTAC code">ปลอดภัยด้วยรหัส OTAC แบบใช้ครั้งเดียว</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <span data-text-th="ใช้เวลาเพียง 3 นาที เสร็จสิ้นการลงทะเบียน" data-text-en="Complete registration in just 3 minutes">ใช้เวลาเพียง 3 นาที เสร็จสิ้นการลงทะเบียน</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <span data-text-th="รองรับทุกอุปกรณ์ ทั้งมือถือและคอมพิวเตอร์" data-text-en="Supports all devices, mobile and desktop">รองรับทุกอุปกรณ์ ทั้งมือถือและคอมพิวเตอร์</span>
            </div>
        </div>

        <div class="hero-actions">
            <a href="#otac-form" class="btn btn-primary" data-text-th="เริ่มลงทะเบียนเลย" data-text-en="Start Registration Now">
                <i class="fas fa-play"></i>
                <span>เริ่มลงทะเบียนเลย</span>
            </a>
            <a href="#how-it-works" class="btn btn-outline" data-text-th="วิธีการใช้งาน" data-text-en="How It Works">
                <i class="fas fa-info-circle"></i>
                <span>วิธีการใช้งาน</span>
            </a>
        </div>

        <div class="trust-indicators">
            <div class="trust-item">
                <i class="fas fa-shield-alt"></i>
                <span data-text-th="ปลอดภัย 100%" data-text-en="100% Secure">ปลอดภัย 100%</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-users"></i>
                <span data-text-th="ผู้ใช้กว่า 10,000+ คน" data-text-en="10,000+ Users">ผู้ใช้กว่า 10,000+ คน</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-star"></i>
                <span data-text-th="ความพึงพอใจ 98.5%" data-text-en="98.5% Satisfaction">ความพึงพอใจ 98.5%</span>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="visual-bg"></div>
        <div class="otac-card" id="otac-form">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3 class="card-title" data-text-th="ยืนยันรหัส OTAC" data-text-en="Verify OTAC Code">ยืนยันรหัส OTAC</h3>
                <p class="card-subtitle" data-text-th="กรอกรหัส OTAC ที่ได้รับจากเจ้าหน้าที่" data-text-en="Enter the OTAC code received from staff">กรอกรหัส OTAC ที่ได้รับจากเจ้าหน้าที่</p>
            </div>

            @using (Html.BeginForm("VerifyOtac", "Home", FormMethod.Post, new { @class = "otac-form", @id = "otacForm" }))
            {
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                <div class="otac-input-group">
                    <label class="input-label" for="OtacCode">รหัส OTAC</label>
                    @Html.TextBoxFor(m => m.OtacCode, new { 
                        @class = "otac-input", 
                        @id = "OtacCode", 
                        @placeholder = "ABC12345", 
                        @maxlength = "8", 
                        @required = "required" 
                    })
                    @Html.ValidationMessageFor(m => m.OtacCode, "", new { @class = "text-danger small mt-1" })
                </div>

                <button type="submit" class="card-action" id="verifyBtn">
                    <span class="btn-text">
                        <i class="fas fa-arrow-right"></i>
                        ยืนยันและดำเนินการต่อ
                    </span>
                    <span class="btn-spinner d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        กำลังตรวจสอบ...
                    </span>
                </button>
            }
        </div>
    </div>
</section>

<!-- Steps Section -->
<section class="steps-section" id="how-it-works">
    <div class="steps-container">
        <div class="section-header">
            <h2 class="section-title">วิธีการใช้งาน</h2>
            <p class="section-subtitle">
                เพียง 3 ขั้นตอนง่ายๆ คุณก็สามารถลงทะเบียนบริการหักบัญชีอัตโนมัติได้แล้ว
            </p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h3 class="step-title">รับรหัส OTAC</h3>
                <p class="step-description">
                    ติดต่อเจ้าหน้าที่หรือผู้ให้บริการเพื่อขอรหัส OTAC สำหรับการลงทะเบียน บริการนี้ใช้ได้เพียงครั้งเดียว
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="step-title">กรอกข้อมูล</h3>
                <p class="step-description">
                    ยืนยันรหัส OTAC และกรอกข้อมูลส่วนตัว หมายเลขบัญชี และรายละเอียดที่จำเป็นสำหรับการลงทะเบียน
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3 class="step-title">ยืนยันผ่าน KBank</h3>
                <p class="step-description">
                    ระบบจะเชื่อมต่อกับ KBank เพื่อยืนยันข้อมูลและเปิดใช้งานบริการหักบัญชีอัตโนมัติให้คุณ
                </p>
            </div>
        </div>
    </div>
</section>

