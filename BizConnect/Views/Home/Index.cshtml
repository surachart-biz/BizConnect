                            </div>
                            <div class="col-4">
                                <div class="bg-light p-2 rounded text-center">
                                    <div class="fw-semibold text-success">Employee</div>
                                    <div class="text-muted">emp123</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light p-2 rounded text-center">
