@model BizConnect.Models.ViewModels.LandingPageViewModel
@{
    ViewData["Title"] = "BizConnect - KBank OTAC Registration";
}

<!-- Site Header with Authentication -->
<header class="site-header bg-white shadow-sm">
    <div class="container">
        <div class="row align-items-center py-3">
            <div class="col-md-6">
                <div class="d-flex align-items-center">
                    <div class="logo me-3">
                        <i class="fas fa-university text-success me-2"></i>
                        <span class="h4 mb-0 fw-bold">BizConnect</span>
                        <span class="badge bg-success ms-2">KBank Partner</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-end">
                <div class="header-actions">
                    <!-- Language Toggle -->
                    <div class="btn-group me-3">
                        <button class="btn btn-outline-secondary btn-sm" id="langTH">TH</button>
                        <button class="btn btn-secondary btn-sm" id="langEN">EN</button>
                    </div>
                    
                    <!-- Sign In Button -->
                    <button class="btn btn-success" id="signInBtn" data-bs-toggle="modal" data-bs-target="#loginModal">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        เข้าสู่ระบบ
                    </button>
                    
                    <!-- User Menu (hidden by default) -->
                    <div class="dropdown d-none" id="userMenu">
                        <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-2"></i>
                            <span id="userName">ผู้ใช้งาน</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="#" id="adminDashboardLink">
                                    <i class="fas fa-tachometer-alt me-2"></i>
                                    Admin Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user-cog me-2"></i>
                                    จัดการโปรไฟล์
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="#" id="signOutBtn">
                                    <i class="fas fa-sign-out-alt me-2"></i>
                                    ออกจากระบบ
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-shield-alt"></i>
            ระบบปลอดภัย รับรองโดย KBank
        </div>

        <h1 class="hero-title">ลงทะเบียนหักบัญชีอัตโนมัติ</h1>

        <p class="hero-subtitle">
            สะดวก รวดเร็ว และปลอดภัย ด้วยระบบ OTAC จาก KBank สำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ
        </p>

        <div class="hero-features">
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-check"></i>
                </div>
                <span>ปลอดภัยด้วยรหัส OTAC แบบใช้ครั้งเดียว</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <span>ใช้เวลาเพียง 3 นาที เสร็จสิ้นการลงทะเบียน</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <span>รองรับทุกอุปกรณ์ ทั้งมือถือและคอมพิวเตอร์</span>
            </div>
        </div>

        <div class="hero-actions">
            <a href="#otac-form" class="btn btn-primary">
                <i class="fas fa-play"></i>
                เริ่มลงทะเบียนเลย
            </a>
            <a href="#how-it-works" class="btn btn-outline">
                <i class="fas fa-info-circle"></i>
                วิธีการใช้งาน
            </a>
        </div>

        <div class="trust-indicators">
            <div class="trust-item">
                <i class="fas fa-shield-alt"></i>
                <span>ปลอดภัย 100%</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-users"></i>
                <span>ผู้ใช้กว่า 10,000+ คน</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-star"></i>
                <span>ความพึงพอใจ 98.5%</span>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="visual-bg"></div>
        <div class="otac-card" id="otac-form">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3 class="card-title">ยืนยันรหัส OTAC</h3>
                <p class="card-subtitle">กรอกรหัส OTAC ที่ได้รับจากเจ้าหน้าที่</p>
            </div>

            @using (Html.BeginForm("VerifyOtac", "Home", FormMethod.Post, new { @class = "otac-form", @id = "otacForm" }))
            {
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                <div class="otac-input-group">
                    <label class="input-label" for="OtacCode">รหัส OTAC</label>
                    @Html.TextBoxFor(m => m.OtacCode, new { 
                        @class = "otac-input", 
                        @id = "OtacCode", 
                        @placeholder = "ABC12345", 
                        @maxlength = "8", 
                        @required = "required" 
                    })
                    @Html.ValidationMessageFor(m => m.OtacCode, "", new { @class = "text-danger small mt-1" })
                </div>

                <button type="submit" class="card-action" id="verifyBtn">
                    <span class="btn-text">
                        <i class="fas fa-arrow-right"></i>
                        ยืนยันและดำเนินการต่อ
                    </span>
                    <span class="btn-spinner d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        กำลังตรวจสอบ...
                    </span>
                </button>
            }
        </div>
    </div>
</section>

<!-- Steps Section -->
<section class="steps-section" id="how-it-works">
    <div class="steps-container">
        <div class="section-header">
            <h2 class="section-title">วิธีการใช้งาน</h2>
            <p class="section-subtitle">
                เพียง 3 ขั้นตอนง่ายๆ คุณก็สามารถลงทะเบียนบริการหักบัญชีอัตโนมัติได้แล้ว
            </p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h3 class="step-title">รับรหัส OTAC</h3>
                <p class="step-description">
                    ติดต่อเจ้าหน้าที่หรือผู้ให้บริการเพื่อขอรหัส OTAC สำหรับการลงทะเบียน บริการนี้ใช้ได้เพียงครั้งเดียว
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="step-title">กรอกข้อมูล</h3>
                <p class="step-description">
                    ยืนยันรหัส OTAC และกรอกข้อมูลส่วนตัว หมายเลขบัญชี และรายละเอียดที่จำเป็นสำหรับการลงทะเบียน
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3 class="step-title">ยืนยันผ่าน KBank</h3>
                <p class="step-description">
                    ระบบจะเชื่อมต่อกับ KBank เพื่อยืนยันข้อมูลและเปิดใช้งานบริการหักบัญชีอัตโนมัติให้คุณ
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Security Section -->
<section class="security-section">
    <div class="security-container">
        <div class="security-content">
            <h2>ความปลอดภัยระดับธนาคาร</h2>

            <div class="security-features">
                <div class="security-feature">
                    <div class="security-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                    <div class="security-text">
                        <h3>เข้ารหัสระดับสูง</h3>
                        <p>ข้อมูลทั้งหมดได้รับการเข้ารหัส SSL/TLS และมาตรฐานความปลอดภัยของธนาคาร</p>
                    </div>
                </div>

                <div class="security-feature">
                    <div class="security-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <div class="security-text">
                        <h3>รหัส OTAC แบบใช้ครั้งเดียว</h3>
                        <p>รหัสมีอายุจำกัดและใช้ได้เพียงครั้งเดียว ป้องกันการใช้งานโดยไม่ได้รับอนุญาต</p>
                    </div>
                </div>

                <div class="security-feature">
                    <div class="security-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="security-text">
                        <h3>ติดตามและตรวจสอบ</h3>
                        <p>ระบบมีการบันทึกและติดตามการใช้งานทุกขั้นตอนเพื่อความปลอดภัย</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="security-visual">
            <div class="otac-card">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="card-title">การรักษาความปลอดภัย</h3>
                    <p class="card-subtitle">มาตรฐานระดับธนาคาร</p>
                </div>

                <div style="padding: 1rem 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <span style="color: var(--text-secondary);">เข้ารหัสข้อมูล</span>
                        <span style="color: var(--success); font-weight: 600;">✓ เปิดใช้งาน</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <span style="color: var(--text-secondary);">ยืนยันตัวตน</span>
                        <span style="color: var(--success); font-weight: 600;">✓ เปิดใช้งาน</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--text-secondary);">การตรวจสอบ</span>
                        <span style="color: var(--success); font-weight: 600;">✓ เปิดใช้งาน</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="fas fa-shield-alt text-success me-2"></i>
                    เข้าสู่ระบบเจ้าหน้าที่
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="alert alert-info border-0 bg-light">
                    <i class="fas fa-info-circle me-2"></i>
                    <small>สำหรับเจ้าหน้าที่และผู้ดูแลระบบเท่านั้น</small>
                </div>
                
                <form id="loginForm">
                    <div class="mb-3">
                        <label for="username" class="form-label">ชื่อผู้ใช้งาน</label>
                        <input type="text" class="form-control" id="username" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="password" class="form-label">รหัสผ่าน</label>
                        <input type="password" class="form-control" id="password" required>
                    </div>
                    
                    <button type="submit" class="btn btn-success w-100" id="loginSubmitBtn">
                        <span class="login-text">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            เข้าสู่ระบบ
                        </span>
                        <span class="login-spinner d-none">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            กำลังตรวจสอบ...
                        </span>
                    </button>
                </form>
                
                <div class="mt-3 text-center">
                    <small class="text-muted">
                        Demo: admin/admin123, employee/emp123, test/test123
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Notification Container -->
<div id="notificationContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
}