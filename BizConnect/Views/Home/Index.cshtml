@{
    ViewData["Title"] = "BizConnect - KBank ODD Registration";
}

@section Styles {
    <style>
        .kbank-hero {
            background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
            color: white;
            padding: 100px 0;
            position: relative;
            overflow: hidden;
        }
        .kbank-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="%23ffffff" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>') repeat;
            opacity: 0.5;
        }
        .process-step {
            text-align: center;
            padding: 2rem;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
            position: relative;
            transition: all 0.3s ease;
        }
        .process-step:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .step-number {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #0066CC, #004499);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.5rem;
            font-weight: bold;
        }
        .step-icon {
            font-size: 3rem;
            color: #0066CC;
            margin-bottom: 1rem;
        }
        .lang-toggle {
            position: fixed;
            top: 50%;
            right: 20px;
            transform: translateY(-50%);
            z-index: 1050;
            background: white;
            border-radius: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            padding: 5px;
        }
        .lang-btn {
            border: none;
            background: transparent;
            padding: 8px 15px;
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        .lang-btn.active {
            background: #0066CC;
            color: white;
        }
        .faq-item {
            margin-bottom: 1rem;
        }
        .faq-button {
            background: white;
            border: 1px solid #e0e0e0;
            padding: 1.25rem;
            text-align: left;
            width: 100%;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .faq-button:hover, .faq-button:not(.collapsed) {
            background: #f8f9fa;
            border-color: #0066CC;
        }
        .trust-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(255,255,255,0.2);
            padding: 0.5rem 1rem;
            border-radius: 25px;
            margin: 0.25rem;
            backdrop-filter: blur(10px);
        }
    </style>
}

<!-- Language Toggle -->
<div class="lang-toggle">
    <button class="lang-btn active" data-lang="en">
        <i class="fas fa-globe me-1"></i> EN
    </button>
    <button class="lang-btn" data-lang="th">
        <i class="fas fa-globe me-1"></i> TH
    </button>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Authenticated User - KBank ODD Dashboard -->
    <div class="kbank-dashboard">
        <!-- Quick Access Hero -->
        <section class="kbank-hero">
            <div class="container position-relative">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="hero-content">
                            <div class="trust-badge mb-3">
                                <i class="fas fa-university text-warning me-2"></i>
                                <span data-en="Official KBank Partner" data-th="พันธมิตรทางการของ KBank">Official KBank Partner</span>
                            </div>
                            <h1 class="display-4 fw-bold mb-3">
                                <span data-en="Welcome back," data-th="ยินดีต้อนรับกลับ,">Welcome back,</span> @User.Identity.Name
                            </h1>
                            <p class="lead mb-4">
                                <span data-en="Manage your KBank ODD registrations and monitor your daily operations efficiently." data-th="จัดการการลงทะเบียน KBank ODD และติดตามการดำเนินงานประจำวันอย่างมีประสิทธิภาพ">Manage your KBank ODD registrations and monitor your daily operations efficiently.</span>
                            </p>
                            <div class="hero-actions">
                                <a asp-controller="KBank" asp-action="Register" class="btn btn-light btn-lg me-3">
                                    <i class="fas fa-plus me-2"></i>
                                    <span data-en="New Registration" data-th="ลงทะเบียนใหม่">New Registration</span>
                                </a>
                                <a asp-controller="KBank" asp-action="Start" class="btn btn-outline-light btn-lg">
                                    <i class="fas fa-list me-2"></i>
                                    <span data-en="View All" data-th="ดูทั้งหมด">View All</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="hero-stats">
                            <div class="stat-item mb-3">
                                <div class="h2 fw-bold">24</div>
                                <div data-en="Pending Today" data-th="รอดำเนินการวันนี้">Pending Today</div>
                            </div>
                            <div class="stat-item">
                                <div class="h2 fw-bold text-warning">156</div>
                                <div data-en="Completed This Month" data-th="เสร็จสิ้นเดือนนี้">Completed This Month</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (User.IsInRole("Admin"))
        {
            <!-- Admin Quick Access -->
            <section class="py-4 bg-light">
                <div class="container">
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="fas fa-shield-alt me-3"></i>
                        <div class="flex-grow-1">
                            <h5 class="mb-1" data-en="Administrator Access" data-th="การเข้าถึงของผู้ดูแลระบบ">Administrator Access</h5>
                            <p class="mb-0" data-en="Manage ODD registrations, generate OTAC codes, and monitor system activity" data-th="จัดการการลงทะเบียน ODD, สร้างรหัส OTAC และติดตามกิจกรรมของระบบ">Manage ODD registrations, generate OTAC codes, and monitor system activity</p>
                        </div>
                        <a asp-controller="Home" asp-action="Dashboard" asp-area="Admin" class="btn btn-primary">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            <span data-en="Admin Dashboard" data-th="แดชบอร์ดผู้ดูแล">Admin Dashboard</span>
                        </a>
                    </div>
                </div>
            </section>
        }
    </div>
}
else
{
    <!-- Non-Authenticated User Landing Page -->
    <div class="kbank-landing">
        <!-- Hero Section -->
        <section class="kbank-hero">
            <div class="container position-relative">
                <div class="row align-items-center min-vh-75">
                    <div class="col-lg-6">
                        <div class="hero-content">
                            <!-- Trust indicators -->
                            <div class="trust-badges mb-4">
                                <span class="trust-badge">
                                    <i class="fas fa-shield-check text-success me-2"></i>
                                    <span data-en="Bank-Grade Security" data-th="ความปลอดภัยระดับธนาคาร">Bank-Grade Security</span>
                                </span>
                                <span class="trust-badge">
                                    <i class="fas fa-university text-warning me-2"></i>
                                    <span data-en="KBank Official Partner" data-th="พันธมิตรทางการของ KBank">KBank Official Partner</span>
                                </span>
                                <span class="trust-badge">
                                    <i class="fas fa-clock text-info me-2"></i>
                                    <span data-en="24/7 Available" data-th="ใช้ได้ 24/7">24/7 Available</span>
                                </span>
                            </div>

                            <h1 class="display-3 fw-bold mb-4">
                                <span data-en="KBank ODD Registration" data-th="การลงทะเบียน KBank ODD">KBank ODD Registration</span>
                                <div class="text-warning" data-en="Made Simple" data-th="ง่ายดาย">Made Simple</div>
                            </h1>
                            
                            <p class="lead mb-4">
                                <span data-en="Streamline your KBank Omnibus Deposit Data registration process with our secure, user-friendly platform designed for financial institutions." data-th="ปรับปรุงกระบวนการลงทะเบียน KBank Omnibus Deposit Data ด้วยแพลตฟอร์มที่ปลอดภัยและเป็นมิตรกับผู้ใช้ที่ออกแบบมาสำหรับสถาบันการเงิน">Streamline your KBank Omnibus Deposit Data registration process with our secure, user-friendly platform designed for financial institutions.</span>
                            </p>

                            <!-- Key benefits -->
                            <div class="hero-benefits mb-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Automated OTAC code generation" data-th="การสร้างรหัส OTAC อัตโนมัติ">Automated OTAC code generation</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Real-time registration tracking" data-th="การติดตามการลงทะเบียนแบบเรียลไทม์">Real-time registration tracking</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Secure data handling & encryption" data-th="การจัดการข้อมูลที่ปลอดภัยและการเข้ารหัส">Secure data handling & encryption</span>
                                </div>
                            </div>

                            <div class="hero-actions">
                                <a asp-action="Verify" class="btn btn-warning btn-lg me-3 shadow">
                                    <i class="fas fa-user-plus me-2"></i>
                                    <span data-en="สมัครบริการหักบัญชีอัตโนมัติ" data-th="สมัครบริการหักบัญชีอัตโนมัติ">สมัครบริการหักบัญชีอัตโนมัติ</span>
                                </a>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    <span data-en="เข้าสู่ระบบ (เจ้าหน้าที่)" data-th="เข้าสู่ระบบ (เจ้าหน้าที่)">เข้าสู่ระบบ (เจ้าหน้าที่)</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-visual text-center">
                            <div class="banking-graphic position-relative">
                                <div class="shield-container">
                                    <i class="fas fa-university" style="font-size: 8rem; color: rgba(255,255,255,0.9);"></i>
                                    <div class="security-indicators position-absolute">
                                        <div class="indicator indicator-1"><i class="fas fa-lock"></i></div>
                                        <div class="indicator indicator-2"><i class="fas fa-shield-alt"></i></div>
                                        <div class="indicator indicator-3"><i class="fas fa-key"></i></div>
                                        <div class="indicator indicator-4"><i class="fas fa-check-circle"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4-Step Process Section -->
        <section id="how-it-works" class="py-5 bg-light">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="display-5 fw-bold text-primary mb-3">
                            <span data-en="How KBank ODD Registration Works" data-th="วิธีการทำงานของการลงทะเบียน KBank ODD">How KBank ODD Registration Works</span>
                        </h2>
                        <p class="lead text-muted">
                            <span data-en="Simple 4-step process to complete your registration" data-th="กระบวนการ 4 ขั้นตอนง่ายๆ เพื่อลงทะเบียนให้เสร็จสมบูรณ์">Simple 4-step process to complete your registration</span>
                        </p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Step 1 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="process-step">
                            <div class="step-number">1</div>
                            <div class="step-icon">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <h4 class="fw-bold mb-3" data-en="Registration" data-th="การลงทะเบียน">Registration</h4>
                            <p class="text-muted" data-en="Fill out the secure registration form with your business and contact details" data-th="กรอกแบบฟอร์มลงทะเบียนที่ปลอดภัยด้วยรายละเอียดธุรกิจและการติดต่อของคุณ">Fill out the secure registration form with your business and contact details</p>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="process-step">
                            <div class="step-number">2</div>
                            <div class="step-icon">
                                <i class="fas fa-key"></i>
                            </div>
                            <h4 class="fw-bold mb-3" data-en="OTAC Generation" data-th="การสร้าง OTAC">OTAC Generation</h4>
                            <p class="text-muted" data-en="System automatically generates your unique One-Time Authorization Code" data-th="ระบบสร้างรหัสอนุญาตครั้งเดียวที่ไม่ซ้ำกันของคุณโดยอัตโนมัติ">System automatically generates your unique One-Time Authorization Code</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="process-step">
                            <div class="step-number">3</div>
                            <div class="step-icon">
                                <i class="fas fa-clipboard-check"></i>
                            </div>
                            <h4 class="fw-bold mb-3" data-en="Validation" data-th="การตรวจสอบ">Validation</h4>
                            <p class="text-muted" data-en="Enter your OTAC code to validate and confirm your registration details" data-th="ป้อนรหัส OTAC ของคุณเพื่อตรวจสอบและยืนยันรายละเอียดการลงทะเบียนของคุณ">Enter your OTAC code to validate and confirm your registration details</p>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="process-step">
                            <div class="step-number">4</div>
                            <div class="step-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <h4 class="fw-bold mb-3" data-en="Completion" data-th="การเสร็จสิ้น">Completion</h4>
                            <p class="text-muted" data-en="Receive confirmation and access to your KBank ODD registration dashboard" data-th="รับการยืนยันและการเข้าถึงแดชบอร์ดการลงทะเบียน KBank ODD ของคุณ">Receive confirmation and access to your KBank ODD registration dashboard</p>
                        </div>
                    </div>
                </div>

                <div class="row mt-5">
                    <div class="col-12 text-center">
                        <a asp-action="Verify" class="btn btn-primary btn-lg">
                            <i class="fas fa-arrow-right me-2"></i>
                            <span data-en="Begin Registration Process" data-th="เริ่มกระบวนการลงทะเบียน">Begin Registration Process</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-5">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="display-5 fw-bold text-primary mb-3">
                            <span data-en="Frequently Asked Questions" data-th="คำถามที่พบบ่อย">Frequently Asked Questions</span>
                        </h2>
                        <p class="lead text-muted">
                            <span data-en="Common questions about KBank ODD registration" data-th="คำถามทั่วไปเกี่ยวกับการลงทะเบียน KBank ODD">Common questions about KBank ODD registration</span>
                        </p>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="accordion" id="faqAccordion">
                            <!-- FAQ 1 -->
                            <div class="faq-item">
                                <button class="faq-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <span data-en="What is KBank ODD Registration?" data-th="การลงทะเบียน KBank ODD คืออะไร?">What is KBank ODD Registration?</span>
                                        </h5>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </button>
                                <div id="faq1" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="p-4 bg-light">
                                        <p data-en="KBank ODD (Omnibus Deposit Data) Registration is a secure process that allows financial institutions to register and manage deposit data with KBank's systems. This ensures compliance with banking regulations and secure data handling." data-th="การลงทะเบียน KBank ODD (Omnibus Deposit Data) เป็นกระบวนการที่ปลอดภัยที่ช่วยให้สถาบันการเงินสามารถลงทะเบียนและจัดการข้อมูลเงินฝากกับระบบของ KBank ได้ สิ่งนี้ช่วยให้มั่นใจในการปฏิบัติตามกฎระเบียบของธนาคารและการจัดการข้อมูลที่ปลอดภัย">KBank ODD (Omnibus Deposit Data) Registration is a secure process that allows financial institutions to register and manage deposit data with KBank's systems. This ensures compliance with banking regulations and secure data handling.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 2 -->
                            <div class="faq-item">
                                <button class="faq-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <span data-en="How secure is my data?" data-th="ข้อมูลของฉันปลอดภัยแค่ไหน?">How secure is my data?</span>
                                        </h5>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </button>
                                <div id="faq2" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="p-4 bg-light">
                                        <p data-en="We use bank-grade security with end-to-end encryption, secure HTTPS connections, and comply with all financial industry standards. Your data is protected with the same level of security used by major banking institutions." data-th="เราใช้ความปลอดภัยระดับธนาคารพร้อมการเข้ารหัสแบบ end-to-end การเชื่อมต่อ HTTPS ที่ปลอดภัย และปฏิบัติตามมาตรฐานอุตสาหกรรมการเงินทั้งหมด ข้อมูลของคุณได้รับการปกป้องด้วยระดับความปลอดภัยเดียวกับที่ใช้โดยสถาบันการธนาคารขนาดใหญ่">We use bank-grade security with end-to-end encryption, secure HTTPS connections, and comply with all financial industry standards. Your data is protected with the same level of security used by major banking institutions.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 3 -->
                            <div class="faq-item">
                                <button class="faq-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <span data-en="What is an OTAC code?" data-th="รหัส OTAC คืออะไร?">What is an OTAC code?</span>
                                        </h5>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </button>
                                <div id="faq3" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="p-4 bg-light">
                                        <p data-en="OTAC (One-Time Authorization Code) is a unique, time-limited code generated for each registration. It provides an additional layer of security and ensures that only authorized users can complete the registration process." data-th="OTAC (One-Time Authorization Code) เป็นรหัสเฉพาะที่มีเวลาจำกัดที่สร้างขึ้นสำหรับการลงทะเบียนแต่ละครั้ง ให้ความปลอดภัยเพิ่มเติมและรับประกันว่ามีเพียงผู้ใช้ที่ได้รับอนุญาตเท่านั้นที่สามารถดำเนินการลงทะเบียนให้เสร็จสิ้นได้">OTAC (One-Time Authorization Code) is a unique, time-limited code generated for each registration. It provides an additional layer of security and ensures that only authorized users can complete the registration process.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 4 -->
                            <div class="faq-item">
                                <button class="faq-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <span data-en="How long does the registration process take?" data-th="กระบวนการลงทะเบียนใช้เวลานานแค่ไหน?">How long does the registration process take?</span>
                                        </h5>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </button>
                                <div id="faq4" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="p-4 bg-light">
