@model BizConnect.Models.ViewModels.LandingPageViewModel
@{
    ViewData["Title"] = "BizConnect - KBank OTAC Registration";
}

<div class="landing-wrapper">

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-shield-alt"></i>
            <span data-text-th="ระบบปลอดภัย รับรองโดย KBank" data-text-en="Secure System Certified by KBank">
                ระบบปลอดภัย รับรองโดย KBank
            </span>
        </div>

        <h1 class="hero-title" data-text-th="ลงทะเบียนหักบัญชีอัตโนมัติ" data-text-en="Automatic Direct Debit Registration">
            ลงทะเบียนหักบัญชีอัตโนมัติ
        </h1>

        <p class="hero-subtitle" data-text-th="สะดวก รวดเร็ว และปลอดภัย ด้วยระบบ OTAC จาก KBank สำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ" data-text-en="Convenient, Fast, and Secure with KBank OTAC system for automatic direct debit service registration">
            สะดวก รวดเร็ว และปลอดภัย ด้วยระบบ OTAC จาก KBank สำหรับการลงทะเบียนบริการหักบัญชีอัตโนมัติ
        </p>

        <div class="hero-features">
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-check"></i>
                </div>
                <span data-text-th="ปลอดภัยด้วยรหัส OTAC แบบใช้ครั้งเดียว" data-text-en="Secure with one-time OTAC code">ปลอดภัยด้วยรหัส OTAC แบบใช้ครั้งเดียว</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <span data-text-th="ใช้เวลาเพียง 3 นาที เสร็จสิ้นการลงทะเบียน" data-text-en="Complete registration in just 3 minutes">ใช้เวลาเพียง 3 นาที เสร็จสิ้นการลงทะเบียน</span>
            </div>

            <div class="feature-item">
                <div class="feature-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <span data-text-th="รองรับทุกอุปกรณ์ ทั้งมือถือและคอมพิวเตอร์" data-text-en="Supports all devices, mobile and desktop">รองรับทุกอุปกรณ์ ทั้งมือถือและคอมพิวเตอร์</span>
            </div>
        </div>

        <div class="hero-actions">
            <a href="#otac-form" class="btn btn-primary" data-text-th="เริ่มลงทะเบียนเลย" data-text-en="Start Registration Now">
                <i class="fas fa-play"></i>
                <span>เริ่มลงทะเบียนเลย</span>
            </a>
            <a href="#how-it-works" class="btn btn-outline" data-text-th="วิธีการใช้งาน" data-text-en="How It Works">
                <i class="fas fa-info-circle"></i>
                <span>วิธีการใช้งาน</span>
            </a>
        </div>

        <div class="trust-indicators">
            <div class="trust-item">
                <i class="fas fa-shield-alt"></i>
                <span data-text-th="ปลอดภัย 100%" data-text-en="100% Secure">ปลอดภัย 100%</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-users"></i>
                <span data-text-th="ผู้ใช้กว่า 10,000+ คน" data-text-en="10,000+ Users">ผู้ใช้กว่า 10,000+ คน</span>
            </div>
            <div class="trust-item">
                <i class="fas fa-star"></i>
                <span data-text-th="ความพึงพอใจ 98.5%" data-text-en="98.5% Satisfaction">ความพึงพอใจ 98.5%</span>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="visual-bg"></div>
        <div class="otac-card" id="otac-form">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h3 class="card-title" data-text-th="ยืนยันรหัส OTAC" data-text-en="Verify OTAC Code">ยืนยันรหัส OTAC</h3>
                <p class="card-subtitle" data-text-th="กรอกรหัส OTAC ที่ได้รับจากเจ้าหน้าที่" data-text-en="Enter the OTAC code received from staff">กรอกรหัส OTAC ที่ได้รับจากเจ้าหน้าที่</p>
            </div>

            @using (Html.BeginForm("Verify", "Home", FormMethod.Post, new { @class = "otac-form", @id = "otacForm" }))
            {
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                <div class="otac-input-group">
                    <label class="input-label" for="OtacCode" 
                           data-text-th="รหัส OTAC" 
                           data-text-en="OTAC Code">รหัส OTAC</label>
                    @Html.TextBoxFor(m => m.OtacCode, new { 
                        @class = "otac-input", 
                        @id = "OtacCode", 
                        placeholder = "ABC12345",
                        @data_placeholder_th = "ABC12345",
                        @data_placeholder_en = "ABC12345", 
                        @maxlength = "8", 
                        @required = "required" 
                    })
                    @Html.ValidationMessageFor(m => m.OtacCode, "", new { @class = "text-danger small mt-1" })
                </div>

                <button type="submit" class="card-action" id="verifyBtn">
                    <span class="btn-text">
                        <i class="fas fa-arrow-right"></i>
                        <span data-text-th="ยืนยันและดำเนินการต่อ" data-text-en="Verify and Continue">ยืนยันและดำเนินการต่อ</span>
                    </span>
                    <span class="btn-spinner d-none">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span data-text-th="กำลังตรวจสอบ..." data-text-en="Verifying...">กำลังตรวจสอบ...</span>
                    </span>
                </button>
            }
        </div>
    </div>
</section>

<!-- Steps Section -->
<section class="steps-section" id="how-it-works">
    <div class="steps-container">
        <div class="section-header">
            <h2 class="section-title" data-text-th="วิธีการใช้งาน" data-text-en="How It Works">วิธีการใช้งาน</h2>
            <p class="section-subtitle" 
               data-text-th="เพียง 3 ขั้นตอนง่ายๆ คุณก็สามารถลงทะเบียนบริการหักบัญชีอัตโนมัติได้แล้ว"
               data-text-en="Just 3 simple steps to register for automatic direct debit service">
                เพียง 3 ขั้นตอนง่ายๆ คุณก็สามารถลงทะเบียนบริการหักบัญชีอัตโนมัติได้แล้ว
            </p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h3 class="step-title" data-text-th="รับรหัส OTAC" data-text-en="Get OTAC Code">รับรหัส OTAC</h3>
                <p class="step-description"
                   data-text-th="ติดต่อเจ้าหน้าที่หรือผู้ให้บริการเพื่อขอรหัส OTAC สำหรับการลงทะเบียน บริการนี้ใช้ได้เพียงครั้งเดียว"
                   data-text-en="Contact staff or service provider to obtain OTAC code for registration. This code is for one-time use only">
                    ติดต่อเจ้าหน้าที่หรือผู้ให้บริการเพื่อขอรหัส OTAC สำหรับการลงทะเบียน บริการนี้ใช้ได้เพียงครั้งเดียว
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="step-title" data-text-th="กรอกข้อมูล" data-text-en="Fill Information">กรอกข้อมูล</h3>
                <p class="step-description"
                   data-text-th="ยืนยันรหัส OTAC และกรอกข้อมูลส่วนตัว หมายเลขบัญชี และรายละเอียดที่จำเป็นสำหรับการลงทะเบียน"
                   data-text-en="Verify OTAC code and fill in personal information, account number, and required details for registration">
                    ยืนยันรหัส OTAC และกรอกข้อมูลส่วนตัว หมายเลขบัญชี และรายละเอียดที่จำเป็นสำหรับการลงทะเบียน
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3 class="step-title" data-text-th="ยืนยันผ่าน KBank" data-text-en="Confirm via KBank">ยืนยันผ่าน KBank</h3>
                <p class="step-description"
                   data-text-th="ระบบจะเชื่อมต่อกับ KBank เพื่อยืนยันข้อมูลและเปิดใช้งานบริการหักบัญชีอัตโนมัติให้คุณ"
                   data-text-en="System will connect to KBank to verify information and activate automatic direct debit service for you">
                    ระบบจะเชื่อมต่อกับ KBank เพื่อยืนยันข้อมูลและเปิดใช้งานบริการหักบัญชีอัตโนมัติให้คุณ
                </p>
            </div>
        </div>
    </div>
</section>

