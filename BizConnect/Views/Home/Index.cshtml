@{
    ViewData["Title"] = "BizConnect - Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Authenticated User Dashboard -->
    <div class="bc-dashboard">
        <!-- Welcome Hero Section -->
        <section class="bc-hero-dashboard position-relative overflow-hidden">
            <!-- Animated Background Elements -->
            <div class="bc-hero-bg-elements">
                <div class="bc-floating-shape bc-shape-1"></div>
                <div class="bc-floating-shape bc-shape-2"></div>
                <div class="bc-floating-shape bc-shape-3"></div>
            </div>

            <div class="container position-relative">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="bc-welcome-content bc-fade-in">
                            <!-- Time-based greeting -->
                            <div class="bc-greeting-badge mb-3">
                                <i class="fas fa-sun text-warning me-2"></i>
                                <span id="greeting-text">Good morning</span>
                            </div>

                            <h1 class="bc-hero-title bc-slide-in-left">
                                Welcome back, <span class="text-primary bc-text-glow position-relative">
                                    @User.Identity.Name
                                    <div class="bc-sparkle-effect"></div>
                                </span>!
                            </h1>
                            <p class="bc-hero-subtitle bc-slide-in-up mb-4">
                                Ready to expand your professional network and discover new opportunities?
                            </p>

                            <!-- Progress indicator -->
                            <div class="bc-profile-progress mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="bc-progress-label">Profile Completion</span>
                                    <span class="bc-progress-percentage">85%</span>
                                </div>
                                <div class="bc-progress-bar">
                                    <div class="bc-progress-fill" style="width: 85%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="bc-hero-stats">
                            <!-- Interactive Connections Stat -->
                            <div class="bc-stat-item bc-stat-animate bc-stat-interactive" style="animation-delay: 0.2s;" data-tooltip="Click to view your network">
                                <div class="bc-stat-icon bc-icon-interactive">
                                    <i class="fas fa-users"></i>
                                    <div class="bc-pulse-ring"></div>
                                </div>
                                <div class="bc-stat-number" data-count="24">0</div>
                                <div class="bc-stat-label">Connections</div>
                                <div class="bc-stat-trend">
                                    <i class="fas fa-arrow-up text-success"></i>
                                    <span>+3 this week</span>
                                </div>
                                <!-- Mini connection preview -->
                                <div class="bc-connection-preview">
                                    <div class="bc-avatar-stack">
                                        <div class="bc-avatar bc-avatar-1"></div>
                                        <div class="bc-avatar bc-avatar-2"></div>
                                        <div class="bc-avatar bc-avatar-3"></div>
                                        <div class="bc-avatar-more">+21</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Interactive Opportunities Stat -->
                            <div class="bc-stat-item bc-stat-animate bc-stat-interactive" style="animation-delay: 0.4s;" data-tooltip="Click to explore opportunities">
                                <div class="bc-stat-icon bc-icon-interactive">
                                    <i class="fas fa-briefcase"></i>
                                    <div class="bc-pulse-ring"></div>
                                </div>
                                <div class="bc-stat-number" data-count="8">0</div>
                                <div class="bc-stat-label">Opportunities</div>
                                <div class="bc-stat-trend">
                                    <i class="fas fa-arrow-up text-success"></i>
                                    <span>+2 new</span>
                                </div>
                                <!-- Opportunity type indicators -->
                                <div class="bc-opportunity-types">
                                    <span class="bc-type-badge bc-type-remote">Remote</span>
                                    <span class="bc-type-badge bc-type-fulltime">Full-time</span>
                                    <span class="bc-type-badge bc-type-contract">Contract</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Actions -->
        <section class="bc-quick-actions py-5">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="bc-section-title position-relative">
                            Quick Actions
                            <div class="bc-title-underline"></div>
                        </h2>
                        <p class="bc-section-subtitle">Everything you need to grow your professional network</p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="bc-action-card hover-lift bc-tilt bc-ripple bc-slide-in-up position-relative bc-interactive-card" style="animation-delay: 0.1s;" data-action="connections">
                            <div class="bc-action-badge bc-badge-animated">Popular</div>

                            <!-- Interactive background pattern -->
                            <div class="bc-card-pattern">
                                <div class="bc-pattern-circle bc-circle-1"></div>
                                <div class="bc-pattern-circle bc-circle-2"></div>
                                <div class="bc-pattern-circle bc-circle-3"></div>
                            </div>

                            <div class="bc-action-icon bg-primary bc-glow bc-icon-hover">
                                <i class="fas fa-users bc-rotate-sm"></i>
                                <!-- Orbiting dots -->
                                <div class="bc-orbit-container">
                                    <div class="bc-orbit-dot bc-dot-1"></div>
                                    <div class="bc-orbit-dot bc-dot-2"></div>
                                    <div class="bc-orbit-dot bc-dot-3"></div>
                                </div>
                            </div>

                            <h3 class="bc-action-title">Find Connections</h3>
                            <p class="bc-action-description">Discover and connect with professionals in your industry</p>

                            <div class="bc-action-stats">
                                <span class="bc-stat-badge bc-stat-counter-badge">
                                    <i class="fas fa-eye me-1"></i>
                                    <span class="bc-counter" data-target="12">0</span> new matches
                                </span>
                            </div>

                            <!-- Interactive progress bar -->
                            <div class="bc-match-progress">
                                <div class="bc-progress-label">Profile Match Score</div>
                                <div class="bc-progress-bar-interactive">
                                    <div class="bc-progress-fill-animated" data-progress="85"></div>
                                    <span class="bc-progress-text">85%</span>
                                </div>
                            </div>

                            <a href="#" class="bc-action-link bc-color-transition bc-link-interactive" onclick="return false;">
                                <span>Explore Network</span>
                                <i class="fas fa-arrow-right ms-2 bc-arrow-slide"></i>
                            </a>

                            <!-- Hover reveal content -->
                            <div class="bc-hover-reveal">
                                <div class="bc-quick-stats">
                                    <div class="bc-quick-stat">
                                        <i class="fas fa-user-tie"></i>
                                        <span>5 Executives</span>
                                    </div>
                                    <div class="bc-quick-stat">
                                        <i class="fas fa-code"></i>
                                        <span>7 Developers</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="bc-action-card hover-lift bc-tilt bc-ripple bc-slide-in-up position-relative" style="animation-delay: 0.2s;">
                            <div class="bc-action-badge bg-success">Hot</div>
                            <div class="bc-action-icon bg-success bc-glow">
                                <i class="fas fa-briefcase bc-rotate-sm"></i>
                            </div>
                            <h3 class="bc-action-title">Job Opportunities</h3>
                            <p class="bc-action-description">Browse and apply to exciting career opportunities</p>
                            <div class="bc-action-stats">
                                <span class="bc-stat-badge">
                                    <i class="fas fa-fire me-1"></i>5 new jobs
                                </span>
                            </div>
                            <a href="#" class="bc-action-link bc-color-transition" onclick="return false;">
                                <span>View Jobs</span>
                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="bc-action-card hover-lift bc-tilt bc-ripple bc-slide-in-up position-relative" style="animation-delay: 0.3s;">
                            <div class="bc-action-icon bg-info bc-glow">
                                <i class="fas fa-calendar-alt bc-rotate-sm"></i>
                            </div>
                            <h3 class="bc-action-title">Events</h3>
                            <p class="bc-action-description">Join networking events and professional meetups</p>
                            <div class="bc-action-stats">
                                <span class="bc-stat-badge">
                                    <i class="fas fa-calendar me-1"></i>3 this week
                                </span>
                            </div>
                            <a href="#" class="bc-action-link bc-color-transition" onclick="return false;">
                                <span>Find Events</span>
                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="bc-action-card hover-lift bc-tilt bc-ripple bc-slide-in-up position-relative" style="animation-delay: 0.4s;">
                            <div class="bc-action-icon bg-warning bc-glow">
                                <i class="fas fa-user-edit bc-rotate-sm"></i>
                            </div>
                            <h3 class="bc-action-title">Update Profile</h3>
                            <p class="bc-action-description">Keep your professional profile up to date</p>
                            <div class="bc-action-stats">
                                <span class="bc-stat-badge">
                                    <i class="fas fa-percentage me-1"></i>85% complete
                                </span>
                            </div>
                            <a href="#" class="bc-action-link bc-color-transition" onclick="return false;">
                                <span>Edit Profile</span>
                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (User.IsInRole("Admin"))
        {
            <!-- Admin Quick Access -->
            <section class="bc-admin-section">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="bc-admin-card">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <div class="bc-admin-icon">
                                            <i class="fas fa-shield-alt"></i>
                                        </div>
                                        <div>
                                            <h3 class="bc-admin-title">Administrator Access</h3>
                                            <p class="bc-admin-description">Manage users, monitor system activity, and configure settings</p>
                                        </div>
                                    </div>
                                    <div>
                                        <a asp-controller="Home" asp-action="Dashboard" asp-area="Admin" class="btn btn-primary">
                                            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }

        <!-- Recent Activity -->
        <section class="bc-recent-activity py-5 bg-light">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="bc-section-title position-relative">
                            Recent Activity
                            <div class="bc-title-underline"></div>
                        </h2>
                        <p class="bc-section-subtitle">Stay updated with your latest interactions and opportunities</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-8">
                        <div class="bc-activity-feed bc-interactive-timeline">
                            <!-- Interactive Activity Item 1 -->
                            <div class="bc-activity-item bc-slide-in-left bc-activity-interactive" style="animation-delay: 0.1s;" data-activity="connection">
                                <div class="bc-activity-timeline bc-timeline-animated"></div>
                                <div class="bc-activity-icon bg-success bc-pulse bc-icon-expandable">
                                    <i class="fas fa-user-plus"></i>
                                    <div class="bc-icon-ripple"></div>
                                </div>
                                <div class="bc-activity-content">
                                    <div class="bc-activity-header">
                                        <div class="bc-activity-main">
                                            <p class="bc-activity-text">You connected with <strong class="bc-name-highlight">Sarah Johnson</strong></p>
                                            <!-- Profile preview on hover -->
                                            <div class="bc-profile-preview">
                                                <div class="bc-profile-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div class="bc-profile-info">
                                                    <div class="bc-profile-name">Sarah Johnson</div>
                                                    <div class="bc-profile-title">Product Manager at TechCorp</div>
                                                    <div class="bc-profile-mutual">3 mutual connections</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="bc-activity-actions">
                                            <button class="btn btn-sm btn-outline-primary bc-btn-interactive">
                                                <i class="fas fa-comment me-1"></i>Message
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary bc-btn-more" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-h"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>View Profile</a></li>
                                                <li><a class="dropdown-item" href="#"><i class="fas fa-share me-2"></i>Share</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <span class="bc-activity-time bc-time-interactive">
                                        <i class="fas fa-clock me-1"></i>
                                        <span class="bc-relative-time" data-timestamp="2">2 hours ago</span>
                                    </span>
                                    <!-- Expandable details -->
                                    <div class="bc-activity-details">
                                        <div class="bc-connection-context">
                                            <i class="fas fa-info-circle me-1"></i>
                                            Connected through mutual connection: <strong>Mike Chen</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="bc-activity-item bc-slide-in-left" style="animation-delay: 0.2s;">
                                <div class="bc-activity-timeline"></div>
                                <div class="bc-activity-icon bg-info bc-pulse">
                                    <i class="fas fa-briefcase"></i>
                                </div>
                                <div class="bc-activity-content">
                                    <div class="bc-activity-header">
                                        <p class="bc-activity-text">New job opportunity: <strong>Senior Developer</strong></p>
                                        <div class="bc-activity-actions">
                                            <button class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-eye me-1"></i>View
                                            </button>
                                        </div>
                                    </div>
                                    <span class="bc-activity-time">
                                        <i class="fas fa-clock me-1"></i>1 day ago
                                    </span>
                                </div>
                            </div>
                            <div class="bc-activity-item bc-slide-in-left" style="animation-delay: 0.3s;">
                                <div class="bc-activity-timeline"></div>
                                <div class="bc-activity-icon bg-warning bc-pulse">
                                    <i class="fas fa-calendar"></i>
                                </div>
                                <div class="bc-activity-content">
                                    <div class="bc-activity-header">
                                        <p class="bc-activity-text">Upcoming event: <strong>Tech Networking Meetup</strong></p>
                                        <div class="bc-activity-actions">
                                            <button class="btn btn-sm btn-outline-warning">
                                                <i class="fas fa-calendar-plus me-1"></i>RSVP
                                            </button>
                                        </div>
                                    </div>
                                    <span class="bc-activity-time">
                                        <i class="fas fa-clock me-1"></i>3 days ago
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- View All Activity Button -->
                        <div class="text-center mt-4">
                            <button class="btn btn-outline-primary bc-gradient-border">
                                <i class="fas fa-history me-2"></i>View All Activity
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="bc-suggestions-card bc-slide-in-right">
                            <div class="bc-suggestions-header">
                                <h3 class="bc-suggestions-title">
                                    <i class="fas fa-users me-2 text-primary"></i>
                                    Suggested Connections
                                </h3>
                                <span class="bc-suggestions-count">2 new</span>
                            </div>

                            <div class="bc-suggestion-item hover-lift">
                                <div class="bc-suggestion-avatar bg-primary">
                                    <i class="fas fa-user text-white"></i>
                                </div>
                                <div class="bc-suggestion-info">
                                    <h4 class="bc-suggestion-name">Michael Chen</h4>
                                    <p class="bc-suggestion-role">Product Manager</p>
                                    <div class="bc-suggestion-mutual">
                                        <i class="fas fa-users me-1"></i>3 mutual connections
                                    </div>
                                </div>
                                <div class="bc-suggestion-actions">
                                    <button class="btn btn-primary btn-sm bc-ripple">
                                        <i class="fas fa-user-plus me-1"></i>Connect
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="bc-suggestion-item hover-lift">
                                <div class="bc-suggestion-avatar bg-success">
                                    <i class="fas fa-user text-white"></i>
                                </div>
                                <div class="bc-suggestion-info">
                                    <h4 class="bc-suggestion-name">Emily Rodriguez</h4>
                                    <p class="bc-suggestion-role">UX Designer</p>
                                    <div class="bc-suggestion-mutual">
                                        <i class="fas fa-users me-1"></i>5 mutual connections
                                    </div>
                                </div>
                                <div class="bc-suggestion-actions">
                                    <button class="btn btn-primary btn-sm bc-ripple">
                                        <i class="fas fa-user-plus me-1"></i>Connect
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <a href="#" class="bc-link-primary" onclick="return false;">
                                    View all suggestions <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}
else
{
    <!-- Non-Authenticated User Landing Page -->
    <div class="bc-landing">
        <!-- Hero Section -->
        <section class="bc-hero position-relative overflow-hidden">
            <!-- Animated Background -->
            <div class="bc-hero-bg-animation">
                <div class="bc-floating-element bc-element-1"></div>
                <div class="bc-floating-element bc-element-2"></div>
                <div class="bc-floating-element bc-element-3"></div>
                <div class="bc-floating-element bc-element-4"></div>
            </div>

            <div class="container position-relative">
                <div class="row align-items-center min-vh-75">
                    <div class="col-lg-6">
                        <div class="bc-hero-content bc-fade-in">
                            <!-- Trust indicators -->
                            <div class="bc-trust-badges mb-4">
                                <span class="bc-trust-badge">
                                    <i class="fas fa-shield-check text-success me-1"></i>
                                    Secure Platform
                                </span>
                                <span class="bc-trust-badge">
                                    <i class="fas fa-users text-primary me-1"></i>
                                    10K+ Professionals
                                </span>
                                <span class="bc-trust-badge">
                                    <i class="fas fa-star text-warning me-1"></i>
                                    4.9/5 Rating
                                </span>
                            </div>

                            <h1 class="bc-hero-title bc-slide-in-left">
                                Welcome to <span class="text-primary position-relative">
                                    BizConnect
                                    <div class="bc-text-highlight"></div>
                                </span>
                            </h1>
                            <p class="bc-hero-subtitle bc-slide-in-up">
                                Your comprehensive business networking and collaboration
                                platform. Connect with professionals, manage projects, and
                                grow your business network.
                            </p>

                            <!-- Key benefits -->
                            <div class="bc-hero-benefits mb-4">
                                <div class="bc-benefit-item">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span>Free to join and start networking</span>
                                </div>
                                <div class="bc-benefit-item">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span>Connect with industry professionals</span>
                                </div>
                                <div class="bc-benefit-item">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span>Discover career opportunities</span>
                                </div>
                            </div>

                            <div class="bc-hero-actions">
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-3 bc-gradient-btn bc-ripple">
                                    <i class="fas fa-rocket me-2"></i>Get Started Free
                                </a>
                                <a href="#features" class="btn btn-outline-primary btn-lg bc-smooth-scroll">
                                    <i class="fas fa-play me-2"></i>Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="bc-hero-visual bc-slide-in-right">
                            <div class="bc-network-graphic position-relative">
                                <!-- Enhanced Interactive network visualization -->
                                <div class="bc-network-container bc-interactive-network" data-network="demo">
                                    <!-- Central User Node -->
                                    <div class="bc-network-node bc-node-center bc-node-interactive" data-tooltip="You - The center of your network">
                                        <i class="fas fa-user"></i>
                                        <div class="bc-node-pulse"></div>
                                        <div class="bc-node-label">You</div>
                                    </div>

                                    <!-- Career Node -->
                                    <div class="bc-network-node bc-node-1 bc-node-interactive" data-tooltip="Career Opportunities - 8 active">
                                        <i class="fas fa-briefcase"></i>
                                        <div class="bc-node-badge">8</div>
                                        <div class="bc-node-label">Jobs</div>
                                    </div>

                                    <!-- Connections Node -->
                                    <div class="bc-network-node bc-node-2 bc-node-interactive" data-tooltip="Professional Network - 24 connections">
                                        <i class="fas fa-users"></i>
                                        <div class="bc-node-badge">24</div>
                                        <div class="bc-node-label">Network</div>
                                    </div>

                                    <!-- Events Node -->
                                    <div class="bc-network-node bc-node-3 bc-node-interactive" data-tooltip="Networking Events - 3 upcoming">
                                        <i class="fas fa-calendar"></i>
                                        <div class="bc-node-badge">3</div>
                                        <div class="bc-node-label">Events</div>
                                    </div>

                                    <!-- Growth Node -->
                                    <div class="bc-network-node bc-node-4 bc-node-interactive" data-tooltip="Career Growth - Track your progress">
                                        <i class="fas fa-chart-line"></i>
                                        <div class="bc-node-badge">↗</div>
                                        <div class="bc-node-label">Growth</div>
                                    </div>

                                    <!-- Animated Connections -->
                                    <div class="bc-network-connection bc-connection-1 bc-connection-interactive"></div>
                                    <div class="bc-network-connection bc-connection-2 bc-connection-interactive"></div>
                                    <div class="bc-network-connection bc-connection-3 bc-connection-interactive"></div>
                                    <div class="bc-network-connection bc-connection-4 bc-connection-interactive"></div>

                                    <!-- Data Flow Animation -->
                                    <div class="bc-data-flow bc-flow-1"></div>
                                    <div class="bc-data-flow bc-flow-2"></div>
                                    <div class="bc-data-flow bc-flow-3"></div>
                                    <div class="bc-data-flow bc-flow-4"></div>
                                </div>

                                <!-- Network Stats Overlay -->
                                <div class="bc-network-stats">
                                    <div class="bc-stat-item">
                                        <span class="bc-stat-value">10K+</span>
                                        <span class="bc-stat-label">Active Users</span>
                                    </div>
                                    <div class="bc-stat-item">
                                        <span class="bc-stat-value">500+</span>
                                        <span class="bc-stat-label">Companies</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="bc-features py-5 bg-light">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="bc-section-title position-relative">
                            Why Choose BizConnect?
