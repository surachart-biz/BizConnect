@{
    ViewData["Title"] = "BizConnect - KBank ODD Registration";
}



@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Authenticated User - KBank ODD Dashboard -->
    <div class="kbank-dashboard">
        <!-- Quick Access Hero -->
        <section class="kbank-hero">
            <div class="container position-relative">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="hero-content">
                            <div class="trust-badge mb-3">
                                <i class="fas fa-university text-warning me-2"></i>
                                <span data-en="Official KBank Partner" data-th="พันธมิตรทางการของ KBank">Official KBank Partner</span>
                            </div>
                            <h1 class="display-4 fw-bold mb-3">
                                <span data-en="Welcome back," data-th="ยินดีต้อนรับกลับ,">Welcome back,</span> @User.Identity.Name
                            </h1>
                            <p class="lead mb-4">
                                <span data-en="Manage your KBank ODD registrations and monitor your daily operations efficiently." data-th="จัดการการลงทะเบียน KBank ODD และติดตามการดำเนินงานประจำวันอย่างมีประสิทธิภาพ">Manage your KBank ODD registrations and monitor your daily operations efficiently.</span>
                            </p>
                            <div class="hero-actions">
                                <a asp-controller="KBank" asp-action="Register" class="btn btn-light btn-lg me-3">
                                    <i class="fas fa-plus me-2"></i>
                                    <span data-en="New Registration" data-th="ลงทะเบียนใหม่">New Registration</span>
                                </a>
                                <a asp-controller="KBank" asp-action="Start" class="btn btn-outline-light btn-lg">
                                    <i class="fas fa-list me-2"></i>
                                    <span data-en="View All" data-th="ดูทั้งหมด">View All</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="hero-stats">
                            <div class="stat-item mb-3">
                                <div class="h2 fw-bold">24</div>
                                <div data-en="Pending Today" data-th="รอดำเนินการวันนี้">Pending Today</div>
                            </div>
                            <div class="stat-item">
                                <div class="h2 fw-bold text-warning">156</div>
                                <div data-en="Completed This Month" data-th="เสร็จสิ้นเดือนนี้">Completed This Month</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (User.IsInRole("Admin"))
        {
            <!-- Admin Quick Access -->
            <section class="py-4 bg-light">
                <div class="container">
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="fas fa-shield-alt me-3"></i>
                        <div class="flex-grow-1">
                            <h5 class="mb-1" data-en="Administrator Access" data-th="การเข้าถึงของผู้ดูแลระบบ">Administrator Access</h5>
                            <p class="mb-0" data-en="Manage ODD registrations, generate OTAC codes, and monitor system activity" data-th="จัดการการลงทะเบียน ODD, สร้างรหัส OTAC และติดตามกิจกรรมของระบบ">Manage ODD registrations, generate OTAC codes, and monitor system activity</p>
                        </div>
                        <a asp-controller="Home" asp-action="Dashboard" asp-area="Admin" class="btn btn-primary">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            <span data-en="Admin Dashboard" data-th="แดชบอร์ดผู้ดูแล">Admin Dashboard</span>
                        </a>
                    </div>
                </div>
            </section>
        }
    </div>
}
else
{
    <!-- Non-Authenticated User Landing Page -->
    <div class="kbank-landing">
        <!-- Hero Section -->
        <section class="position-relative overflow-hidden" style="background: var(--gradient-hero); color: white; padding: 120px 0;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: var(--glass-overlay); backdrop-filter: blur(5px);"></div>
            <div class="container position-relative">
                <div class="row align-items-center min-vh-75">
                    <div class="col-lg-6">
                        <div class="hero-content fade-in-up">
                            <!-- Trust indicators -->
                            <div class="mb-4">
                                <div class="badge-modern badge-kbank mb-2 me-2">
                                    <i class="fas fa-shield-check"></i>
                                    <span data-en="Bank-Grade Security" data-th="ความปลอดภัยระดับธนาคาร">Bank-Grade Security</span>
                                </div>
                                <div class="badge-modern badge-warning mb-2 me-2">
                                    <i class="fas fa-university"></i>
                                    <span data-en="KBank Official Partner" data-th="พันธมิตรทางการของ KBank">KBank Official Partner</span>
                                </div>
                                <div class="badge-modern badge-primary mb-2">
                                    <i class="fas fa-clock"></i>
                                    <span data-en="24/7 Available" data-th="ใช้ได้ 24/7">24/7 Available</span>
                                </div>
                            </div>

                            <h1 class="display-3 fw-bold mb-4">
                                <span data-en="KBank ODD Registration" data-th="การลงทะเบียน KBank ODD">KBank ODD Registration</span>
                                <div class="text-warning" data-en="Made Simple" data-th="ง่ายดาย">Made Simple</div>
                            </h1>
                            
                            <p class="lead mb-4">
                                <span data-en="Streamline your KBank Omnibus Deposit Data registration process with our secure, user-friendly platform designed for financial institutions." data-th="ปรับปรุงกระบวนการลงทะเบียน KBank Omnibus Deposit Data ด้วยแพลตฟอร์มที่ปลอดภัยและเป็นมิตรกับผู้ใช้ที่ออกแบบมาสำหรับสถาบันการเงิน">Streamline your KBank Omnibus Deposit Data registration process with our secure, user-friendly platform designed for financial institutions.</span>
                            </p>

                            <!-- Key benefits -->
                            <div class="hero-benefits mb-4">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Automated OTAC code generation" data-th="การสร้างรหัส OTAC อัตโนมัติ">Automated OTAC code generation</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Real-time registration tracking" data-th="การติดตามการลงทะเบียนแบบเรียลไทม์">Real-time registration tracking</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-check-circle text-warning me-3"></i>
                                    <span data-en="Secure data handling & encryption" data-th="การจัดการข้อมูลที่ปลอดภัยและการเข้ารหัส">Secure data handling & encryption</span>
                                </div>
                            </div>

                            <div class="hero-actions">
                                <a asp-action="Verify" class="btn-modern btn-gold me-3">
                                    <i class="fas fa-user-plus"></i>
                                    <span data-en="สมัครบริการหักบัญชีอัตโนมัติ" data-th="สมัครบริการหักบัญชีอัตโนมัติ">สมัครบริการหักบัญชีอัตโนมัติ</span>
                                </a>
                                <a asp-controller="Account" asp-action="Login" class="btn-modern btn-outline-modern" style="border-color: white; color: white;">
                                    <i class="fas fa-sign-in-alt"></i>
                                    <span data-en="เข้าสู่ระบบ (เจ้าหน้าที่)" data-th="เข้าสู่ระบบ (เจ้าหน้าที่)">เข้าสู่ระบบ (เจ้าหน้าที่)</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-visual text-center fade-in-right" style="animation-delay: 0.3s;">
                            <div class="position-relative d-inline-block">
                                <div class="glass-card p-5 rounded-circle d-inline-block" style="width: 300px; height: 300px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-university" style="font-size: 8rem; color: var(--kbank-green);"></i>
                                </div>
                                <!-- Floating security indicators -->
                                <div class="position-absolute" style="top: 10%; right: -10%; animation: bounce-in 2s infinite;">
                                    <div class="glass-card p-2 rounded-circle">
                                        <i class="fas fa-lock text-success"></i>
                                    </div>
                                </div>
                                <div class="position-absolute" style="top: 60%; left: -10%; animation: bounce-in 2s infinite 0.5s;">
                                    <div class="glass-card p-2 rounded-circle">
                                        <i class="fas fa-shield-alt text-kbank"></i>
                                    </div>
                                </div>
                                <div class="position-absolute" style="bottom: 10%; right: 20%; animation: bounce-in 2s infinite 1s;">
                                    <div class="glass-card p-2 rounded-circle">
                                        <i class="fas fa-key text-gold"></i>
                                    </div>
                                </div>
                                <div class="position-absolute" style="bottom: 40%; left: 10%; animation: bounce-in 2s infinite 1.5s;">
                                    <div class="glass-card p-2 rounded-circle">
                                        <i class="fas fa-check-circle text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4-Step Process Section -->
        <section id="how-it-works" class="py-5" style="background: var(--gradient-backdrop);">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="display-5 fw-bold text-kbank mb-3 fade-in-up">
                            <span data-en="How KBank ODD Registration Works" data-th="วิธีการทำงานของการลงทะเบียน KBank ODD">How KBank ODD Registration Works</span>
                        </h2>
                        <p class="lead text-muted fade-in-up" style="animation-delay: 0.2s;">
                            <span data-en="Simple 4-step process to complete your registration" data-th="กระบวนการ 4 ขั้นตอนง่ายๆ เพื่อลงทะเบียนให้เสร็จสมบูรณ์">Simple 4-step process to complete your registration</span>
                        </p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Step 1: Get OTAC from Staff -->
                    <div class="col-md-6 col-lg-3">
                        <div class="glass-card text-center h-100 fade-in-up" style="animation-delay: 0.1s;">
                            <div class="card-modern-body p-4">
                                <div class="position-relative d-inline-block mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: var(--gradient-kbank); color: white; font-size: 2rem; font-weight: bold;">1</div>
                                </div>
                                <div class="mb-3" style="font-size: 3rem; color: var(--kbank-green);">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <h4 class="fw-bold mb-3 text-kbank" data-en="Get OTAC Code" data-th="รับรหัส OTAC">Get OTAC Code</h4>
                                <p class="text-muted" data-en="Receive your unique 8-character OTAC code from our staff member" data-th="รับรหัส OTAC 8 หลักที่ไม่ซ้ำกันจากเจ้าหน้าที่ของเรา">Receive your unique 8-character OTAC code from our staff member</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Validate OTAC -->
                    <div class="col-md-6 col-lg-3">
                        <div class="glass-card text-center h-100 fade-in-up" style="animation-delay: 0.2s;">
                            <div class="card-modern-body p-4">
                                <div class="position-relative d-inline-block mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: var(--gradient-success); color: white; font-size: 2rem; font-weight: bold;">2</div>
                                </div>
                                <div class="mb-3" style="font-size: 3rem; color: var(--success);">
                                    <i class="fas fa-key"></i>
                                </div>
                                <h4 class="fw-bold mb-3 text-kbank" data-en="Validate OTAC" data-th="ยืนยันรหัส OTAC">Validate OTAC</h4>
                                <p class="text-muted" data-en="Enter your OTAC code to verify authorization and proceed to registration" data-th="ป้อนรหัส OTAC ของคุณเพื่อตรวจสอบการอนุญาตและดำเนินการลงทะเบียน">Enter your OTAC code to verify authorization and proceed to registration</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Fill Registration Form -->
                    <div class="col-md-6 col-lg-3">
                        <div class="glass-card text-center h-100 fade-in-up" style="animation-delay: 0.3s;">
                            <div class="card-modern-body p-4">
                                <div class="position-relative d-inline-block mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: var(--gradient-primary); color: white; font-size: 2rem; font-weight: bold;">3</div>
                                </div>
                                <div class="mb-3" style="font-size: 3rem; color: var(--primary-blue);">
                                    <i class="fas fa-id-card"></i>
                                </div>
                                <h4 class="fw-bold mb-3 text-kbank" data-en="Fill Details" data-th="กรอกข้อมูล">Fill Details</h4>
                                <p class="text-muted" data-en="Complete the registration form with your National ID, contact, and bank account information" data-th="กรอกแบบฟอร์มลงทะเบียนด้วยบัตรประชาชน ข้อมูลติดต่อ และข้อมูลบัญชีธนาคาร">Complete the registration form with your National ID, contact, and bank account information</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Submit to KBank -->
                    <div class="col-md-6 col-lg-3">
                        <div class="glass-card text-center h-100 fade-in-up" style="animation-delay: 0.4s;">
                            <div class="card-modern-body p-4">
                                <div class="position-relative d-inline-block mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: var(--gradient-gold); color: white; font-size: 2rem; font-weight: bold;">4</div>
                                </div>
                                <div class="mb-3" style="font-size: 3rem; color: var(--accent-gold);">
                                    <i class="fas fa-university"></i>
                                </div>
                                <h4 class="fw-bold mb-3 text-kbank" data-en="Submit to KBank" data-th="ส่งข้อมูลให้ KBank">Submit to KBank</h4>
                                <p class="text-muted" data-en="Your registration is securely submitted to KBank for automatic debit service setup" data-th="การลงทะเบียนของคุณจะถูกส่งอย่างปลอดภัยไปยัง KBank เพื่อตั้งค่าบริการหักบัญชีอัตโนมัติ">Your registration is securely submitted to KBank for automatic debit service setup</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-5">
                    <div class="col-12 text-center">
                        <a asp-action="Verify" class="btn-modern btn-kbank btn-lg scale-in" style="animation-delay: 0.5s;">
                            <i class="fas fa-arrow-right"></i>
                            <span data-en="Begin Registration Process" data-th="เริ่มกระบวนการลงทะเบียน">Begin Registration Process</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-5">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="display-5 fw-bold text-primary mb-3">
                            <span data-en="Frequently Asked Questions" data-th="คำถามที่พบบ่อย">Frequently Asked Questions</span>
                        </h2>
                        <p class="lead text-muted">
                            <span data-en="Common questions about KBank ODD registration" data-th="คำถามทั่วไปเกี่ยวกับการลงทะเบียน KBank ODD">Common questions about KBank ODD registration</span>
                        </p>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="accordion" id="faqAccordion">
                            <!-- FAQ 1 -->
                            <div class="glass-card mb-3 fade-in-up" style="animation-delay: 0.1s;">
                                <button class="w-100 border-0 bg-transparent p-4 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    <h5 class="mb-0 fw-semibold text-dark">
                                        <span data-en="What is KBank ODD Registration?" data-th="การลงทะเบียน KBank ODD คืออะไร?">What is KBank ODD Registration?</span>
                                    </h5>
                                    <i class="fas fa-chevron-down text-kbank"></i>
                                </button>
                                <div id="faq1" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="px-4 pb-4">
                                        <div class="glass p-3 rounded">
                                            <p class="mb-0" data-en="KBank ODD (Omnibus Deposit Data) Registration is a secure process that allows financial institutions to register and manage deposit data with KBank's systems. This ensures compliance with banking regulations and secure data handling." data-th="การลงทะเบียน KBank ODD (Omnibus Deposit Data) เป็นกระบวนการที่ปลอดภัยที่ช่วยให้สถาบันการเงินสามารถลงทะเบียนและจัดการข้อมูลเงินฝากกับระบบของ KBank ได้ สิ่งนี้ช่วยให้มั่นใจในการปฏิบัติตามกฎระเบียบของธนาคารและการจัดการข้อมูลที่ปลอดภัย">KBank ODD (Omnibus Deposit Data) Registration is a secure process that allows financial institutions to register and manage deposit data with KBank's systems. This ensures compliance with banking regulations and secure data handling.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 2 -->
                            <div class="glass-card mb-3 fade-in-up" style="animation-delay: 0.2s;">
                                <button class="w-100 border-0 bg-transparent p-4 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    <h5 class="mb-0 fw-semibold text-dark">
                                        <span data-en="How secure is my data?" data-th="ข้อมูลของฉันปลอดภัยแค่ไหน?">How secure is my data?</span>
                                    </h5>
                                    <i class="fas fa-chevron-down text-kbank"></i>
                                </button>
                                <div id="faq2" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="px-4 pb-4">
                                        <div class="glass p-3 rounded">
                                            <p class="mb-0" data-en="We use bank-grade security with end-to-end encryption, secure HTTPS connections, and comply with all financial industry standards. Your data is protected with the same level of security used by major banking institutions." data-th="เราใช้ความปลอดภัยระดับธนาคารพร้อมการเข้ารหัสแบบ end-to-end การเชื่อมต่อ HTTPS ที่ปลอดภัย และปฏิบัติตามมาตรฐานอุตสาหกรรมการเงินทั้งหมด ข้อมูลของคุณได้รับการปกป้องด้วยระดับความปลอดภัยเดียวกับที่ใช้โดยสถาบันการธนาคารขนาดใหญ่">We use bank-grade security with end-to-end encryption, secure HTTPS connections, and comply with all financial industry standards. Your data is protected with the same level of security used by major banking institutions.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 3 -->
                            <div class="glass-card mb-3 fade-in-up" style="animation-delay: 0.3s;">
                                <button class="w-100 border-0 bg-transparent p-4 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    <h5 class="mb-0 fw-semibold text-dark">
                                        <span data-en="What is an OTAC code?" data-th="รหัส OTAC คืออะไร?">What is an OTAC code?</span>
                                    </h5>
                                    <i class="fas fa-chevron-down text-kbank"></i>
                                </button>
                                <div id="faq3" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="px-4 pb-4">
                                        <div class="glass p-3 rounded">
                                            <p class="mb-0" data-en="OTAC (One-Time Authorization Code) is a unique, time-limited code generated for each registration. It provides an additional layer of security and ensures that only authorized users can complete the registration process." data-th="OTAC (One-Time Authorization Code) เป็นรหัสเฉพาะที่มีเวลาจำกัดที่สร้างขึ้นสำหรับการลงทะเบียนแต่ละครั้ง ให้ความปลอดภัยเพิ่มเติมและรับประกันว่ามีเพียงผู้ใช้ที่ได้รับอนุญาตเท่านั้นที่สามารถดำเนินการลงทะเบียนให้เสร็จสิ้นได้">OTAC (One-Time Authorization Code) is a unique, time-limited code generated for each registration. It provides an additional layer of security and ensures that only authorized users can complete the registration process.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 4 -->
                            <div class="glass-card mb-3 fade-in-up" style="animation-delay: 0.4s;">
                                <button class="w-100 border-0 bg-transparent p-4 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                    <h5 class="mb-0 fw-semibold text-dark">
                                        <span data-en="How long does the registration process take?" data-th="กระบวนการลงทะเบียนใช้เวลานานแค่ไหน?">How long does the registration process take?</span>
                                    </h5>
                                    <i class="fas fa-chevron-down text-kbank"></i>
                                </button>
                                <div id="faq4" class="collapse" data-bs-parent="#faqAccordion">
                                    <div class="px-4 pb-4">
                                        <div class="glass p-3 rounded">
