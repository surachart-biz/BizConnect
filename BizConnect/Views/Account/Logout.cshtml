@{
    ViewData["Title"] = "Logout";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">Logout</h3>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="fas fa-sign-out-alt fa-3x text-muted"></i>
                </div>
                <h5>You are being logged out...</h5>
                <p class="text-muted">Please wait while we securely sign you out of your account.</p>
                
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                
                <div class="mt-4">
                    <p class="small text-muted">
                        If you are not automatically redirected, 
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none">click here to login again</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

@section Scripts {
    <script>
        // Auto-redirect after a short delay to show the logout message
        setTimeout(function() {
            window.location.href = '@Url.Action("Login", "Account")';
        }, 2000);
    </script>
}
