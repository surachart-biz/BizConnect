{
  "Security": {
    "CookieSecure": false,
    "RequireHttps": false,
    "HstsMaxAge": 31536000
  },
  "Performance": {
    "EnableResponseCaching": true,
    "EnableResponseCompression": true
  },
  "Authentication": {
    "SessionTimeoutMinutes": 30,
    "RememberMeDays": 7,
    "LoginAttemptLockoutMinutes": 15,
    "MaxFailedLoginAttempts": 5
  },
  "OTAC": {
    "CodeLengthCharacters": 8,
    "ExpirationMinutes": 10,
    "MaxValidationAttempts": 5,
    "PurgeIntervalMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "BizConnect.Controllers.AccountController": "Warning",
      "BizConnect.Services.OtacService": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.Authorization": "Warning"
    }
  }
}