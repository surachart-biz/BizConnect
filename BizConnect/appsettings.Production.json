{
  "ConnectionStrings": {
    "DefaultConnection": "Host=prod-db-server;Database=bizconnect_prod;Username=bizconnect_user;Password=PRODUCTION_PASSWORD_HERE"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "AllowedHosts": "bizconnect.com,*.bizconnect.com",
  "Environment": "Production",
  "DetailedErrors": false,
  "Security": {
    "RequireHttps": true,
    "CookieSecure": true,
    "HstsMaxAge": 31536000
  },
  "Performance": {
    "EnableResponseCaching": true,
    "EnableResponseCompression": true
  },
  "KBankODD": {
    "BaseUrl": "https://ws06.kasikornbank.com",
    "PGBaseUrl": "https://ws06.kasikornbank.com",
    "ExternalSystem": "BIZCONNECT",
    "ServiceName": "BizConnect Online Direct Debit"
    // PassPhrase is stored in secrets only:
    // - Dev: dotnet user-secrets (key: KBankODD:PassPhrase)
    // - CI/Prod: GitLab variable KBankODD__PassPhrase
  }
}
