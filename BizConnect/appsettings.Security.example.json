{
  "Security": {
    "CookieSecure": true,
    "RequireHttps": true,
    "HstsMaxAge": 31536000
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "SpecialCharacters": "!@#$%^&*()_+-=[]{}|;:,.<>?",
    "PreventUsernameInPassword": true,
    "CheckAgainstCommonPasswords": true,
    "PasswordHistoryCount": 5,
    "PasswordExpirationDays": 90,
    "PasswordExpirationWarningDays": 14,
    "MaxRepeatingCharacters": 3,
    "PreventSequentialCharacters": true,
    "MinimumStrengthScore": 60
  },
  "RateLimiting": {
    "login": {
      "MaxAttempts": 5,
      "LockoutDurationMinutes": 15,
      "AttemptWindowMinutes": 15,
      "EnableUserLockout": true,
      "EnableIpLockout": true
    },
    "otac": {
      "MaxAttempts": 5,
      "LockoutDurationMinutes": 10,
      "AttemptWindowMinutes": 10,
      "EnableUserLockout": false,
      "EnableIpLockout": true
    }
  },
  "Authentication": {
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "SessionTimeoutMinutes": 30,
    "RequireTwoFactor": false,
    "PasswordExpirationDays": 90,
    "PasswordHistoryCount": 5,
    "AllowRememberMe": true,
    "RememberMeDays": 7
  }
}