{
  "ConnectionStrings": {
    "DefaultConnection": "Host=uat-db-server;Database=bizconnect_uat;Username=bizconnect_user;Password=UAT_PASSWORD_HERE"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "uat.bizconnect.com,*.uat.bizconnect.com",
  "Environment": "UAT",
  "DetailedErrors": false,
  "Security": {
    "RequireHttps": true,
    "CookieSecure": true
  },
  "KBankODD": {
    "BaseUrl": "https://ws06.uat.kasikornbank.com",
    "PGBaseUrl": "https://ws06.uat.kasikornbank.com",
    "ExternalSystem": "BIZCONNECT",
    "ServiceName": "BizConnect Online Direct Debit"
    // PassPhrase is stored in secrets only:
    // - Dev: dotnet user-secrets (key: KBankODD:PassPhrase)
    // - CI/Prod: GitLab variable KBankODD__PassPhrase
  }
}
