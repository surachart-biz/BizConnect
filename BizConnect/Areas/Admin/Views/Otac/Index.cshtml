@{
    await Html.PartialAsync("_LanguageTexts");
    ViewData["Title"] = ViewBag.IsThaiLanguage ? "จัดการรหัส OTAC" : "OTAC Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <h1 class="page-title">@ViewData["Title"]</h1>
                <p class="page-subtitle">@(ViewBag.IsThaiLanguage ? "จัดการรหัส OTAC สำหรับระบบลงทะเบียน" : "Manage One-Time Access Codes for registration system")</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">@(ViewBag.IsThaiLanguage ? "การดำเนินการ OTAC" : "OTAC Operations")</h3>
                    <div class="card-actions">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
                            <i class="fas fa-plus me-2"></i>@ViewBag.TextOtacGenerate
                        </button>
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#validateModal">
                            <i class="fas fa-check me-2"></i>@ViewBag.TextOtacValidate
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="stats-card bg-primary text-white p-4 rounded">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">Active OTAC Codes</h5>
                                        <h2 class="mb-0" id="activeOtacCount">Loading...</h2>
                                    </div>
                                    <div class="stats-icon">
                                        <i class="fas fa-key fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="stats-card bg-success text-white p-4 rounded">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">Generated Today</h5>
                                        <h2 class="mb-0" id="todayOtacCount">Loading...</h2>
                                    </div>
                                    <div class="stats-icon">
                                        <i class="fas fa-calendar-day fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>OTAC System Information:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>OTAC codes expire after 30 minutes</li>
                                    <li>Maximum 5 validation attempts allowed per code</li>
                                    <li>Codes are 8 characters long (alphanumeric, excluding confusing characters)</li>
                                    <li>Case-insensitive validation for better user experience</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Recent OTAC Activity</h4>
                            <div class="table-responsive">
                                <table class="table table-striped" id="otacActivityTable">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Code</th>
                                            <th>Status</th>
                                            <th>Generated At</th>
                                            <th>Expires At</th>
                                            <th>Attempts</th>
                                            <th>Generated By</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="7" class="text-center">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                                <p class="mt-2">Loading OTAC activity...</p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Generate OTAC Modal -->
@await Html.PartialAsync("_GenerateModal")

<!-- Validate OTAC Modal -->
@await Html.PartialAsync("_ValidateModal")

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load initial statistics
            loadOtacStatistics();
            loadOtacActivity();
            
            // Auto-refresh every 30 seconds
            setInterval(function() {
                loadOtacStatistics();
                loadOtacActivity();
            }, 30000);
        });

        function loadOtacStatistics() {
            // Mock data for now - replace with actual API calls
            $('#activeOtacCount').text('45');
            $('#todayOtacCount').text('127');
        }

        function loadOtacActivity() {
            // Mock data for recent activity - replace with actual API calls
            const mockData = [
                {
                    code: 'ABC12345',
                    status: 'Active',
                    generatedAt: '2025-01-05 14:30:00',
                    expiresAt: '2025-01-05 15:00:00',
                    attempts: 0,
                    generatedBy: 'admin@bizconnect.com',
                    actions: '<button class="btn btn-sm btn-outline-danger" onclick="invalidateOtac(\'ABC12345\')">Invalidate</button>'
                },
                {
                    code: 'XYZ67890',
                    status: 'Validated',
                    generatedAt: '2025-01-05 14:25:00',
                    expiresAt: '2025-01-05 14:55:00',
                    attempts: 1,
                    generatedBy: 'admin@bizconnect.com',
                    actions: '<span class="text-muted">Used</span>'
                },
                {
                    code: 'DEF24680',
                    status: 'Expired',
                    generatedAt: '2025-01-05 13:00:00',
                    expiresAt: '2025-01-05 13:30:00',
                    attempts: 3,
                    generatedBy: 'admin@bizconnect.com',
                    actions: '<span class="text-muted">Expired</span>'
                }
            ];

            const tbody = $('#otacActivityTable tbody');
            tbody.empty();
            
            if (mockData.length === 0) {
                tbody.append(`
                    <tr>
                        <td colspan="7" class="text-center text-muted">No OTAC activity found</td>
                    </tr>
                `);
            } else {
                mockData.forEach(item => {
                    const statusBadge = getStatusBadge(item.status);
                    tbody.append(`
                        <tr>
                            <td><code>${item.code}</code></td>
                            <td>${statusBadge}</td>
                            <td>${item.generatedAt}</td>
                            <td>${item.expiresAt}</td>
                            <td><span class="badge bg-info">${item.attempts}/5</span></td>
                            <td>${item.generatedBy}</td>
                            <td>${item.actions}</td>
                        </tr>
                    `);
                });
            }
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'Active':
                    return '<span class="badge bg-success">Active</span>';
                case 'Validated':
                    return '<span class="badge bg-primary">Validated</span>';
                case 'Expired':
                    return '<span class="badge bg-warning">Expired</span>';
                case 'Locked':
                    return '<span class="badge bg-danger">Locked</span>';
                case 'Invalidated':
                    return '<span class="badge bg-secondary">Invalidated</span>';
                default:
                    return '<span class="badge bg-secondary">Unknown</span>';
            }
        }

        function invalidateOtac(code) {
            if (confirm('Are you sure you want to invalidate OTAC code: ' + code + '?')) {
                // Call API to invalidate OTAC
                // For now, just reload the activity
                alert('OTAC code ' + code + ' has been invalidated.');
                loadOtacActivity();
            }
        }

        // Generate OTAC immediately without form
        function generateOtacImmediately() {
            // Create form data for immediate generation
            const formData = new FormData();
            formData.append('Purpose', 'KBank ODD Guest Registration');
            formData.append('IssuedTo', 'Guest User');
            
            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || 
                         document.querySelector('meta[name="__RequestVerificationToken"]')?.content;
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }
            
            fetch('@Url.Action("GenerateForKBankOdd", "Otac", new { area = "Admin" })', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Use the existing populateOtacModal function
                    if (typeof populateOtacModal === 'function') {
                        populateOtacModal({
                            otacCode: data.code,
                            otacExpiresAt: data.expiresAt,
                            purpose: data.purpose,
                            registrationId: data.registrationId
                        });
                        
                        const resultsModal = new bootstrap.Modal(document.getElementById('generateOtacModal'));
                        resultsModal.show();
                    }
                    
                    // Refresh statistics
                    loadOtacStatistics();
                    loadOtacActivity();
                } else {
                    alert('Error generating OTAC: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An unexpected error occurred while generating OTAC code.');
            });
        }

        // Show success message if TempData indicates success
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            toastr.success('@TempData["SuccessMessage"]');
            </text>
        }

        // Show error message if TempData indicates error
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}

@section Styles {
    <style>
        .stats-card {
            transition: transform 0.2s;
        }
        
        .stats-card:hover {
            transform: translateY(-2px);
        }
        
        .stats-icon {
            opacity: 0.7;
        }
        
        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }
        
        .page-title {
            margin-bottom: 0.5rem;
            color: #2c3e50;
        }
        
        .page-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }
        
        .card-actions .btn {
            margin-left: 0.5rem;
        }
        
        .table code {
            font-size: 0.9rem;
            color: #e83e8c;
            background-color: #f8f9fa;
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
        }
    </style>
}