@model ValidateOtacViewModel

<!-- Validate OTAC Modal -->
<div class="modal fade" id="validateOtacModal" tabindex="-1" aria-labelledby="validateOtacModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="validateOtacModalLabel">
                    <i class="fas fa-shield-check me-2"></i>Validate OTAC Code
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form id="validateOtacForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- OTAC Code Field -->
                    <div class="mb-4">
                        <label asp-for="Code" class="form-label">
                            <i class="fas fa-key me-1"></i>OTAC Code
                        </label>
                        <input asp-for="Code" class="form-control form-control-lg font-monospace text-center text-uppercase" 
                               placeholder="Enter 8-character OTAC code" maxlength="8" style="font-size: 1.5rem; letter-spacing: 0.3em;" />
                        <div class="form-text">
                            Enter the 8-character OTAC code (letters and numbers only)
                        </div>
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>


                    <!-- Security Information -->
                    <div class="alert alert-warning border-0">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-exclamation-triangle me-3 mt-1"></i>
                            <div>
                                <h6 class="alert-heading">Security Notice</h6>
                                <ul class="mb-0 ps-3">
                                    <li>OTAC codes are single-use and expire automatically</li>
                                    <li>Each validation attempt is logged for security purposes</li>
                                    <li>Invalid codes or multiple failed attempts may trigger security alerts</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Validation Result Section (Initially Hidden) -->
                    <div id="validationResult" class="d-none">
                        <!-- Success Result -->
                        <div id="successResult" class="d-none">
                            <div class="alert alert-success border-0 shadow-sm">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-check-circle fa-3x text-success"></i>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5 class="alert-heading mb-1">Validation Successful!</h5>
                                        <p class="mb-0">The OTAC code has been validated and marked as used.</p>
                                    </div>
                                </div>
                                
                                <!-- Validation Details -->
                                <div class="validation-details p-3 bg-white rounded border">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Validated Code</label>
                                            <div id="validatedCode" class="font-monospace fw-bold"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Registration ID</label>
                                            <div id="validatedRegistrationId" class="fw-bold"></div>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Validation Time</label>
                                            <div id="validationTime" class="text-muted"></div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Access Level</label>
                                            <div class="badge bg-success">Authorized</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Next Steps -->
                                <div class="mt-3 pt-3 border-top">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-info-circle text-info me-2 mt-1"></i>
                                        <div class="small">
                                            <strong>Access Granted:</strong> You now have temporary access to protected resources 
                                            related to this purpose. This session will be tracked for security compliance.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Error Result -->
                        <div id="errorResult" class="d-none">
                            <div class="alert alert-danger border-0 shadow-sm">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-times-circle fa-3x text-danger"></i>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5 class="alert-heading mb-1">Validation Failed</h5>
                                        <p class="mb-0" id="errorMessage"></p>
                                    </div>
                                </div>

                                <!-- Common Reasons -->
                                <div class="mt-3 pt-3 border-top">
                                    <h6 class="mb-2">Common reasons for validation failure:</h6>
                                    <ul class="mb-0 ps-3 small">
                                        <li>The OTAC code has already been used</li>
                                        <li>The code has expired (codes typically expire in 15 minutes)</li>
                                        <li>The code was entered incorrectly</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div id="loadingState" class="d-none text-center py-4">
                        <div class="spinner-border text-info" role="status">
                            <span class="visually-hidden">Validating...</span>
                        </div>
                        <div class="mt-2 text-muted">Validating your OTAC code...</div>
                        <div class="mt-2 small text-muted">
                            <i class="fas fa-shield-alt me-1"></i>
                            Secure validation in progress
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div id="initialButtons">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-info" id="validateButton">
                            <i class="fas fa-shield-check me-1"></i>Validate Code
                        </button>
                    </div>
                    
                    <div id="resultButtons" class="d-none">
                        <button type="button" class="btn btn-outline-info" onclick="validateAnother()">
                            <i class="fas fa-redo me-1"></i>Validate Another
                        </button>
                        <button type="button" class="btn btn-info" data-bs-dismiss="modal">
                            <i class="fas fa-check me-1"></i>Done
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .font-monospace {
        font-family: 'Courier New', Courier, monospace !important;
    }
    
    .modal-header.bg-info {
        border-bottom: none;
    }
    
    .modal-content {
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    }
    
    .validation-details {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }
    
    .alert-heading {
        color: inherit;
    }
    
    /* Auto-format OTAC input */
    #Code {
        text-transform: uppercase;
    }
</style>

<script>
    document.getElementById('validateOtacForm').addEventListener('submit', function(e) {
        e.preventDefault();
        validateOtacCode();
    });

    // Auto-format OTAC code input
    document.getElementById('Code').addEventListener('input', function(e) {
        let value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
        if (value.length > 8) {
            value = value.substring(0, 8);
        }
        e.target.value = value;
    });

    // Auto-submit when code is complete (8 characters)
    document.getElementById('Code').addEventListener('input', function(e) {
        if (e.target.value.length === 8) {
            // Auto-trigger validation after a short delay
            setTimeout(() => {
                document.getElementById('validateButton').focus();
            }, 100);
        }
    });

    function validateOtacCode() {
        const form = document.getElementById('validateOtacForm');
        const formData = new FormData(form);
        
        // Show loading state
        showLoading();
        
        fetch('@Url.Action("ValidateAjax")', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => response.json())
        .then(data => {
            hideLoading();
            
            if (data.success) {
                showValidationSuccess(data);
            } else {
                showValidationError(data.message);
            }
        })
        .catch(error => {
            hideLoading();
            showValidationError('An unexpected error occurred during validation. Please try again.');
            console.error('Error:', error);
        });
    }

    function showLoading() {
        document.getElementById('loadingState').classList.remove('d-none');
        document.getElementById('validateButton').disabled = true;
        document.getElementById('validationResult').classList.add('d-none');
    }

    function hideLoading() {
        document.getElementById('loadingState').classList.add('d-none');
        document.getElementById('validateButton').disabled = false;
    }

    function showValidationSuccess(data) {
        // Hide form fields and show result
        hideFormFields();
        
        // Show success result
        document.getElementById('validationResult').classList.remove('d-none');
        document.getElementById('successResult').classList.remove('d-none');
        document.getElementById('errorResult').classList.add('d-none');
        
        // Populate success details
        document.getElementById('validatedCode').textContent = data.code;
        document.getElementById('validatedRegistrationId').textContent = data.registrationId || 'N/A';
        document.getElementById('validationTime').textContent = new Date().toLocaleString();
        
        // Switch buttons
        document.getElementById('initialButtons').classList.add('d-none');
        document.getElementById('resultButtons').classList.remove('d-none');
    }

    function showValidationError(message) {
        // Hide form fields and show result
        hideFormFields();
        
        // Show error result
        document.getElementById('validationResult').classList.remove('d-none');
        document.getElementById('errorResult').classList.remove('d-none');
        document.getElementById('successResult').classList.add('d-none');
        
        // Populate error message
        document.getElementById('errorMessage').textContent = message;
        
        // Switch buttons
        document.getElementById('initialButtons').classList.add('d-none');
        document.getElementById('resultButtons').classList.remove('d-none');
    }

    function hideFormFields() {
        const formFields = document.querySelectorAll('.modal-body .mb-4');
        formFields.forEach(field => {
            field.style.display = 'none';
        });
        
        // Hide security notice
        document.querySelector('.alert-warning').style.display = 'none';
    }

    function showFormFields() {
        const formFields = document.querySelectorAll('.modal-body .mb-4');
        formFields.forEach(field => {
            field.style.display = 'block';
        });
        
        // Show security notice
        document.querySelector('.alert-warning').style.display = 'block';
    }

    function validateAnother() {
        // Reset form
        document.getElementById('validateOtacForm').reset();
        document.getElementById('validationResult').classList.add('d-none');
        
        // Show form fields
        showFormFields();
        
        // Switch buttons back
        document.getElementById('resultButtons').classList.add('d-none');
        document.getElementById('initialButtons').classList.remove('d-none');
        
        // Focus on code input
        document.getElementById('Code').focus();
    }

    // Focus on code input when modal opens
    document.getElementById('validateOtacModal').addEventListener('shown.bs.modal', function () {
        document.getElementById('Code').focus();
    });

    // Reset form when modal closes
    document.getElementById('validateOtacModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('validateOtacForm').reset();
        document.getElementById('validationResult').classList.add('d-none');
        showFormFields();
        document.getElementById('resultButtons').classList.add('d-none');
        document.getElementById('initialButtons').classList.remove('d-none');
    });
</script>