@model OddRegistrationListViewModel
@using Microsoft.Extensions.Localization
@using BizConnect.Extensions
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["OddRegistrations"];
    ViewBag.Subtitle = Localizer["ManageOddRegistrations"];
    ViewBag.BreadcrumbSection = Localizer["OddManagement"];
    var currentCulture = Context.GetCurrentCulture();
    var isThaiCulture = Context.IsThaiCulture();
}

@section HeaderActions {
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success" id="generateOtacButton" onclick="generateOtacImmediately(); return false;">
            <i class="fas fa-key me-1"></i>@Localizer["AddData"]
        </button>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" onclick="exportData('excel')">
                <i class="fas fa-file-excel me-1"></i>@Localizer["ExportExcel"]
            </button>
            <button class="btn btn-outline-info" onclick="exportData('csv')">
                <i class="fas fa-file-csv me-1"></i>@Localizer["ExportCsv"]
            </button>
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-cog me-1"></i>@Localizer["Actions"]
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="#" onclick="bulkAction('approve')">
                            <i class="fas fa-check me-2"></i>@Localizer["BulkApprove"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="bulkAction('reject')">
                            <i class="fas fa-times me-2"></i>@Localizer["BulkReject"]
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="refreshTable()">
                            <i class="fas fa-sync-alt me-2"></i>@Localizer["Refresh"]
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/odd-registration-modern.css" rel="stylesheet" asp-append-version="true" />
}

    <!-- Skip link for accessibility -->
    <a href="#main-content" class="odd-skip-link">Skip to main content</a>

    <!-- Search and Filters -->
    <div class="odd-filters-container">
        <div class="odd-filters-body">
            <form method="get" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <div class="odd-filter-group">
                            <label for="search" class="odd-filter-label">@Localizer["Search"]</label>
                            <div class="odd-search-input">
                                <i class="fas fa-search odd-search-icon"></i>
                                <input type="text" class="form-control" id="search" name="search"
                                       value="@Model.SearchQuery" placeholder="@Localizer["SearchPlaceholder"]">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="odd-filter-group">
                            <label for="status" class="odd-filter-label">@Localizer["Status"]</label>
                            <select class="form-select" id="status" name="status">
                                <option value="">@Localizer["AllStatus"]</option>
                                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">@Localizer["Pending"]</option>
                                <option value="Success" selected="@(Model.StatusFilter == "Success")">@Localizer["Success"]</option>
                                <option value="Fail" selected="@(Model.StatusFilter == "Fail")">@Localizer["Failed"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="odd-filter-group">
                            <label for="pageSize" class="odd-filter-label">@Localizer["PerPage"]</label>
                            <select class="form-select" id="pageSize" name="pageSize">
                                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                <option value="100" selected="@(Model.PageSize == 100)">100</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="odd-filter-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search me-1"></i>@Localizer["Filter"]
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>@Localizer["Clear"]
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="odd-table-container" id="main-content">
        <div class="odd-table-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="odd-table-title">@Localizer["OddRegistrations"]</h3>
                    <p class="odd-table-subtitle">
                        @string.Format(Localizer["ShowingEntries"], Model.StartRecord, Model.EndRecord, Model.TotalRecords)
                    </p>
                </div>
                <div class="odd-table-stats">
                    <span class="odd-badge odd-badge-pending me-2">
                        @Model.Registrations.Count(r => r.Status == "Pending") @Localizer["Pending"]
                    </span>
                    <span class="odd-badge odd-badge-success me-2">
                        @Model.Registrations.Count(r => r.Status == "Completed") @Localizer["Completed"]
                    </span>
                    <span class="odd-badge odd-badge-failed">
                        @Model.Registrations.Count(r => r.Status == "Failed") @Localizer["Failed"]
                    </span>
                </div>
            </div>
        </div>

        <!-- Desktop Table View -->
        <div class="odd-table-responsive">
        @if (Model.Registrations.Any())
        {
                <table class="odd-table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="odd-cell-checkbox">
                                <input type="checkbox" class="form-check-input" id="selectAll" 
                                       aria-label="Select all registrations">
                            </th>
                            <th class="odd-cell-external-ref">@Localizer["ExternalReference"]</th>
                            <th class="odd-cell-customer">@Localizer["CustomerInfo"]</th>
                            <th class="odd-cell-branch">@Localizer["BranchInformation"]</th>
                            <th class="odd-cell-otac">@Localizer["OtacDetails"]</th>
                            <th class="odd-cell-status">@Localizer["RegistrationStatus"]</th>
                            <th class="odd-cell-tracking">@Localizer["TrackingInfo"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var registration in Model.Registrations)
                    {
                            <tr>
                                <td class="odd-cell-checkbox">
                                    <input type="checkbox" class="form-check-input row-checkbox" 
                                           value="@registration.Id" aria-label="Select registration @registration.Id">
                                </td>

                                <!-- External Reference -->
                                <td class="odd-cell-external-ref">
                                @if (!string.IsNullOrEmpty(registration.ExternalReference))
                                {
                                        <div class="odd-info-primary">@registration.ExternalReference</div>
                                }
                                else
                                {
                                        <div class="text-muted">-</div>
                                }
                                </td>

                                <!-- Customer Info Block -->
                                <td class="odd-cell-customer">
                                    <div class="odd-info-block @(isThaiCulture ? "odd-thai-font" : "")">
                                    @if (!string.IsNullOrEmpty(registration.FullName))
                                    {
                                            <div class="odd-info-primary">
                                                <i class="fas fa-user me-1 text-secondary"></i>@registration.FullName
                                            </div>
                                    }

                                        <!-- ID Type/Value -->
                                    @if (!string.IsNullOrEmpty(registration.IdType) && !string.IsNullOrEmpty(registration.IdValue))
                                    {
                                            <div class="odd-info-secondary">
                                                <span class="odd-badge bg-light text-dark me-1">@registration.IdType</span>
                                                <span class="text-muted">@registration.IdValue</span>
                                            </div>
                                    }

                                        <!-- Mobile -->
                                    @if (!string.IsNullOrEmpty(registration.MobileNo))
                                    {
                                            <div class="odd-info-detail">
                                                <i class="fas fa-phone me-1 text-success"></i>
                                                <span>@registration.MobileNo</span>
                                            </div>
                                    }

                                        <!-- Account -->
                                    @if (!string.IsNullOrEmpty(registration.AccountNo))
                                    {
                                            <div class="odd-info-detail">
                                                <i class="fas fa-university me-1 text-info"></i>
                                                <span class="text-muted">@registration.AccountNo</span>
                                            </div>
                                    }
                                    </div>
                                </td>

                                <!-- Branch Information -->
                                <td class="odd-cell-branch">
                                @if (registration.Branch != null)
                                {
                                        <div class="odd-info-block @(isThaiCulture ? "odd-thai-font" : "")">
                                            <div class="odd-info-primary">
                                                @registration.Branch.GetLocalizedName(Context)
                                            </div>

                                        @if (!string.IsNullOrEmpty(registration.Branch.GetLocalizedAddress(Context)))
                                        {
                                                <div class="odd-info-secondary">
                                                    @registration.Branch.GetLocalizedAddress(Context)
                                                </div>
                                        }

                                        @if (!string.IsNullOrEmpty(registration.Branch.Code))
                                        {
                                                <div class="odd-info-detail">
                                                    <span class="odd-badge bg-secondary">@registration.Branch.Code</span>
                                                </div>
                                        }
                                        </div>
                                }
                                else
                                {
                                        <span class="text-muted">@Localizer["NoBranchAssigned"]</span>
                                }
                                </td>

                                <!-- OTAC Details -->
                                <td class="odd-cell-otac">
                                    <div class="odd-info-block @(isThaiCulture ? "odd-thai-font" : "")">
                                        <!-- OTAC Code -->
                                    @if (!string.IsNullOrEmpty(registration.OtacCode))
                                    {
                                            <div class="mb-2">
                                                <code class="odd-otac-code" title="@Localizer["ClickToCopy"]">@registration.OtacCode</code>
                                            </div>
                                    }

                                        <!-- OTAC Status -->
                                    @if (!string.IsNullOrEmpty(registration.OtacState))
                                    {
                                            <div class="mb-2">
                                                @registration.OtacState.GetLocalizedOtacStatus(Context)
                                            </div>
                                    }

                                        <!-- Expires At -->
                                    @if (registration.OtacExpiresAt.HasValue)
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-clock odd-timeline-icon text-warning"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Context.GetExpiryLabel()</div>
                                                    <div class="odd-timeline-value">@registration.OtacExpiresAt.Value.ToLocalizedString(Context)</div>
                                                    <div class="odd-timeline-time">@registration.OtacExpiresAt.Value.ToRelativeTimeString(Context)</div>
                                                </div>
                                            </div>
                                    }
                                    </div>
                                </td>

                                <!-- Registration Status -->
                                <td class="odd-cell-status">
                                    <div class="odd-info-block @(isThaiCulture ? "odd-thai-font" : "")">
                                        <!-- Status Badge -->
                                        <div class="mb-2">
                                            @registration.Status.GetLocalizedRegistrationStatus(Context)
                                        </div>

                                        <!-- Return Code -->
                                    @if (!string.IsNullOrEmpty(registration.ReturnCode))
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-code odd-timeline-icon text-info"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Localizer["Code"]</div>
                                                    <div class="odd-timeline-value font-monospace">@registration.ReturnCode</div>
                                                </div>
                                            </div>
                                    }

                                        <!-- Reg ID -->
                                    @if (!string.IsNullOrEmpty(registration.RegId))
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-id-badge odd-timeline-icon text-primary"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Localizer["RegistrationId"]</div>
                                                    <div class="odd-timeline-value font-monospace text-primary">@registration.RegId</div>
                                                </div>
                                            </div>
                                    }

                                        <!-- ESPA ID -->
                                    @if (!string.IsNullOrEmpty(registration.EspaId))
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-fingerprint odd-timeline-icon text-success"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Localizer["EspaId"]</div>
                                                    <div class="odd-timeline-value font-monospace text-success">@registration.EspaId</div>
                                                </div>
                                            </div>
                                    }
                                    </div>
                                </td>

                                <!-- Tracking Info -->
                                <td class="odd-cell-tracking">
                                    <div class="odd-info-block @(isThaiCulture ? "odd-thai-font" : "")">
                                        <!-- User Information -->
                                    @if (registration.GeneratedByUserId > 0)
                                    {
                                            <div class="odd-user-info mb-2">
                                                <div class="odd-user-avatar @(registration.GeneratedByUser.IsOnline(TimeSpan.FromMinutes(15)) ? "online" : "")">
                                                    @registration.GeneratedByUser.GetAvatarInitials()
                                                </div>
                                                <div class="odd-user-details">
                                                    <div class="odd-user-name">@registration.GeneratedByUser.GetDisplayName()</div>
                                                    <div class="odd-user-role">@registration.GeneratedByUser.GetRoleDisplayName(Context)</div>
                                                </div>
                                            </div>
                                    }

                                        <!-- Attempt Count -->
                                    @if (registration.AttemptCount > 0)
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-redo odd-timeline-icon text-warning"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Context.GetAttemptsLabel()</div>
                                                    <div class="odd-timeline-value">
                                                        <span class="odd-badge odd-badge-warning">@registration.AttemptCount</span>
                                                    </div>
                                                </div>
                                            </div>
                                    }

                                        <!-- Created At -->
                                        <div class="odd-timeline-item">
                                            <i class="fas fa-plus-circle odd-timeline-icon text-success"></i>
                                            <div class="odd-timeline-content">
                                                <div class="odd-timeline-label">@Context.GetCreatedLabel()</div>
                                                <div class="odd-timeline-value">@registration.CreatedAt.ToLocalizedString(Context)</div>
                                                <div class="odd-timeline-time">@registration.CreatedAt.ToRelativeTimeString(Context)</div>
                                            </div>
                                        </div>

                                        <!-- Updated At -->
                                    @if (registration.UpdatedAt.HasValue)
                                    {
                                            <div class="odd-timeline-item">
                                                <i class="fas fa-edit odd-timeline-icon text-info"></i>
                                                <div class="odd-timeline-content">
                                                    <div class="odd-timeline-label">@Context.GetUpdatedLabel()</div>
                                                    <div class="odd-timeline-value">@registration.UpdatedAt.Value.ToLocalizedString(Context)</div>
                                                    <div class="odd-timeline-time">@registration.UpdatedAt.Value.ToRelativeTimeString(Context)</div>
                                                </div>
                                            </div>
                                    }
                                    </div>
                                </td>
                            </tr>
                    }
                    </tbody>
                </table>
        }
        else
        {
                <div class="odd-empty-state">
                    <div class="odd-empty-icon">
                        <i class="fas fa-database"></i>
                    </div>
                    <h5 class="odd-empty-title">@Localizer["NoDataMessage"]</h5>
                    <p class="odd-empty-message">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                            <span>@Localizer["NoDataWithFilters"]</span>
                    }
                    else
                    {
                            <span>@Localizer["NoDataWithoutFilters"]</span>
                    }
                    </p>
                    <div class="odd-empty-actions">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                            <a asp-action="Index" class="btn btn-outline-primary">
                                <i class="fas fa-times me-1"></i>@Localizer["ClearFilters"]
                            </a>
                    }
                    </div>
                </div>
        }
        </div>

        <!-- Mobile Card View -->
        <div class="odd-mobile-cards d-none">
        @if (Model.Registrations.Any())
        {
            @foreach (var registration in Model.Registrations)
            {
                    <div class="odd-mobile-card odd-fade-in">
                        <div class="odd-mobile-card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input row-checkbox me-2" 
                                           value="@registration.Id" aria-label="Select registration @registration.Id">
                                @if (!string.IsNullOrEmpty(registration.ExternalReference))
                                {
                                        <strong class="text-primary">@registration.ExternalReference</strong>
                                }
                                else
                                {
                                        <strong class="text-muted">#@registration.Id</strong>
                                }
                                </div>
                                <div>
                                    @registration.Status.GetLocalizedRegistrationStatus(Context)
                                </div>
                            </div>
                        </div>

                        <div class="odd-mobile-card-body">
                            <!-- Customer Info -->
                        @if (!string.IsNullOrEmpty(registration.FullName))
                        {
                                <div class="odd-mobile-field">
                                    <div class="odd-mobile-label">
                                        <i class="fas fa-user me-1"></i>@Localizer["Customer"]
                                    </div>
                                    <div class="odd-mobile-value">
                                        <div class="fw-semibold">@registration.FullName</div>
                                    @if (!string.IsNullOrEmpty(registration.MobileNo))
                                    {
                                            <div class="small text-muted">@registration.MobileNo</div>
                                    }
                                    </div>
                                </div>
                        }

                            <!-- OTAC Code -->
                        @if (!string.IsNullOrEmpty(registration.OtacCode))
                        {
                                <div class="odd-mobile-field">
                                    <div class="odd-mobile-label">
                                        <i class="fas fa-key me-1"></i>OTAC
                                    </div>
                                    <div class="odd-mobile-value">
                                        <code class="odd-otac-code">@registration.OtacCode</code>
                                    </div>
                                </div>
                        }

                            <!-- Branch -->
                        @if (registration.Branch != null)
                        {
                                <div class="odd-mobile-field">
                                    <div class="odd-mobile-label">
                                        <i class="fas fa-building me-1"></i>@Localizer["Branch"]
                                    </div>
                                    <div class="odd-mobile-value">
                                        @registration.Branch.GetLocalizedName(Context)
                                    </div>
                                </div>
                        }

                            <!-- Created -->
                            <div class="odd-mobile-field">
                                <div class="odd-mobile-label">
                                    <i class="fas fa-calendar me-1"></i>@Context.GetCreatedLabel()
                                </div>
                                <div class="odd-mobile-value">
                                    <div class="small">@registration.CreatedAt.ToLocalizedString(Context)</div>
                                    <div class="small text-muted">@registration.CreatedAt.ToRelativeTimeString(Context)</div>
                                </div>
                            </div>
                        </div>
                    </div>
            }
        }
        </div>

    @if (Model.Registrations.Any())
    {
            <!-- Pagination -->
            <div class="odd-pagination-container">
                <div class="odd-pagination-content">
                    <div class="odd-pagination-info">
                        <span class="text-muted">
                            @string.Format(Localizer["ShowingEntries"], Model.StartRecord, Model.EndRecord, Model.TotalRecords)
                        </span>
                    </div>

                @if (Model.TotalPages > 1)
                {
                        <nav class="odd-pagination-nav" aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new {
                                    page = Model.CurrentPage - 1,
                                    pageSize = Model.PageSize,
                                    status = Model.StatusFilter,
                                    search = Model.SearchQuery
                                })">
                                        <i class="fas fa-chevron-left"></i> @Localizer["Previous"]
                                    </a>
                                </li>

                            @{
                                var startPage = Math.Max(1, Model.CurrentPage - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                            }

                            @if (startPage > 1)
                            {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new {
                                        page = 1,
                                        pageSize = Model.PageSize,
                                        status = Model.StatusFilter,
                                        search = Model.SearchQuery
                                    })">1</a>
                                    </li>
                                @if (startPage > 2)
                                {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                }
                            }

                            @for (var i = startPage; i <= endPage; i++)
                            {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new {
                                        page = i,
                                        pageSize = Model.PageSize,
                                        status = Model.StatusFilter,
                                        search = Model.SearchQuery
                                    })">@i</a>
                                    </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                }
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new {
                                        page = Model.TotalPages,
                                        pageSize = Model.PageSize,
                                        status = Model.StatusFilter,
                                        search = Model.SearchQuery
                                    })">@Model.TotalPages</a>
                                    </li>
                            }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new {
                                    page = Model.CurrentPage + 1,
                                    pageSize = Model.PageSize,
                                    status = Model.StatusFilter,
                                    search = Model.SearchQuery
                                })">
                                        @Localizer["Next"] <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                }
                </div>
            </div>
    }
    </div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="~/js/odd-registrations.js" asp-append-version="true"></script>
    <script src="~/js/odd-registration-modern.js" asp-append-version="true"></script>
    <script>
        // Additional safety measures for OTAC generation
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, checking OTAC function availability');
            console.log('generateOtacImmediately function exists:', typeof window.generateOtacImmediately);
            
            // Add backup event listener
            const generateButton = document.getElementById('generateOtacButton');
            if (generateButton) {
                console.log('Generate OTAC button found');
                
                // Add additional click handler as backup
                generateButton.addEventListener('click', function(e) {
                    console.log('Button clicked via event listener');
                    
                    // Prevent double execution if onclick also fires
                    if (e.detail === 'backup-handler') {
                        if (typeof window.generateOtacImmediately === 'function') {
                            console.log('Calling generateOtacImmediately from backup handler');
                            window.generateOtacImmediately();
                        } else {
                            console.error('generateOtacImmediately function not found!');
                            alert('เกิดข้อผิดพลาด: ไม่พบฟังก์ชันสร้าง OTAC กรุณาโหลดหน้าใหม่');
                        }
                    }
                });

                // Test function availability on button hover
                generateButton.addEventListener('mouseenter', function() {
                    if (typeof window.generateOtacImmediately !== 'function') {
                        console.error('generateOtacImmediately function not available on hover!');
                        this.title = 'ฟังก์ชันไม่พร้อมใช้งาน - กรุณาโหลดหน้าใหม่';
                        this.classList.add('btn-warning');
                        this.classList.remove('btn-success');
                    } else {
                        this.title = 'คลิกเพื่อสร้าง OTAC Code';
                    }
                });
            } else {
                console.error('Generate OTAC button not found!');
            }
        });

        // Global error handler for unhandled promise rejections
        window.addEventListener('unhandledrejection', function(event) {
            console.error('Unhandled promise rejection:', event.reason);
            if (event.reason && event.reason.message && event.reason.message.includes('generateOtacImmediately')) {
                alert('เกิดข้อผิดพลาดในการสร้าง OTAC Code กรุณาลองใหม่อีกครั้ง');
            }
        });
    </script>
}