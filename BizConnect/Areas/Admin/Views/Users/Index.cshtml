@model IEnumerable<User>
@{
    ViewData["Title"] = "User Management";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="bc-data-table-container">
    <!-- Page Header -->
    <div class="bc-page-header bc-fade-in">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="bc-page-title-section">
                    <h1 class="bc-page-title">
                        <i class="fas fa-users me-3"></i>User Management
                    </h1>
                    <p class="bc-page-subtitle">
                        Manage user accounts, roles, and permissions across the BizConnect platform
                    </p>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <div class="bc-page-actions">
                    <button class="btn btn-outline-secondary me-2 bc-ripple" onclick="exportUsers()">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                    <a asp-controller="Users" asp-action="Create" asp-area="Admin" class="btn btn-primary bc-ripple">
                        <i class="fas fa-plus me-2"></i>Create New User
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bc-slide-in-down" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bc-slide-in-down" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Data Table Controls -->
    <div class="bc-table-controls bc-slide-in-up">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="bc-search-box">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control" id="userSearch" placeholder="Search users..." autocomplete="off">
                        <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="roleFilter">
                    <option value="">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="User">User</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="entriesPerPage">
                    <option value="10">10 per page</option>
                    <option value="25" selected>25 per page</option>
                    <option value="50">50 per page</option>
                    <option value="100">100 per page</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="bc-bulk-actions">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" disabled id="bulkActionsBtn">
                            <i class="fas fa-tasks me-1"></i>Bulk Actions
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" onclick="bulkAction('activate')">
                                <i class="fas fa-check me-2"></i>Activate Selected
                            </a></li>
                            <li><a class="dropdown-item" href="#" onclick="bulkAction('deactivate')">
                                <i class="fas fa-times me-2"></i>Deactivate Selected
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" onclick="bulkAction('delete')">
                                <i class="fas fa-trash me-2"></i>Delete Selected
                            </a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Data Table -->
    <div class="bc-data-table-card bc-slide-in-up" style="animation-delay: 0.2s;">
        <div class="bc-table-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="bc-table-info">
                    <h3 class="bc-table-title">
                        <i class="fas fa-users me-2"></i>All Users
                    </h3>
                    <p class="bc-table-subtitle" id="tableInfo">
                        Showing <span id="showingCount">0</span> of <span id="totalCount">@Model.Count()</span> users
                    </p>
                </div>
                <div class="bc-table-actions">
                    <button class="btn btn-outline-secondary btn-sm me-2" onclick="refreshTable()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                    <div class="btn-group" role="group">
                        <button class="btn btn-outline-secondary btn-sm" onclick="toggleView('table')" id="tableViewBtn">
                            <i class="fas fa-table"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="toggleView('grid')" id="gridViewBtn">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="bc-table-content">
            <!-- Table View -->
            <div id="tableView" class="bc-table-view">
                <div class="table-responsive">
                    <table class="table bc-interactive-table" id="usersTable">
                        <thead class="bc-table-head">
                            <tr>
                                <th class="bc-checkbox-column">
                                    <div class="bc-checkbox-group">
                                        <input type="checkbox" class="bc-checkbox" id="selectAll">
                                        <label for="selectAll" class="bc-checkbox-label">
                                            <span class="bc-checkbox-indicator"></span>
                                        </label>
                                    </div>
                                </th>
                                <th class="bc-sortable" data-sort="id">
                                    ID <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-sortable" data-sort="username">
                                    Username <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-sortable" data-sort="role">
                                    Role <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-sortable" data-sort="status">
                                    Status <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-sortable" data-sort="created">
                                    Created <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-sortable" data-sort="updated">
                                    Last Updated <i class="fas fa-sort bc-sort-icon"></i>
                                </th>
                                <th class="bc-actions-column">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bc-table-body">
                            @foreach (var user in Model)
                            {
                                <tr class="bc-table-row" data-user-id="@user.Id" data-username="@user.Username" data-role="@user.Role" data-status="@(user.IsActive ? "active" : "inactive")">
                                    <td class="bc-checkbox-column">
                                        <div class="bc-checkbox-group">
                                            <input type="checkbox" class="bc-checkbox row-checkbox" id="user_@user.Id" value="@user.Id">
                                            <label for="user_@user.Id" class="bc-checkbox-label">
                                                <span class="bc-checkbox-indicator"></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td class="bc-id-column">
                                        <span class="bc-id-badge">#@user.Id</span>
                                    </td>
                                    <td class="bc-username-column">
                                        <div class="bc-user-info">
                                            <div class="bc-user-avatar">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="bc-user-details">
                                                <div class="bc-username">@user.Username</div>
                                                @if (user.Id == 1)
                                                {
                                                    <div class="bc-user-meta">
                                                        <span class="bc-badge bc-badge-warning">
                                                            <i class="fas fa-crown me-1"></i>Default Admin
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="bc-role-column">
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="bc-badge bc-badge-admin">
                                                <i class="fas fa-user-shield me-1"></i>Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bc-badge bc-badge-user">
                                                <i class="fas fa-user me-1"></i>User
                                            </span>
                                        }
                                    </td>
                                    <td class="bc-status-column">
                                        @if (user.IsActive)
                                        {
                                            <span class="bc-status bc-status-active">
                                                <i class="fas fa-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bc-status bc-status-inactive">
                                                <i class="fas fa-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="bc-date-column">
                                        <div class="bc-date-info">
                                            <div class="bc-date">@user.CreatedAt.ToString("MMM dd, yyyy")</div>
                                            <div class="bc-time">@user.CreatedAt.ToString("HH:mm")</div>
                                        </div>
                                    </td>
                                    <td class="bc-date-column">
                                        <div class="bc-date-info">
                                            <div class="bc-date">@user.UpdatedAt.ToString("MMM dd, yyyy")</div>
                                            <div class="bc-time">@user.UpdatedAt.ToString("HH:mm")</div>
                                        </div>
                                    </td>
                                    <td class="bc-actions-column">
                                        <div class="bc-action-buttons">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle bc-ripple" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" asp-area="Admin">
                                                            <i class="fas fa-edit me-2"></i>Edit User
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-controller="Users" asp-action="ResetPassword" asp-route-id="@user.Id" asp-area="Admin">
                                                            <i class="fas fa-key me-2"></i>Reset Password
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" href="#" onclick="toggleUserStatus(@user.Id, @user.IsActive.ToString().ToLower())">
                                                            @if (user.IsActive)
                                                            {
                                                                <i class="fas fa-pause me-2"></i>Deactivate
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-play me-2"></i>Activate
                                                            }
                                                        </a>
                                                    </li>
                                                    @if (user.Id != 1)
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item text-danger" href="#" onclick="confirmDelete(@user.Id, '@user.Username')">
                                                                <i class="fas fa-trash me-2"></i>Delete User
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.Any())
                {
                    <div class="bc-empty-state">
                        <div class="bc-empty-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="bc-empty-title">No users found</h3>
                        <p class="bc-empty-text">Get started by creating your first user account.</p>
                        <a asp-controller="Users" asp-action="Create" asp-area="Admin" class="btn btn-primary bc-ripple">
                            <i class="fas fa-plus me-2"></i>Create First User
                        </a>
                    </div>
                }
            </div>

            <!-- Grid View -->
            <div id="gridView" class="bc-grid-view" style="display: none;">
                <div class="row g-4" id="usersGrid">
                    @foreach (var user in Model)
                    {
                        <div class="col-md-6 col-lg-4 col-xl-3 bc-grid-item" data-user-id="@user.Id" data-username="@user.Username" data-role="@user.Role" data-status="@(user.IsActive ? "active" : "inactive")">
                            <div class="bc-user-card bc-tilt bc-ripple">
                                <div class="bc-user-card-header">
                                    <div class="bc-user-avatar-large">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="bc-user-card-actions">
                                        <div class="bc-checkbox-group">
                                            <input type="checkbox" class="bc-checkbox grid-checkbox" id="grid_user_@user.Id" value="@user.Id">
                                            <label for="grid_user_@user.Id" class="bc-checkbox-label">
                                                <span class="bc-checkbox-indicator"></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="bc-user-card-body">
                                    <h5 class="bc-user-card-name">@user.Username</h5>
                                    <div class="bc-user-card-meta">
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="bc-badge bc-badge-admin">
                                                <i class="fas fa-user-shield me-1"></i>Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bc-badge bc-badge-user">
                                                <i class="fas fa-user me-1"></i>User
                                            </span>
                                        }
                                        @if (user.IsActive)
                                        {
                                            <span class="bc-status bc-status-active">
                                                <i class="fas fa-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bc-status bc-status-inactive">
                                                <i class="fas fa-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </div>
                                    <div class="bc-user-card-info">
                                        <div class="bc-info-item">
                                            <span class="bc-info-label">Created:</span>
                                            <span class="bc-info-value">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="bc-info-item">
                                            <span class="bc-info-label">Updated:</span>
                                            <span class="bc-info-value">@user.UpdatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="bc-user-card-footer">
                                    <div class="btn-group w-100" role="group">
                                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" asp-area="Admin" class="btn btn-sm btn-outline-primary bc-ripple">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Users" asp-action="ResetPassword" asp-route-id="@user.Id" asp-area="Admin" class="btn btn-sm btn-outline-warning bc-ripple">
                                            <i class="fas fa-key"></i>
                                        </a>
                                        @if (user.Id != 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger bc-ripple" onclick="confirmDelete(@user.Id, '@user.Username')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="bc-table-footer">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="bc-pagination-info">
                        Showing <span id="paginationStart">1</span> to <span id="paginationEnd">25</span> of <span id="paginationTotal">@Model.Count()</span> entries
                    </div>
                </div>
                <div class="col-md-6">
                    <nav aria-label="User pagination">
                        <ul class="pagination justify-content-end mb-0" id="paginationControls">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" onclick="changePage('prev')">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active">
                                <a class="page-link" href="#" onclick="changePage(1)">1</a>
                            </li>
                            <li class="page-item disabled">
                                <a class="page-link" href="#" onclick="changePage('next')">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="tableLoadingOverlay" class="bc-loading-overlay" style="display: none;">
        <div class="bc-loading-content">
            <div class="bc-spinner bc-spinner-lg"></div>
            <div class="bc-loading-text">Loading users...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Interactive Data Table Management
        class BizConnectDataTable {
            constructor() {
                this.currentPage = 1;
                this.itemsPerPage = 25;
                this.currentSort = { column: null, direction: 'asc' };
                this.currentView = 'table';
                this.selectedUsers = new Set();
                this.init();
            }

            init() {
                this.setupEventListeners();
                this.updateTableInfo();
            }

            setupEventListeners() {
                // Search functionality
                const searchInput = document.getElementById('userSearch');
                if (searchInput) {
                    searchInput.addEventListener('input', () => this.filterTable());
                }

                // Filter dropdowns
                const roleFilter = document.getElementById('roleFilter');
                const statusFilter = document.getElementById('statusFilter');
                if (roleFilter) roleFilter.addEventListener('change', () => this.filterTable());
                if (statusFilter) statusFilter.addEventListener('change', () => this.filterTable());

                // Items per page
                const entriesSelect = document.getElementById('entriesPerPage');
                if (entriesSelect) {
                    entriesSelect.addEventListener('change', (e) => {
                        this.itemsPerPage = parseInt(e.target.value);
                        this.currentPage = 1;
                        this.filterTable();
                    });
                }

                // Sortable columns
                document.querySelectorAll('.bc-sortable').forEach(header => {
                    header.addEventListener('click', () => {
                        this.sortTable(header.dataset.sort);
                    });
                });

                // Select all checkbox
                const selectAllCheckbox = document.getElementById('selectAll');
                if (selectAllCheckbox) {
                    selectAllCheckbox.addEventListener('change', (e) => {
                        this.toggleSelectAll(e.target.checked);
                    });
                }

                // Individual checkboxes
                document.addEventListener('change', (e) => {
                    if (e.target.classList.contains('row-checkbox') || e.target.classList.contains('grid-checkbox')) {
                        this.toggleUserSelection(e.target.value, e.target.checked);
                    }
                });
            }

            filterTable() {
                const searchTerm = document.getElementById('userSearch')?.value.toLowerCase() || '';
                const roleFilter = document.getElementById('roleFilter')?.value || '';
                const statusFilter = document.getElementById('statusFilter')?.value || '';

                const rows = document.querySelectorAll('.bc-table-row, .bc-grid-item');
                let visibleCount = 0;

                rows.forEach(row => {
                    const username = row.dataset.username?.toLowerCase() || '';
                    const role = row.dataset.role || '';
                    const status = row.dataset.status || '';

                    const matchesSearch = username.includes(searchTerm);
                    const matchesRole = !roleFilter || role === roleFilter;
                    const matchesStatus = !statusFilter || status === statusFilter;

                    if (matchesSearch && matchesRole && matchesStatus) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                this.updateTableInfo(visibleCount);
            }

            sortTable(column) {
                if (this.currentSort.column === column) {
                    this.currentSort.direction = this.currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    this.currentSort.column = column;
                    this.currentSort.direction = 'asc';
                }

                const tbody = document.querySelector('.bc-table-body');
                if (!tbody) return;

                const rows = Array.from(tbody.querySelectorAll('.bc-table-row'));

                rows.sort((a, b) => {
                    let aVal = this.getCellValue(a, column);
                    let bVal = this.getCellValue(b, column);

                    if (column === 'id') {
                        aVal = parseInt(aVal);
                        bVal = parseInt(bVal);
                    }

                    if (aVal < bVal) return this.currentSort.direction === 'asc' ? -1 : 1;
                    if (aVal > bVal) return this.currentSort.direction === 'asc' ? 1 : -1;
                    return 0;
                });

                rows.forEach(row => tbody.appendChild(row));
                this.updateSortIcons();
            }

            getCellValue(row, column) {
                switch(column) {
                    case 'id': return row.dataset.userId;
                    case 'username': return row.dataset.username;
                    case 'role': return row.dataset.role;
                    case 'status': return row.dataset.status;
                    default: return '';
                }
            }

            updateSortIcons() {
                document.querySelectorAll('.bc-sort-icon').forEach(icon => {
                    icon.className = 'fas fa-sort bc-sort-icon';
                });

                const activeHeader = document.querySelector(`[data-sort="${this.currentSort.column}"] .bc-sort-icon`);
                if (activeHeader) {
                    activeHeader.className = `fas fa-sort-${this.currentSort.direction === 'asc' ? 'up' : 'down'} bc-sort-icon bc-sort-active`;
                }
            }

            updateTableInfo(visibleCount = null) {
                const totalRows = document.querySelectorAll('.bc-table-row, .bc-grid-item').length;
                const showing = visibleCount !== null ? visibleCount : totalRows;

                const showingElement = document.getElementById('showingCount');
                const totalElement = document.getElementById('totalCount');

                if (showingElement) showingElement.textContent = showing;
                if (totalElement) totalElement.textContent = totalRows;
            }

            toggleSelectAll(checked) {
                const checkboxes = document.querySelectorAll('.row-checkbox, .grid-checkbox');
                checkboxes.forEach(checkbox => {
                    if (checkbox.closest('.bc-table-row, .bc-grid-item').style.display !== 'none') {
                        checkbox.checked = checked;
                        this.toggleUserSelection(checkbox.value, checked);
                    }
                });
            }

            toggleUserSelection(userId, selected) {
                if (selected) {
                    this.selectedUsers.add(userId);
                } else {
                    this.selectedUsers.delete(userId);
                }

                const bulkBtn = document.getElementById('bulkActionsBtn');
                if (bulkBtn) {
                    bulkBtn.disabled = this.selectedUsers.size === 0;

                    if (this.selectedUsers.size > 0) {
                        bulkBtn.innerHTML = `<i class="fas fa-tasks me-1"></i>Bulk Actions (${this.selectedUsers.size})`;
                    } else {
                        bulkBtn.innerHTML = '<i class="fas fa-tasks me-1"></i>Bulk Actions';
                    }
                }
            }
        }

        // Initialize data table
        let dataTable;
        document.addEventListener('DOMContentLoaded', function() {
            dataTable = new BizConnectDataTable();
        });

        // Utility functions
        function toggleView(view) {
            const tableView = document.getElementById('tableView');
            const gridView = document.getElementById('gridView');
            const tableBtn = document.getElementById('tableViewBtn');
            const gridBtn = document.getElementById('gridViewBtn');

            if (view === 'table') {
                tableView.style.display = 'block';
                gridView.style.display = 'none';
                tableBtn.classList.add('active');
                gridBtn.classList.remove('active');
            } else {
                tableView.style.display = 'none';
                gridView.style.display = 'block';
                tableBtn.classList.remove('active');
                gridBtn.classList.add('active');
            }

            if (dataTable) dataTable.currentView = view;
        }

        function refreshTable() {
            const overlay = document.getElementById('tableLoadingOverlay');
            if (overlay) overlay.style.display = 'flex';

            setTimeout(() => {
                if (overlay) overlay.style.display = 'none';
                if (window.BizConnectLoading) {
                    BizConnectLoading.showToast('Table refreshed successfully!', {
                        type: 'success',
                        title: 'Refresh Complete'
                    });
                }
            }, 1500);
        }

        function clearSearch() {
            const searchInput = document.getElementById('userSearch');
            if (searchInput) {
                searchInput.value = '';
                if (dataTable) dataTable.filterTable();
            }
        }

        function exportUsers() {
            if (window.BizConnectLoading) {
                BizConnectLoading.showToast('Exporting user data...', {
                    type: 'info',
                    title: 'Export Started'
                });
            }
        }

        function bulkAction(action) {
            if (!dataTable || dataTable.selectedUsers.size === 0) return;

            const userCount = dataTable.selectedUsers.size;
            const actionText = action === 'delete' ? 'delete' : action;

            if (confirm(`Are you sure you want to ${actionText} ${userCount} selected user(s)?`)) {
                if (window.BizConnectLoading) {
                    BizConnectLoading.showToast(`${actionText} operation started for ${userCount} users`, {
                        type: action === 'delete' ? 'warning' : 'info',
                        title: 'Bulk Operation'
                    });
                }
            }
        }

        function toggleUserStatus(userId, isActive) {
            const action = isActive ? 'deactivate' : 'activate';
            if (confirm(`Are you sure you want to ${action} this user?`)) {
                if (window.BizConnectLoading) {
                    BizConnectLoading.showToast(`User ${action}d successfully!`, {
                        type: 'success',
                        title: 'Status Updated'
                    });
                }
            }
        }

        function confirmDelete(userId, username) {
            if (confirm(`Are you sure you want to delete user '${username}'? This action cannot be undone.`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", "Users", new { area = "Admin" })';

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'id';
                input.value = userId;
                form.appendChild(input);

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    form.appendChild(token.cloneNode());
                }

                document.body.appendChild(form);
                form.submit();
            }
        }

        function changePage(page) {
            // Pagination functionality would be implemented here
            console.log('Change page:', page);
        }
    </script>
}
