@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Localization
@using BizConnect.Extensions
@inject IStringLocalizer<SharedResources> Localizer

@{
    var isThaiCulture = Context.IsThaiCulture();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="@(isThaiCulture ? Html.Raw("th") : Html.Raw("en"))" data-admin-theme="modern">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Html.AntiForgeryToken()
    <title>@ViewData["Title"] - BizConnect Admin</title>

    <!-- PWA Meta Tags -->
    <meta name="description" content="BizConnect Admin Dashboard - Manage KBank ODD registrations, OTAC codes, and system operations" />
    <meta name="theme-color" content="#0066CC" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="BizConnect Admin" />
    <meta name="msapplication-TileColor" content="#0066CC" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16x16.png" />

    <!-- Preload Critical Resources -->
    <link rel="preload" href="~/css/modern-ui.css" as="style">
    <link rel="preload" href="~/css/components.css" as="style">
    <link rel="preload" href="~/js/modern-ui.js" as="script">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Core Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loading-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enhanced-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BizConnect.styles.css" asp-append-version="true" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Modern Admin Design System - External Stylesheet -->
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/button-size-fixes.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body" data-lang="@(isThaiCulture ? "th" : "en")">
    <!-- Skip Links for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay-modern d-none">
        <div class="loading-content">
            <div class="spinner-modern"></div>
            <div class="loading-text">@Localizer["Loading"]...</div>
        </div>
    </div>

    <!-- Top Navigation -->
    <nav class="admin-topbar">
        <div class="topbar-content">
            <div class="topbar-left">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>

                <a href="@Url.Action("Dashboard", "Home", new { area = "Admin" })" class="modern-brand">
                    <div class="modern-brand-icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <span class="brand-text">BizConnect Admin</span>
                </a>
            </div>

            <div class="topbar-right">
                <div class="topbar-actions">
                    <!-- Language Toggle -->
                    <button class="topbar-btn" title="Switch Language">
                        <i class="fas fa-language"></i>
                    </button>

                    <!-- Notifications -->
                    <button class="topbar-btn" title="@Localizer["Notifications"]">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </button>

                    <!-- Full Screen -->
                    <button class="topbar-btn" title="Full Screen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>

                <!-- User Menu -->
                <div class="user-menu" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">@(User.Identity?.Name?.Substring(0, 2).ToUpper() ?? "AD")</div>
                    <div class="user-info">
                        <div class="user-name">@(User.Identity?.Name ?? "Admin User")</div>
                        <div class="user-role">@Localizer["Administrator"]</div>
                    </div>
                    <i class="fas fa-chevron-down" style="color: var(--text-secondary); font-size: 0.8rem;"></i>
                </div>

                <!-- User Dropdown Menu -->
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <div class="dropdown-header">
                            <div class="fw-semibold">@(User.Identity?.Name ?? "Admin")</div>
                            <small class="text-muted">@Localizer["Administrator"]</small>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-area="">
                            <i class="fas fa-home me-2" aria-hidden="true"></i>@Localizer["BackToSite"]
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout" asp-area="">
                            <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>@Localizer["Logout"]
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <nav class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-header">
            <h5 class="sidebar-title">KBank ODD System</h5>
            <p class="sidebar-subtitle">Admin Dashboard</p>
        </div>

        <div class="sidebar-nav">
            <!-- Dashboard Section -->
            <div class="nav-section">
                <div class="nav-section-title">Dashboard</div>
                <div class="nav-item">
                    <a class="nav-link @(currentAction == "Dashboard" && currentController == "Home" ? "active" : "")"
                    asp-controller="Home" asp-action="Dashboard" asp-area="Admin">
                        <i class="fas fa-tachometer-alt"></i>
                        <span class="nav-text">@Localizer["Overview"]</span>
                    </a>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "Analytics" ? "active" : "")"
                           asp-controller="Analytics" asp-action="Dashboard" asp-area="Admin">
                            <i class="fas fa-chart-line"></i>
                            <span class="nav-text">@Localizer["Analytics"]</span>
                        </a>
                    </div>
                }
            </div>

            <!-- ODD Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">ODD Management</div>
                <div class="nav-item">
                    <a class="nav-link @(currentController == "OddRegistration" ? "active" : "")"
                       asp-controller="OddRegistration" asp-action="Index" asp-area="Admin">
                        <i class="fas fa-file-alt"></i>
                        <span class="nav-text">@Localizer["OddRegistrations"]</span>
                        @* <span class="badge bg-warning rounded-pill">12</span> *@
                    </a>
                </div>
            </div>

            @if (User.IsInRole("Admin"))
                {
                    <!-- User Management Section -->
            <div class="nav-section">
                <div class="nav-section-title">User Management</div>
                <div class="nav-item">
                    <a class="nav-link @(currentController == "Users" ? "active" : "")"
                       asp-controller="Users" asp-action="Index" asp-area="Admin">
                        <i class="fas fa-users"></i>
                        <span class="nav-text">@Localizer["AllUsers"]</span>
                    </a>
                </div>
            </div>
                }
            

            <!-- System Section -->
            @* <div class="nav-section">
                <div class="nav-section-title">System</div>
                <div class="nav-item">
                    <a class="nav-link" href="#" data-action="system-settings">
                        <i class="fas fa-cogs"></i>
                        <span class="nav-text">@Localizer["Settings"]</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link" href="#" data-action="export-data">
                        <i class="fas fa-download"></i>
                        <span class="nav-text">Export Data</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link" href="#" data-action="security-logs">
                        <i class="fas fa-shield-alt"></i>
                        <span class="nav-text">Security Logs</span>
                    </a>
                </div>
            </div> *@
        </div>
    </nav>

    <!-- Main Content -->
    <main class="admin-content" id="main-content" role="main">
        <!-- Content Header -->
        <div class="content-header glass-card mb-4 fade-in-up">
            <div class="content-header-wrapper">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="content-info">
                        <h1 class="content-title">@ViewData["Title"]</h1>
                        @if (!string.IsNullOrEmpty(ViewBag.Subtitle as string))
                        {
                            <p class="content-subtitle">@ViewBag.Subtitle</p>
                        }

                        <!-- Breadcrumb -->
                        <nav aria-label="@Localizer["Breadcrumb"]" class="breadcrumb-nav">
                            <ol class="breadcrumb breadcrumb-enhanced">
                                <li class="breadcrumb-item">
                                    <a asp-controller="Home" asp-action="Dashboard" asp-area="Admin"
                                       class="breadcrumb-link">
                                        <i class="fas fa-home me-1" aria-hidden="true"></i>
                                        @Localizer["Dashboard"]
                                    </a>
                                </li>
                                @{
                                    var breadcrumbSection = ViewBag.BreadcrumbSection as string;
                                    if (string.IsNullOrEmpty(breadcrumbSection))
                                    {
                                        // Auto-generate section based on controller
                                        switch (currentController?.ToLower())
                                        {
                                            case "users":
                                                breadcrumbSection = "User Management";
                                                break;
                                            case "otac":
                                                breadcrumbSection = "ODD Management";
                                                break;
                                            case "oddregistration":
                                                breadcrumbSection = "ODD Management";
                                                break;
                                            case "analytics":
                                                breadcrumbSection = "Analytics";
                                                break;
                                            default:
                                                if (currentAction != "Dashboard")
                                                {
                                                    breadcrumbSection = "System";
                                                }
                                                break;
                                        }
                                    }
                                }
                                @if (!string.IsNullOrEmpty(breadcrumbSection) && !(currentController == "Home" && currentAction == "Dashboard"))
                                {
                                    <li class="breadcrumb-item">
                                        <span class="breadcrumb-text">@breadcrumbSection</span>
                                    </li>
                                }
                                @if (!(currentController == "Home" && currentAction == "Dashboard"))
                                {
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <span class="breadcrumb-current">@ViewData["Title"]</span>
                                    </li>
                                }
                            </ol>
                        </nav>
                    </div>

                    @if (IsSectionDefined("HeaderActions"))
                    {
                        <div class="header-actions">
                            @await RenderSectionAsync("HeaderActions", required: false)
                        </div>
                    }
                    else
                    {
                        <!-- Default Actions -->
                        <div class="header-actions-default">
                            <button class="btn-modern btn-outline-modern" onclick="window.location.reload()"
                                    title="@Localizer["RefreshPage"]">
                                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                                <span class="d-none d-sm-inline">@Localizer["Refresh"]</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content" id="page-content">
            @RenderBody()
        </div>
    </main>

    <!-- Mobile Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <!-- Include Partial Views -->
    @await Html.PartialAsync("_OtacModals")
    @await Html.PartialAsync("_ExcelImportExportModal")
    @await Html.PartialAsync("_NotificationToast")

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <!-- Modern UI System -->
    <script src="~/js/modern-ui.js" asp-append-version="true"></script>

    <!-- Enhanced Animation and Interaction Systems -->
    <script src="~/js/interactions.js" asp-append-version="true"></script>
    <script src="~/js/visual-feedback.js" asp-append-version="true"></script>
    <script src="~/js/mobile-optimizer.js" asp-append-version="true"></script>
    <script src="~/js/accessibility-enhancer.js" asp-append-version="true"></script>

    <!-- Admin Core Modules -->
    <script src="~/js/admin/admin-core.js" asp-append-version="true"></script>
    <!-- admin-layout.js disabled - using inline implementation -->
    <script src="~/js/admin/admin-tables.js" asp-append-version="true"></script>

    <!-- Legacy Admin Scripts (maintaining compatibility) -->
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/real-time-updates.js" asp-append-version="true"></script>

    <!-- Supporting Scripts -->
    <script src="~/js/language-switcher.js" asp-append-version="true"></script>
    <script src="~/js/ui-interactions.js" asp-append-version="true"></script>
    <script src="~/js/performance-monitor.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Admin Layout Initialization -->
    <script>
        // Clean Admin Layout Initialization - Single Implementation
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize sidebar toggle functionality - Simple and Direct Implementation
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('adminSidebar');
            const content = document.querySelector('.admin-content');
            const overlay = document.getElementById('sidebarOverlay');

            if (!sidebarToggle || !sidebar || !content) {
                console.warn('Sidebar elements not found');
                return;
            }

            let isMobile = window.innerWidth <= 768;

            // Update mobile status
            function updateMobileStatus() {
                isMobile = window.innerWidth <= 768;
            }

            // Desktop toggle functionality
            function toggleDesktopSidebar() {
                const isCollapsed = sidebar.classList.contains('collapsed');

                if (isCollapsed) {
                    // Expand
                    sidebar.classList.remove('collapsed');
                    content.classList.remove('sidebar-collapsed');
                    const icon = sidebarToggle.querySelector('i');
                    if (icon) icon.className = 'fas fa-angle-left';
                    localStorage.setItem('admin-sidebar-collapsed', 'false');
                } else {
                    // Collapse
                    sidebar.classList.add('collapsed');
                    content.classList.add('sidebar-collapsed');
                    const icon = sidebarToggle.querySelector('i');
                    if (icon) icon.className = 'fas fa-bars';
                    localStorage.setItem('admin-sidebar-collapsed', 'true');
                }
            }

            // Mobile toggle functionality
            function toggleMobileSidebar() {
                const isOpen = sidebar.classList.contains('show');

                if (isOpen) {
                    // Close
                    sidebar.classList.remove('show');
                    if (overlay) overlay.classList.remove('show');
                    // Only restore overflow on mobile to prevent scroll interference
                    if (window.innerWidth <= 768) {
                        document.body.style.overflow = '';
                    }
                } else {
                    // Open
                    sidebar.classList.add('show');
                    if (overlay) overlay.classList.add('show');
                    // Only disable overflow on mobile to prevent background scroll
                    if (window.innerWidth <= 768) {
                        document.body.style.overflow = 'hidden';
                    }
                }
            }

            // Main toggle handler
            sidebarToggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                if (isMobile) {
                    toggleMobileSidebar();
                } else {
                    toggleDesktopSidebar();
                }
            });

            // Close mobile sidebar when clicking overlay
            if (overlay) {
                overlay.addEventListener('click', function() {
                    if (isMobile) {
                        sidebar.classList.remove('show');
                        overlay.classList.remove('show');
                        // Only restore overflow on mobile
                        if (window.innerWidth <= 768) {
                            document.body.style.overflow = '';
                        }
                    }
                });
            }

            // Close mobile sidebar with escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && isMobile && sidebar.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    if (overlay) overlay.classList.remove('show');
                    // Only restore overflow on mobile
                    if (window.innerWidth <= 768) {
                        document.body.style.overflow = '';
                    }
                }
            });

            // Handle window resize
            window.addEventListener('resize', function() {
                const wasMobile = isMobile;
                updateMobileStatus();

                if (wasMobile && !isMobile) {
                    // Switched to desktop - close mobile sidebar and restore state
                    sidebar.classList.remove('show');
                    if (overlay) overlay.classList.remove('show');
                    // Always restore overflow when switching to desktop
                    document.body.style.overflow = '';
                    restoreDesktopState();
                } else if (!wasMobile && isMobile) {
                    // Switched to mobile - remove desktop states
                    sidebar.classList.remove('collapsed');
                    content.classList.remove('sidebar-collapsed');
                    const icon = sidebarToggle.querySelector('i');
                    if (icon) icon.className = 'fas fa-bars';
                }
            });

            // Restore desktop sidebar state
            function restoreDesktopState() {
                if (!isMobile) {
                    const isCollapsed = localStorage.getItem('admin-sidebar-collapsed') === 'true';
                    if (isCollapsed) {
                        sidebar.classList.add('collapsed');
                        content.classList.add('sidebar-collapsed');
                        const icon = sidebarToggle.querySelector('i');
                        if (icon) icon.className = 'fas fa-bars';
                    } else {
                        sidebar.classList.remove('collapsed');
                        content.classList.remove('sidebar-collapsed');
                        const icon = sidebarToggle.querySelector('i');
                        if (icon) icon.className = 'fas fa-angle-left';
                    }
                }
            }

            // Initialize
            updateMobileStatus();
            restoreDesktopState();

            console.log('✅ Sidebar toggle initialized - Desktop and Mobile ready');

            // Initialize the admin core system
            if (window.AdminCore && !window.adminCore) {
                window.adminCore = new AdminCore();
                console.log('✨ BizConnect Modern Admin System Initialized');
            }

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Initialize popovers
            const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });

            // Setup global keyboard shortcuts
            document.addEventListener('keydown', function(e) {
                // Ctrl/Cmd + K for search
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    const searchInput = document.querySelector('.global-search-input, [data-search-global]');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }

                // Escape to close modals/dropdowns
                if (e.key === 'Escape') {
                    // Close any open dropdowns
                    document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                        const dropdown = bootstrap.Dropdown.getInstance(menu.previousElementSibling);
                        if (dropdown) dropdown.hide();
                    });
                }
            });

            // Setup notification system
            if (window.adminCore) {
                // Load initial notifications
                adminCore.getModule('layout')?.loadNotifications();

                // Setup periodic updates for real-time functionality
                if (window.RealTimeUpdates) {
                    window.RealTimeUpdates.forceUpdate('all');
                }
            }

            // Setup accessibility enhancements
            setupAccessibilityEnhancements();

            // Setup performance monitoring
            if (window.performance && window.performance.mark) {
                performance.mark('admin-layout-ready');
            }

            console.log('🚀 BizConnect Modern Admin Layout Ready - Sidebar Toggle Active');
        });

        // Accessibility enhancements
        function setupAccessibilityEnhancements() {
            // Skip link functionality
            const skipLink = document.querySelector('.skip-link');
            if (skipLink) {
                skipLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.focus();
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            }

            // Enhanced focus management for sidebar navigation
            const sidebarLinks = document.querySelectorAll('.sidebar-nav .nav-link');
            sidebarLinks.forEach(link => {
                link.addEventListener('focus', function() {
                    // Ensure parent section is visible
                    const section = this.closest('.nav-section');
                    if (section) {
                        section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
            });

            // Announce page changes to screen readers
            const pageTitle = document.title;
            if (pageTitle) {
                // Create or update live region for page announcements
                let announcer = document.getElementById('page-announcer');
                if (!announcer) {
                    announcer = document.createElement('div');
                    announcer.id = 'page-announcer';
                    announcer.className = 'sr-only';
                    announcer.setAttribute('aria-live', 'polite');
                    announcer.setAttribute('aria-atomic', 'true');
                    document.body.appendChild(announcer);
                }

                setTimeout(() => {
                    announcer.textContent = `Page loaded: ${pageTitle.split(' - ')[0]}`;
                }, 1000);
            }
        }

        // Error boundary for admin system
        window.addEventListener('error', function(e) {
            console.error('Admin System Error:', e.error);

            // Show user-friendly error message if available
            if (window.adminCore) {
                adminCore.showNotification('error', 'System Error',
                    'An error occurred. Please refresh the page or contact support if the issue persists.');
            }
        });

        // Network status monitoring
        function updateNetworkStatus(isOnline) {
            const statusIndicator = document.querySelector('.system-status .status-dot');
            const statusText = document.querySelector('.system-status span');

            if (statusIndicator && statusText) {
                if (isOnline) {
                    statusIndicator.className = 'fas fa-circle text-success status-dot';
                    statusText.textContent = '@Localizer["Online"]';
                } else {
                    statusIndicator.className = 'fas fa-circle text-danger status-dot';
                    statusText.textContent = '@Localizer["Offline"]';
                }
            }
        }

        // Network event listeners
        window.addEventListener('online', () => updateNetworkStatus(true));
        window.addEventListener('offline', () => updateNetworkStatus(false));

        // Initial network status
        updateNetworkStatus(navigator.onLine);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>