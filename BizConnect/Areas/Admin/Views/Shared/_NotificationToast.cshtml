<!-- Global Notification Toast Container -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="primaryToastContainer">
    <div id="notificationToast" class="toast enhanced-notification" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <div class="toast-icon me-2">
                <i id="toastIcon" class="fas fa-info-circle"></i>
            </div>
            <strong id="toastTitle" class="me-auto">Notification</strong>
            <small id="toastTime" class="text-muted">now</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastMessage">
            Default message
        </div>
    </div>
</div>

