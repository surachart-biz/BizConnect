</style>

<script>
    // Global Toast Notification System for Admin
    window.AdminNotifications = {
        // Enhanced show method with auto-dismiss and manual close
        show: function(message, options = {}) {
            const defaults = {
                type: 'info', // success, error, warning, info
                title: 'Notification',
                duration: 5000,
                icon: null,
                allowHtml: false,
                autoDismiss: true,
                showCloseButton: true,
                position: 'top-right', // top-right, top-left, bottom-right, bottom-left
                persistent: false // if true, won't auto-dismiss
            };
            
            const config = { ...defaults, ...options };
            
            // Override duration for persistent notifications
            if (config.persistent) {
                config.autoDismiss = false;
                config.duration = 0;
            }
            
            // Create unique toast element
            const toastId = 'toast_' + Date.now();
            const toastElement = this.createToastElement(toastId, message, config);
            
            // Add to container
            const container = document.getElementById('toastContainer');
            container.appendChild(toastElement);
            
            // Initialize Bootstrap toast with enhanced options
            const toastConfig = {
                delay: config.duration || 5000,
                autohide: config.autoDismiss && !config.persistent
            };
            
            const toast = new bootstrap.Toast(toastElement, toastConfig);
            
            // Add auto-dismiss class for progress bar animation
            if (config.autoDismiss && !config.persistent) {
                toastElement.classList.add('auto-dismiss');
            }
            
            // Show toast with enhanced animation
            toast.show();
            
            // Auto-remove after hiding
            toastElement.addEventListener('hidden.bs.toast', function() {
                toastElement.classList.add('hiding');
                setTimeout(() => {
                    if (toastElement.parentNode) {
                        toastElement.remove();
                    }
                }, 300);
            });
            
            // Add manual dismiss functionality
            if (config.showCloseButton) {
                const closeBtn = toastElement.querySelector('.btn-close');
                if (closeBtn) {
                    closeBtn.addEventListener('click', function() {
                        toast.hide();
                    });
                }
            }
            
            // Auto-dismiss with timeout (even if autohide is false)
            if (config.autoDismiss && config.duration > 0) {
                setTimeout(() => {
                    if (toastElement && toastElement.parentNode && !toastElement.classList.contains('hiding')) {
                        toast.hide();
                    }
                }, config.duration);
            }
            
            return { toast, element: toastElement };
        },
        
        // Create toast element
        createToastElement: function(id, message, config) {
            const iconMap = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-triangle',
                warning: 'fa-exclamation-circle',
                info: 'fa-info-circle'
            };
            
            const icon = config.icon || iconMap[config.type];
            
            const toastHtml = `
                <div id="${id}" class="toast toast-${config.type}" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header">
                        <div class="toast-icon me-2">
                            <i class="fas ${icon}"></i>
                        </div>
                        <strong class="me-auto">${this.escapeHtml(config.title)}</strong>
                        <small class="text-muted">now</small>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">
                        ${config.allowHtml ? message : this.escapeHtml(message)}
                    </div>
                </div>
            `;
            
            const wrapper = document.createElement('div');
            wrapper.innerHTML = toastHtml;
            return wrapper.firstElementChild;
        },
        
        // Escape HTML to prevent XSS
        escapeHtml: function(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        },
        
        // Enhanced convenience methods with auto-dismiss
        success: function(message, title = 'Success', options = {}) {
            return this.show(message, { 
                type: 'success', 
                title: title, 
                duration: 5000,
                autoDismiss: true,
                ...options 
            });
        },
        
        error: function(message, title = 'Error', options = {}) {
            return this.show(message, { 
                type: 'error', 
                title: title, 
                duration: 8000,
                autoDismiss: true,
                persistent: false,
                ...options 
            });
        },
        
        warning: function(message, title = 'Warning', options = {}) {
            return this.show(message, { 
                type: 'warning', 
                title: title, 
                duration: 6000,
                autoDismiss: true,
                ...options 
            });
        },
        
        info: function(message, title = 'Information', options = {}) {
            return this.show(message, { 
                type: 'info', 
                title: title,
                duration: 5000,
                autoDismiss: true,
                ...options 
            });
        },
        
        // New persistent notification method
        persistent: function(message, title = 'Important', type = 'info') {
            return this.show(message, {
                type: type,
                title: title,
                persistent: true,
                autoDismiss: false,
                showCloseButton: true
            });
        },
        
        // Clear all toasts
        clearAll: function() {
            const container = document.getElementById('toastContainer');
            const toasts = container.querySelectorAll('.toast');
            
            toasts.forEach(toast => {
                const bsToast = bootstrap.Toast.getInstance(toast);
                if (bsToast) {
                    bsToast.hide();
                } else {
                    toast.remove();
                }
            });
        }
    };
    
    // Make it globally available as a shorter alias
    window.notify = window.AdminNotifications;
    
    // Override the existing showAlert function to use the new toast system
    if (typeof showAlert !== 'undefined') {
        const originalShowAlert = showAlert;
        window.showAlert = function(type, message, title) {
            // Map old types to new system
            const typeMap = {
                'danger': 'error',
                'primary': 'info'
            };
            
            const mappedType = typeMap[type] || type;
            return AdminNotifications.show(message, { 
                type: mappedType, 
                title: title || (mappedType.charAt(0).toUpperCase() + mappedType.slice(1))
            });
        };
    }
    
    // Example usage for testing (remove in production)
    function testNotifications() {
        notify.success('Operation completed successfully!');
        setTimeout(() => notify.warning('This is a warning message'), 1000);
        setTimeout(() => notify.error('Something went wrong'), 2000);
        setTimeout(() => notify.info('Here is some information'), 3000);
    }
</script>