        font-size: 0.95rem;
        line-height: 1.5;
    }
    
    .toast-icon {
        width: 24px;
        height: 24px;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }
    
    /* Enhanced Success Toast */
    .toast.toast-success {
        background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
        border-left: 4px solid #2E7D32;
    }
    
    .toast.toast-success .toast-header {
