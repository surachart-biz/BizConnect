<!-- OTAC Action Buttons removed - functionality now available through page-specific controls -->

<script>
    // Priority 2: Enhanced Progressive OTAC Generation System
    class Priority2OtacSystem {
        constructor() {
            this.progressModal = null;
            this.resultsModal = null;
            this.progressInterval = null;
            this.countdownInterval = null;
            this.currentStep = 0;
            this.isGenerating = false;
            this.retryCount = 0;
            this.maxRetries = 3;
            
            // 4-Step Progress Configuration
            this.steps = [
                {
                    percentage: 0,
                    message: "กำลังเตรียมการสร้างรหัส...",
                    details: "ระบบกำลังเตรียมความพร้อมสำหรับการสร้างรหัสยืนยันตัวตนแบบใช้ครั้งเดียว",
                    icon: "fas fa-hourglass-start",
                    duration: 1000
                },
                {
                    percentage: 33,
                    message: "กำลังตรวจสอบความปลอดภัย...",
                    details: "ระบบกำลังตรวจสอบการรักษาความปลอดภัยและการเข้ารหัสข้อมูล",
                    icon: "fas fa-shield-alt",
                    duration: 1500
                },
                {
                    percentage: 66,
                    message: "กำลังสร้างรหัสยืนยัน...",
                    details: "กำลังสร้างรหัสยืนยันตัวตนที่ไม่ซ้ำและปลอดภัย",
                    icon: "fas fa-key",
                    duration: 1200
                },
                {
                    percentage: 100,
                    message: "เสร็จสิ้น!",
                    details: "สร้างรหัส OTAC เสร็จสิ้น พร้อมใช้งาน",
                    icon: "fas fa-check-circle",
                    duration: 800
                }
            ];
            
            this.init();
        }
        
        init() {
            this.setupModals();
            this.setupEventListeners();
            console.log('Priority 2 OTAC System initialized successfully');
        }
        
        setupModals() {
            this.progressModal = new bootstrap.Modal(document.getElementById('otacProgressModal'), {
                backdrop: 'static',
                keyboard: false
            });
            
            this.resultsModal = new bootstrap.Modal(document.getElementById('otacResultsModal'));
        }
        
        setupEventListeners() {
            // Connection status monitoring
            window.addEventListener('online', () => this.updateConnectionStatus(true));
            window.addEventListener('offline', () => this.updateConnectionStatus(false));
            
            // Modal cleanup
            document.getElementById('otacProgressModal').addEventListener('hidden.bs.modal', () => {
                this.cleanup();
            });
            
            // CRITICAL FIX: Auto-refresh table when results modal is closed
            document.getElementById('otacResultsModal').addEventListener('hidden.bs.modal', () => {
                this.stopCountdown();
                
                // Reset any button states
                const copyButton = document.getElementById('copyButton');
                if (copyButton) {
                    copyButton.classList.remove('copied');
                    copyButton.disabled = false;
                    copyButton.style.animation = '';
                }
                
                // Only refresh if OTAC was successfully generated
                const codeInput = document.getElementById('resultGeneratedCode');
                if (codeInput && codeInput.value && codeInput.value !== 'ERROR') {
                    console.log('Priority 2: Results modal closed with valid OTAC, triggering table refresh');
                    this.refreshTableAfterSuccess();
                }
            });
        }
        
        // Main generation function with full P2 features
        async generateOtac() {
            if (this.isGenerating) {
                console.log('OTAC generation already in progress');
                return;
            }
            
            this.isGenerating = true;
            this.retryCount = 0;
            
            try {
                // Show progress modal with enhanced loading
                this.showProgressModal();
                
                // Start 4-step progressive loading
                await this.runProgressiveLoading();
                
                // Perform actual OTAC generation
                const result = await this.performOtacGeneration();
                
                // Hide progress modal
                this.progressModal.hide();
                
                // Show results with full P2 features
                setTimeout(() => {
                    this.showResults(result);
                }, 300);
                
            } catch (error) {
                console.error('OTAC Generation Error:', error);
                this.handleError(error);
            }
        }
        
        showProgressModal() {
            this.progressModal.show();
            this.resetProgressState();
            this.updateConnectionStatus(navigator.onLine);
            
            // Initialize visual feedback
            if (window.visualFeedback) {
                window.visualFeedback.showToast('info', 'กำลังเริ่มต้น', 'เริ่มต้นการสร้างรหัส OTAC...', { duration: 2000 });
            }
        }
        
        async runProgressiveLoading() {
            return new Promise((resolve) => {
                let currentStepIndex = 0;
                const totalDuration = this.steps.reduce((sum, step) => sum + step.duration, 0);
                let elapsed = 0;
                
                const updateProgress = () => {
                    if (currentStepIndex >= this.steps.length) {
                        resolve();
                        return;
                    }
                    
                    const step = this.steps[currentStepIndex];
                    const remaining = Math.ceil((totalDuration - elapsed) / 1000);
                    
                    // Update UI elements
                    this.updateProgressBar(step.percentage);
                    this.updateStepMessage(step);
                    this.updateTimeEstimate(remaining);
                    
                    elapsed += step.duration;
                    currentStepIndex++;
                    
                    setTimeout(updateProgress, step.duration);
                };
                
                updateProgress();
            });
        }
        
        updateProgressBar(percentage) {
            const progressBar = document.getElementById('progressBarEnhanced');
            if (progressBar) {
                progressBar.style.width = percentage + '%';
                progressBar.setAttribute('aria-valuenow', percentage);
                
                // Add visual feedback
                if (percentage === 100 && window.visualFeedback) {
                    progressBar.classList.add('bg-success');
                }
            }
        }
        
        updateStepMessage(step) {
            const messageEl = document.getElementById('currentStepMessage');
            const detailsEl = document.getElementById('stepDetails');
            
            if (messageEl && detailsEl) {
                messageEl.innerHTML = `<i class="${step.icon} me-2 text-primary"></i>${step.message}`;
                detailsEl.textContent = step.details;
                
                // Add visual feedback animation
                messageEl.style.opacity = '0';
                setTimeout(() => {
                    messageEl.style.opacity = '1';
                    messageEl.style.transition = 'opacity 0.3s ease';
                }, 100);
            }
        }
        
        updateTimeEstimate(seconds) {
            const estimateEl = document.getElementById('estimatedSeconds');
            if (estimateEl) {
                estimateEl.textContent = seconds;
            }
        }
        
        async performOtacGeneration() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const generateUrl = '/Admin/Otac/GenerateForKBankOdd';
            
            if (!token) {
                throw new Error('ไม่พบ Security Token กรุณาโหลดหน้าใหม่');
            }
            
            // Create timeout controller
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 15000);
            
            try {
                const response = await fetch(generateUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(token)}`,
                    signal: controller.signal
                });
                
                clearTimeout(timeoutId);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                
                if (!data.success) {
                    throw new Error(data.message || 'เกิดข้อผิดพลาดในการสร้างรหัส');
                }
                
                return data;
                
            } catch (error) {
                clearTimeout(timeoutId);
                throw error;
            }
        }
        
        showResults(data) {
            // Populate result modal with P2 enhanced features
            this.populateResultsModal(data);
            
            // Show results modal
            this.resultsModal.show();
            
            // Start enhanced countdown with warnings
            this.startEnhancedCountdown(data.expiresAt);
            
            // Show success animation
            if (window.visualFeedback) {
                window.visualFeedback.showSuccessAnimation({
                    title: 'สำเร็จ!',
                    message: `สร้างรหัส OTAC เสร็จสิ้น: ${data.code || data.otacCode}`,
                    duration: 3000
                });
            }
            
            // CRITICAL FIX: Auto-refresh table after successful OTAC creation
            console.log('Priority 2: OTAC created successfully, triggering table refresh');
            this.refreshTableAfterSuccess();
            
            // Focus on code input for accessibility
            setTimeout(() => {
                const codeInput = document.getElementById('resultGeneratedCode');
                if (codeInput) {
                    codeInput.focus();
                    codeInput.select();
                }
            }, 500);
        }
        
        populateResultsModal(data) {
            const codeInput = document.getElementById('resultGeneratedCode');
            const expiryTimeEl = document.getElementById('resultExpiryTime');
            
            if (codeInput) {
                codeInput.value = data.code || data.otacCode || 'ERROR';
            }
            
            if (expiryTimeEl && data.expiresAt) {
                const expiryDate = new Date(data.expiresAt);
                const thaiMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 
                                 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
                
                const buddhistYear = expiryDate.getFullYear() + 543;
                const thaiFormattedDate = `${expiryDate.getDate()} ${thaiMonths[expiryDate.getMonth()]} ${buddhistYear} ${expiryDate.getHours().toString().padStart(2, '0')}:${expiryDate.getMinutes().toString().padStart(2, '0')}`;
                
                expiryTimeEl.textContent = thaiFormattedDate;
            }
        }
        
        startEnhancedCountdown(expiresAt) {
            if (this.countdownInterval) {
                clearInterval(this.countdownInterval);
            }
            
            const expiryDate = new Date(expiresAt);
            const countdownEl = document.getElementById('resultCountdown');
            let hasShown5MinWarning = false;
            let hasShown2MinWarning = false;
            let hasShown1MinWarning = false;
            
            this.countdownInterval = setInterval(() => {
                const now = new Date();
                const timeLeft = expiryDate - now;
                
                if (timeLeft <= 0) {
                    this.showExpiredState();
                    clearInterval(this.countdownInterval);
                    return;
                }
                
                const minutes = Math.floor(timeLeft / 60000);
                const seconds = Math.floor((timeLeft % 60000) / 1000);
                
                // Update countdown display with enhanced styling
                this.updateCountdownDisplay(countdownEl, minutes, seconds);
                
                // Enhanced warning system (5, 2, 1 minute warnings)
                if (minutes === 5 && seconds === 0 && !hasShown5MinWarning) {
                    this.showExpiryWarning('5 นาที', 'warning');
                    hasShown5MinWarning = true;
                }
                
                if (minutes === 2 && seconds === 0 && !hasShown2MinWarning) {
                    this.showExpiryWarning('2 นาที', 'warning');
                    hasShown2MinWarning = true;
                }
                
                if (minutes === 1 && seconds === 0 && !hasShown1MinWarning) {
                    this.showExpiryWarning('1 นาที', 'danger');
                    hasShown1MinWarning = true;
                }
                
                // Vibration for mobile devices
                if (minutes < 1 && seconds % 10 === 0 && navigator.vibrate) {
                    navigator.vibrate([100, 50, 100]);
                }
                
            }, 1000);
        }
        
        updateCountdownDisplay(element, minutes, seconds) {
            if (!element) return;
            
            let alertClass = 'alert-success';
            let icon = 'fas fa-clock';
            
            if (minutes < 2) {
                alertClass = 'alert-danger';
                icon = 'fas fa-exclamation-triangle';
            } else if (minutes < 5) {
                alertClass = 'alert-warning';
                icon = 'fas fa-hourglass-half';
            }
            
            element.innerHTML = `
                <div class="alert ${alertClass} border-0 py-2">
                    <i class="${icon} me-1"></i>เหลือ ${minutes} นาที ${seconds} วินาที
                </div>
            `;
        }
        
        showExpiryWarning(timeLeft, type) {
            const messages = {
                'warning': `รหัส OTAC จะหมดอายุในอีก ${timeLeft}`,
                'danger': `รหัส OTAC จะหมดอายุในอีก ${timeLeft} - กรุณาใช้งานด่วน!`
            };
            
            if (window.visualFeedback) {
                window.visualFeedback.showToast(type, 'แจ้งเตือนหมดอายุ', messages[type], { 
                    duration: 5000,
                    closable: true 
                });
            }
            
            // Browser notification if permission granted
            if (Notification.permission === 'granted') {
                new Notification('รหัส OTAC ใกล้หมดอายุ', {
                    body: messages[type],
                    icon: '/favicon.ico',
                    tag: 'otac-expiry'
                });
            }
        }
        
        showExpiredState() {
            const overlay = document.getElementById('expiredOverlay');
            if (overlay) {
                overlay.classList.remove('d-none');
                
                if (window.visualFeedback) {
                    window.visualFeedback.showToast('error', 'หมดอายุแล้ว', 'รหัส OTAC หมดอายุแล้ว ไม่สามารถใช้งานได้อีกต่อไป', { 
                        duration: 0, 
                        closable: true 
                    });
                }
            }
        }
        
        handleError(error) {
            this.isGenerating = false;
            
            // Hide progress modal if shown
            if (this.progressModal) {
                this.progressModal.hide();
            }
            
            // Show error in retry section
            const retrySection = document.getElementById('retrySection');
            const errorMessage = document.getElementById('errorMessage');
            
            if (retrySection && errorMessage) {
                errorMessage.textContent = error.message || 'เกิดข้อผิดพลาดที่ไม่คาดคิด';
                retrySection.classList.remove('d-none');
                
                // Show progress modal again to display error
                this.progressModal.show();
            }
            
            // Show error notification
            if (window.visualFeedback) {
                window.visualFeedback.showErrorAnimation(null, {
                    title: 'เกิดข้อผิดพลาด',
                    message: error.message || 'ไม่สามารถสร้างรหัส OTAC ได้',
                    duration: 5000
                });
            }
            
            console.error('OTAC Generation Error:', error);
        }
        
        updateConnectionStatus(isOnline) {
            const statusEl = document.getElementById('connectionStatus');
            if (statusEl) {
                if (isOnline) {
                    statusEl.innerHTML = '<i class="fas fa-wifi text-success me-1"></i><small>เชื่อมต่อแล้ว</small>';
                    statusEl.classList.remove('connection-error');
                } else {
                    statusEl.innerHTML = '<i class="fas fa-wifi text-danger me-1"></i><small>การเชื่อมต่อขาดหาย</small>';
                    statusEl.classList.add('connection-error');
                }
            }
        }
        
        resetProgressState() {
            const progressBar = document.getElementById('progressBarEnhanced');
            const retrySection = document.getElementById('retrySection');
            
            if (progressBar) {
                progressBar.style.width = '0%';
                progressBar.setAttribute('aria-valuenow', '0');
                progressBar.classList.remove('bg-success');
            }
            
            if (retrySection) {
                retrySection.classList.add('d-none');
            }
            
            this.currentStep = 0;
        }
        
        cleanup() {
            this.isGenerating = false;
            
            if (this.progressInterval) {
                clearInterval(this.progressInterval);
                this.progressInterval = null;
            }
            
            this.resetProgressState();
        }
        
        stopCountdown() {
            if (this.countdownInterval) {
                clearInterval(this.countdownInterval);
                this.countdownInterval = null;
            }
        }
        
        // CRITICAL FIX: Comprehensive table refresh after OTAC creation
        refreshTableAfterSuccess() {
            console.log('Priority 2: Attempting table refresh after OTAC creation success');
            
            // Strategy 1: Try window.refreshTable if available
            if (typeof window.refreshTable === 'function') {
                console.log('Priority 2: Using window.refreshTable()');
                setTimeout(() => {
                    window.refreshTable();
                }, 1000);
                return;
            }
            
            // Strategy 2: Try direct fetch to refresh data
            if (this.tryFetchTableRefresh()) {
                console.log('Priority 2: Using direct fetch table refresh');
                return;
            }
            
            // Strategy 3: Page reload as fallback
            console.log('Priority 2: Using page reload as fallback');
            setTimeout(() => {
                window.location.reload();
            }, 2000);
        }
        
        // Direct fetch table refresh method
        tryFetchTableRefresh() {
            try {
                const currentUrl = window.location.href;
                const url = new URL(currentUrl);
                
                // Keep current filters but ensure we get fresh data
                url.searchParams.delete('_t'); // Remove any cache buster
                url.searchParams.set('_t', Date.now()); // Add new cache buster
                
                fetch(url.toString())
                    .then(response => {
                        if (!response.ok) throw new Error('Fetch failed');
                        return response.text();
                    })
                    .then(html => {
                        // Parse the response to extract table content
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newTable = doc.querySelector('.odd-table tbody');
                        const currentTable = document.querySelector('.odd-table tbody');
                        
                        if (newTable && currentTable) {
                            console.log('Priority 2: Successfully refreshed table content');
                            currentTable.innerHTML = newTable.innerHTML;
                            
                            // Update statistics if available
                            const newStats = doc.querySelector('.odd-table-stats');
                            const currentStats = document.querySelector('.odd-table-stats');
                            if (newStats && currentStats) {
                                currentStats.innerHTML = newStats.innerHTML;
                            }
                            
                            // Show success feedback
                            if (window.visualFeedback) {
                                window.visualFeedback.showToast('success', 'อัพเดทแล้ว', 'ข้อมูลตารางได้รับการอัพเดทล่าสุดแล้ว', { duration: 2000 });
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Priority 2: Direct fetch table refresh failed:', error);
                        // Fallback to page reload
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    });
                
                return true;
            } catch (error) {
                console.error('Priority 2: tryFetchTableRefresh error:', error);
                return false;
            }
        }
    }
    
    // Enhanced global functions for Priority 2 features
    let priority2System = null;
    
    document.addEventListener('DOMContentLoaded', function() {
        priority2System = new Priority2OtacSystem();
    });
    
    // Main function for button integration
    window.generateOtacImmediately = function() {
        console.log('generateOtacImmediately called - using Priority 2 enhanced system');
        
        if (priority2System) {
            priority2System.generateOtac();
        } else {
            console.error('Priority 2 system not initialized');
            // Fallback to simple generation
            fallbackOtacGeneration();
        }
    };
    
    // Enhanced copy function with P2 visual feedback
    window.copyOtacCode = function() {
        const codeInput = document.getElementById('resultGeneratedCode');
        if (!codeInput) return;
        
        const textToCopy = codeInput.value;
        
        navigator.clipboard.writeText(textToCopy).then(() => {
            // Enhanced visual feedback for single copy button with accessibility
            const copyButton = document.getElementById('copyButton');
            const liveRegion = document.getElementById('copyStatusLive');
            
            if (copyButton) {
                const originalContent = copyButton.innerHTML;
                const originalAriaLabel = copyButton.getAttribute('aria-label');
                
                // Update button state
                copyButton.innerHTML = '<i class="fas fa-check-circle me-2"></i><span class="copy-text">คัดลอกสำเร็จ!</span>';
                copyButton.classList.add('copied');
                copyButton.disabled = true;
                copyButton.setAttribute('aria-label', 'คัดลอกสำเร็จแล้ว');
                copyButton.setAttribute('aria-pressed', 'true');
                
                // Announce to screen readers
                if (liveRegion) {
                    liveRegion.textContent = `คัดลอกรหัส ${textToCopy} สำเร็จแล้ว`;
                }
                
                // Add success pulse animation
                copyButton.style.animation = 'primaryCopySuccess 1s ease-out';
                
                setTimeout(() => {
                    copyButton.innerHTML = originalContent;
                    copyButton.classList.remove('copied');
                    copyButton.disabled = false;
                    copyButton.style.animation = '';
                    copyButton.setAttribute('aria-label', originalAriaLabel);
                    copyButton.removeAttribute('aria-pressed');
                    
                    // Clear live region
                    if (liveRegion) {
                        liveRegion.textContent = '';
                    }
                }, 2500);
            }
            
            // Visual feedback system
            if (window.visualFeedback) {
                window.visualFeedback.showCopyFeedback(codeInput);
                window.visualFeedback.showToast('success', 'คัดลอกสำเร็จ', `คัดลอกรหัส ${textToCopy} เรียบร้อยแล้ว`, { duration: 2000 });
            }
            
            // Haptic feedback
            if (navigator.vibrate) {
                navigator.vibrate(50);
            }
            
        }).catch(err => {
            console.error('Copy failed:', err);
            
            // Fallback: select text
            codeInput.focus();
            codeInput.select();
            
            // Announce fallback to screen readers
            const liveRegion = document.getElementById('copyStatusLive');
            if (liveRegion) {
                liveRegion.textContent = 'กรุณาเลือกข้อความและใช้ Ctrl+C เพื่อคัดลอก';
            }
            
            if (window.visualFeedback) {
                window.visualFeedback.showToast('warning', 'คัดลอกด้วยตนเอง', 'กรุณาใช้ Ctrl+C เพื่อคัดลอก', { duration: 3000 });
            }
        });
    };
    
    // Enhanced retry function
    window.retryOtacGeneration = function() {
        if (priority2System) {
            const retrySection = document.getElementById('retrySection');
            if (retrySection) {
                retrySection.classList.add('d-none');
            }
            
            // Small delay before retry
            setTimeout(() => {
                priority2System.generateOtac();
            }, 500);
        }
    };
    
    // Cancel generation function
    window.cancelOtacGeneration = function() {
        if (priority2System && priority2System.progressModal) {
            priority2System.progressModal.hide();
        }
    };
    
    // Generate another OTAC function
    window.generateAnotherOtac = function() {
        if (priority2System && priority2System.resultsModal) {
            priority2System.resultsModal.hide();
            
            setTimeout(() => {
                priority2System.generateOtac();
            }, 300);
        }
    };
    
    // Close expired modal and generate new
    window.closeExpiredModal = function() {
        if (priority2System && priority2System.resultsModal) {
            priority2System.resultsModal.hide();
            
            setTimeout(() => {
                priority2System.generateOtac();
            }, 500);
        }
    };
    
    // Fallback generation for compatibility
    function fallbackOtacGeneration() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const generateUrl = '/Admin/Otac/GenerateForKBankOdd';
        
        if (!token) {
            alert('เกิดข้อผิดพลาด: ไม่พบ Security Token กรุณาโหลดหน้าใหม่');
            return;
        }
        
        const generateButton = document.getElementById('generateOtacButton');
        if (generateButton) {
            generateButton.disabled = true;
            generateButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>กำลังสร้าง OTAC...';
        }
        
        fetch(generateUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
        })
        .then(response => response.json())
        .then(data => {
            if (generateButton) {
                generateButton.disabled = false;
                generateButton.innerHTML = '<i class="fas fa-key me-1"></i>เพิ่มข้อมูล';
            }
            
            if (data.success) {
                alert(`สร้าง OTAC Code สำเร็จ!\n\nรหัส OTAC: ${data.code || data.otacCode || 'N/A'}\nจำนวนที่สร้าง: ${data.generatedCount || 0} รายการ`);
                window.location.reload();
            } else {
                alert('เกิดข้อผิดพลาด: ' + (data.message || 'ไม่สามารถสร้าง OTAC Code ได้'));
            }
        })
        .catch(error => {
            if (generateButton) {
                generateButton.disabled = false;
                generateButton.innerHTML = '<i class="fas fa-key me-1"></i>เพิ่มข้อมูล';
            }
            
            console.error('OTAC generation error:', error);
            alert('เกิดข้อผิดพลาดในการเชื่อมต่อ: ' + error.message);
        });
    }

    // Global OTAC Modal Functions (legacy compatibility)
    window.OtacModals = {
        // Generate OTAC Modal
        openGenerate: function(registrationId = null) {
            const url = registrationId ? 
                `@Url.Action("GenerateModal", "Otac")?registrationId=${registrationId}` : 
                `@Url.Action("GenerateModal", "Otac")`;
                
            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('otacModalContainer').innerHTML = html;
                    const modal = new bootstrap.Modal(document.getElementById('generateOtacModal'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error loading Generate OTAC modal:', error);
                    showAlert('danger', 'Failed to load OTAC generation form.');
                });
        },
        
        // Validate OTAC Modal
        openValidate: function() {
            fetch(`@Url.Action("ValidateModal", "Otac")`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('otacModalContainer').innerHTML = html;
                    const modal = new bootstrap.Modal(document.getElementById('validateOtacModal'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error loading Validate OTAC modal:', error);
                    showAlert('danger', 'Failed to load OTAC validation form.');
                });
        }
    };
    
    // Convenience functions for backward compatibility
    function openGenerateOtacModal(registrationId = null) {
        OtacModals.openGenerate(registrationId);
    }
    
    function openValidateOtacModal() {
        OtacModals.openValidate();
    }
    
    function generateOTAC(registrationId) {
        OtacModals.openGenerate(registrationId);
    }
    
    // OTAC actions now managed through page-specific controls
    
    // Alert helper function (if not already defined)
    if (typeof showAlert === 'undefined') {
        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1060; min-width: 300px;';
            alertDiv.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);

            // Auto-remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    }
</script>

