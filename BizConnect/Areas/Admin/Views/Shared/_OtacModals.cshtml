<!-- OTAC Modal Container - Include this in admin pages that need OTAC functionality -->

<!-- Modal Container for Dynamic Loading -->
<div id="otacModalContainer"></div>

<!-- Priority 2: Enhanced Progressive OTAC Generation Modal -->
<div class="modal fade" id="otacProgressModal" tabindex="-1" aria-labelledby="otacProgressModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0 d-flex align-items-center modern-modal-header">
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm me-3" role="status" aria-hidden="true"></div>
                    <h5 class="modal-title mb-0" id="otacProgressModalLabel">
                        <i class="fas fa-cog fa-spin me-2"></i>กำลังสร้างรหัส OTAC
                    </h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div id="connectionStatus">
                        <i class="fas fa-wifi text-success me-1"></i>
                        <small>เชื่อมต่อแล้ว</small>
                    </div>
                    <!-- Close button removed per user request -->
                </div>
            </div>
            
            <div class="modal-body p-4">
                <!-- 4-Step Progress System -->
                <div class="mb-4">
                    <div class="progress progress-lg mb-3" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="progressBarEnhanced" style="width: 0%"></div>
                    </div>
                    
                    <!-- Step Messages Card -->
                    <div class="card border-primary">
                        <div class="card-body text-center py-3">
                            <h6 class="card-title mb-2" id="currentStepMessage">
                                <i class="fas fa-hourglass-start me-2 text-primary"></i>กำลังเตรียมการสร้างรหัส...
                            </h6>
                            <p class="card-text text-muted small mb-1" id="stepDetails">
                                ระบบกำลังเตรียมความพร้อมสำหรับการสร้างรหัสยืนยันตัวตนแบบใช้ครั้งเดียว
                            </p>
                            <small class="text-info" id="timeEstimate">
                                <i class="fas fa-clock me-1"></i>ประมาณ <span id="estimatedSeconds">5</span> วินาที
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Security Guidelines (shown during loading) -->
                <div class="alert alert-warning border-0" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-shield-alt fa-2x text-warning me-3 mt-1"></i>
                        <div>
                            <h6 class="alert-heading mb-2">
                                <i class="fas fa-exclamation-triangle me-1"></i>แนวทางด้านความปลอดภัย
                            </h6>
                            <ul class="mb-0 small">
                                <li class="mb-1">รหัสจะมีอายุการใช้งาน 30 นาทีเท่านั้น</li>
                                <li class="mb-1">ห้ามแจกจ่ายรหัสผ่านช่องทางออนไลน์</li>
                                <li class="mb-1">ใช้ได้เพียงครั้งเดียว หลังจากนั้นจะหมดอายุทันที</li>
                                <li>ระบบจะบันทึกการใช้งานทั้งหมดเพื่อการตรวจสอบ</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Error/Retry Section (hidden by default) -->
                <div id="retrySection" class="retry-section d-none">
                    <div class="alert alert-danger border-0" role="alert">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-exclamation-circle fa-2x text-danger me-3 mt-1"></i>
                            <div class="flex-grow-1">
                                <h6 class="alert-heading mb-2">เกิดข้อผิดพลาดในการสร้างรหัส</h6>
                                <p class="mb-3" id="errorMessage">เกิดข้อผิดพลาดที่ไม่คาดคิด กรุณาลองใหม่อีกครั้ง</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-danger btn-sm" onclick="retryOtacGeneration()">
                                        <i class="fas fa-redo me-1"></i>ลองใหม่
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" onclick="cancelOtacGeneration()">
                                        <i class="fas fa-times me-1"></i>ยกเลิก
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

