                        <!-- FIXED: Enhanced Primary Copy Button with clear positioning -->
                        <div class="text-center mt-4 copy-button-container">
                            <button class="btn btn-success copy-button primary-copy-btn" 
                                    type="button" 
                                    onclick="copyOtacCode()" 
