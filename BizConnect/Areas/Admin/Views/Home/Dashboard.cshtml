@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <style>
        .bc-admin-dashboard {
            background-color: var(--bc-gray-50);
            min-height: calc(100vh - 200px);
        }
    </style>
}

<div class="bc-admin-dashboard">
    <!-- Dashboard Header -->
    <div class="bc-dashboard-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="bc-dashboard-title-section">
                        <h1 class="bc-dashboard-title">
                            <i class="fas fa-tachometer-alt me-3"></i>Admin Dashboard
                        </h1>
                        <p class="bc-dashboard-subtitle">
                            Monitor system performance, manage users, and oversee platform operations
                        </p>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="bc-dashboard-actions">
                        <button class="btn btn-outline-primary me-2" onclick="refreshDashboard()">
                            <i class="fas fa-sync-alt me-1"></i>Refresh
                        </button>
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cog me-1"></i>Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-download me-2"></i>Export Data</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-chart-bar me-2"></i>Generate Report</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="LoadingDemo" asp-area="Admin"><i class="fas fa-spinner me-2"></i>Loading Demo</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="InteractionsDemo" asp-area="Admin"><i class="fas fa-magic me-2"></i>Interactions Demo</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Error Pages Demo</h6></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="NotFound"><i class="fas fa-search me-2"></i>404 Not Found</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="AccessDenied"><i class="fas fa-shield-alt me-2"></i>403 Access Denied</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="ServerError"><i class="fas fa-server me-2"></i>500 Server Error</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-cogs me-2"></i>System Settings</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <section class="bc-metrics-section">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-xl-3 col-md-6">
                    <div class="bc-metric-card hover-lift bc-tilt bc-ripple bc-slide-in-up" style="animation-delay: 0.1s;">
                        <div class="bc-metric-header">
                            <div class="bc-metric-icon bg-primary bc-glow">
                                <i class="fas fa-users bc-pulse"></i>
                            </div>
                            <div class="bc-metric-trend positive">
                                <i class="fas fa-arrow-up"></i>
                                <span>+12%</span>
                            </div>
                        </div>
                        <div class="bc-metric-content">
                            <h3 class="bc-metric-number bc-counter" data-target="@Model.TotalUsers">0</h3>
                            <p class="bc-metric-label">Total Users</p>
                            <div class="bc-metric-progress">
                                <div class="progress">
                                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                                </div>
                                <small class="text-muted">75% of target</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="bc-metric-card hover-lift">
                        <div class="bc-metric-header">
                            <div class="bc-metric-icon bg-success">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="bc-metric-trend positive">
                                <i class="fas fa-arrow-up"></i>
                                <span>+8%</span>
                            </div>
                        </div>
                        <div class="bc-metric-content">
                            <h3 class="bc-metric-number">@Model.ActiveUsers</h3>
                            <p class="bc-metric-label">Active Users</p>
                            <div class="bc-metric-progress">
                                <div class="progress">
                                    <div class="progress-bar bg-success" style="width: @(Model.TotalUsers > 0 ? (Model.ActiveUsers * 100 / Model.TotalUsers) : 0)%"></div>
                                </div>
                                <small class="text-muted">@(Model.TotalUsers > 0 ? Math.Round((double)Model.ActiveUsers * 100 / Model.TotalUsers, 1) : 0)% active rate</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="bc-metric-card hover-lift">
                        <div class="bc-metric-header">
                            <div class="bc-metric-icon bg-info">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="bc-metric-trend neutral">
                                <i class="fas fa-minus"></i>
                                <span>0%</span>
                            </div>
                        </div>
                        <div class="bc-metric-content">
                            <h3 class="bc-metric-number">@Model.AdminUsers</h3>
                            <p class="bc-metric-label">Admin Users</p>
                            <div class="bc-metric-progress">
                                <div class="progress">
                                    <div class="progress-bar bg-info" style="width: @(Model.TotalUsers > 0 ? (Model.AdminUsers * 100 / Model.TotalUsers) : 0)%"></div>
                                </div>
                                <small class="text-muted">@(Model.TotalUsers > 0 ? Math.Round((double)Model.AdminUsers * 100 / Model.TotalUsers, 1) : 0)% of total</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="bc-metric-card hover-lift">
                        <div class="bc-metric-header">
                            <div class="bc-metric-icon bg-warning">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="bc-metric-trend positive">
                                <i class="fas fa-arrow-up"></i>
                                <span>+15%</span>
                            </div>
                        </div>
                        <div class="bc-metric-content">
                            <h3 class="bc-metric-number">@Model.RegularUsers</h3>
                            <p class="bc-metric-label">Regular Users</p>
                            <div class="bc-metric-progress">
                                <div class="progress">
                                    <div class="progress-bar bg-warning" style="width: @(Model.TotalUsers > 0 ? (Model.RegularUsers * 100 / Model.TotalUsers) : 0)%"></div>
                                </div>
                                <small class="text-muted">@(Model.TotalUsers > 0 ? Math.Round((double)Model.RegularUsers * 100 / Model.TotalUsers, 1) : 0)% of total</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Charts and Analytics -->
    <section class="bc-analytics-section">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="bc-chart-card">
                        <div class="bc-chart-header">
                            <h3 class="bc-chart-title">User Growth Trend</h3>
                            <div class="bc-chart-controls">
                                <div class="btn-group" role="group">
                                    <input type="radio" class="btn-check" name="chartPeriod" id="chart7d" checked>
                                    <label class="btn btn-outline-primary btn-sm" for="chart7d">7D</label>

                                    <input type="radio" class="btn-check" name="chartPeriod" id="chart30d">
                                    <label class="btn btn-outline-primary btn-sm" for="chart30d">30D</label>

                                    <input type="radio" class="btn-check" name="chartPeriod" id="chart90d">
                                    <label class="btn btn-outline-primary btn-sm" for="chart90d">90D</label>
                                </div>
                            </div>
                        </div>
                        <div class="bc-chart-content">
                            <div class="bc-chart-placeholder">
                                <div class="bc-chart-visual">
                                    <svg viewBox="0 0 600 200" class="bc-line-chart">
                                        <defs>
                                            <linearGradient id="chartGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                                <stop offset="0%" style="stop-color:var(--bc-primary);stop-opacity:0.3" />
                                                <stop offset="100%" style="stop-color:var(--bc-primary);stop-opacity:0" />
                                            </linearGradient>
                                        </defs>
                                        <polyline fill="none" stroke="var(--bc-primary)" stroke-width="3"
                                                  points="50,150 100,120 150,100 200,80 250,90 300,70 350,60 400,50 450,40 500,30 550,20"/>
                                        <polyline fill="url(#chartGradient)" stroke="none"
                                                  points="50,150 100,120 150,100 200,80 250,90 300,70 350,60 400,50 450,40 500,30 550,20 550,180 50,180"/>
                                    </svg>
                                </div>
                                <div class="bc-chart-stats">
                                    <div class="bc-chart-stat">
                                        <span class="bc-stat-value">+24%</span>
                                        <span class="bc-stat-label">Growth Rate</span>
                                    </div>
                                    <div class="bc-chart-stat">
                                        <span class="bc-stat-value">156</span>
                                        <span class="bc-stat-label">New Users</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="bc-donut-card">
                        <div class="bc-chart-header">
                            <h3 class="bc-chart-title">User Distribution</h3>
                        </div>
                        <div class="bc-donut-content">
                            <div class="bc-donut-chart">
                                <svg viewBox="0 0 200 200" class="bc-donut-svg">
                                    <circle cx="100" cy="100" r="80" fill="none" stroke="var(--bc-gray-200)" stroke-width="20"/>
                                    <circle cx="100" cy="100" r="80" fill="none" stroke="var(--bc-primary)" stroke-width="20"
                                            stroke-dasharray="@(Model.TotalUsers > 0 ? (Model.RegularUsers * 502.65 / Model.TotalUsers) : 0) 502.65"
                                            stroke-dashoffset="125.66" transform="rotate(-90 100 100)"/>
                                    <circle cx="100" cy="100" r="80" fill="none" stroke="var(--bc-success)" stroke-width="20"
                                            stroke-dasharray="@(Model.TotalUsers > 0 ? (Model.AdminUsers * 502.65 / Model.TotalUsers) : 0) 502.65"
                                            stroke-dashoffset="@(125.66 - (Model.TotalUsers > 0 ? (Model.RegularUsers * 502.65 / Model.TotalUsers) : 0))"
                                            transform="rotate(-90 100 100)"/>
                                </svg>
                                <div class="bc-donut-center">
                                    <div class="bc-donut-total">@Model.TotalUsers</div>
                                    <div class="bc-donut-label">Total Users</div>
                                </div>
                            </div>
                            <div class="bc-donut-legend">
                                <div class="bc-legend-item">
                                    <div class="bc-legend-color" style="background-color: var(--bc-primary);"></div>
                                    <span class="bc-legend-label">Regular Users (@Model.RegularUsers)</span>
                                </div>
                                <div class="bc-legend-item">
                                    <div class="bc-legend-color" style="background-color: var(--bc-success);"></div>
                                    <span class="bc-legend-label">Admin Users (@Model.AdminUsers)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Management Panels -->
    <section class="bc-management-section">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="bc-management-card">
                        <div class="bc-management-header">
                            <h3 class="bc-management-title">
                                <i class="fas fa-users-cog me-2"></i>User Management
                            </h3>
                            <div class="bc-management-actions">
                                <a asp-controller="Users" asp-action="Create" asp-area="Admin" class="btn btn-primary">
                                    <i class="fas fa-plus me-1"></i>Create User
                                </a>
                            </div>
                        </div>
                        <div class="bc-management-content">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bc-quick-action">
                                        <div class="bc-quick-action-icon bg-primary">
                                            <i class="fas fa-list"></i>
                                        </div>
                                        <div class="bc-quick-action-content">
                                            <h4 class="bc-quick-action-title">Manage Users</h4>
                                            <p class="bc-quick-action-description">View, edit, and manage all user accounts</p>
                                            <a asp-controller="Users" asp-action="Index" asp-area="Admin" class="bc-quick-action-link">
                                                View All Users <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bc-quick-action">
                                        <div class="bc-quick-action-icon bg-warning">
                                            <i class="fas fa-user-times"></i>
                                        </div>
                                        <div class="bc-quick-action-content">
                                            <h4 class="bc-quick-action-title">Inactive Users</h4>
                                            <p class="bc-quick-action-description">Review and manage inactive accounts</p>
                                            <a href="#" class="bc-quick-action-link" onclick="return false;">
                                                View Inactive <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bc-quick-action">
                                        <div class="bc-quick-action-icon bg-info">
                                            <i class="fas fa-key"></i>
                                        </div>
                                        <div class="bc-quick-action-content">
                                            <h4 class="bc-quick-action-title">Password Resets</h4>
                                            <p class="bc-quick-action-description">Manage password reset requests</p>
                                            <a href="#" class="bc-quick-action-link" onclick="return false;">
                                                View Requests <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bc-quick-action">
                                        <div class="bc-quick-action-icon bg-success">
                                            <i class="fas fa-download"></i>
                                        </div>
                                        <div class="bc-quick-action-content">
                                            <h4 class="bc-quick-action-title">Export Data</h4>
                                            <p class="bc-quick-action-description">Export user data and reports</p>
                                            <a href="#" class="bc-quick-action-link" onclick="return false;">
                                                Export Now <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="bc-system-status-card">
                        <div class="bc-system-header">
                            <h3 class="bc-system-title">
                                <i class="fas fa-server me-2"></i>System Status
                            </h3>
                            <div class="bc-system-indicator online">
                                <i class="fas fa-circle"></i>
                                <span>Online</span>
                            </div>
                        </div>
                        <div class="bc-system-content">
                            <div class="bc-system-metric">
                                <div class="bc-system-metric-header">
                                    <span class="bc-system-metric-label">Database</span>
                                    <span class="bc-system-metric-status online">Healthy</span>
                                </div>
                                <div class="bc-system-metric-bar">
                                    <div class="progress">
                                        <div class="progress-bar bg-success" style="width: 95%"></div>
                                    </div>
                                    <small>95% Performance</small>
                                </div>
                            </div>

                            <div class="bc-system-metric">
                                <div class="bc-system-metric-header">
                                    <span class="bc-system-metric-label">Memory Usage</span>
                                    <span class="bc-system-metric-status warning">Moderate</span>
                                </div>
                                <div class="bc-system-metric-bar">
                                    <div class="progress">
                                        <div class="progress-bar bg-warning" style="width: 68%"></div>
                                    </div>
                                    <small>68% Used</small>
                                </div>
                            </div>

                            <div class="bc-system-metric">
                                <div class="bc-system-metric-header">
                                    <span class="bc-system-metric-label">CPU Usage</span>
                                    <span class="bc-system-metric-status online">Normal</span>
                                </div>
                                <div class="bc-system-metric-bar">
                                    <div class="progress">
                                        <div class="progress-bar bg-primary" style="width: 42%"></div>
                                    </div>
                                    <small>42% Used</small>
                                </div>
                            </div>

                            <div class="bc-system-metric">
                                <div class="bc-system-metric-header">
                                    <span class="bc-system-metric-label">Storage</span>
                                    <span class="bc-system-metric-status online">Good</span>
                                </div>
                                <div class="bc-system-metric-bar">
                                    <div class="progress">
                                        <div class="progress-bar bg-info" style="width: 34%"></div>
                                    </div>
                                    <small>34% Used</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function refreshDashboard() {
            // Add loading state
            const refreshBtn = document.querySelector('[onclick="refreshDashboard()"]');
            const originalText = refreshBtn.innerHTML;
            refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Refreshing...';
            refreshBtn.disabled = true;

            // Simulate refresh (in real app, this would make an AJAX call)
            setTimeout(() => {
                refreshBtn.innerHTML = originalText;
                refreshBtn.disabled = false;

                // Show success message
                const alert = document.createElement('div');
                alert.className = 'alert alert-success alert-dismissible fade show position-fixed';
                alert.style.cssText = 'top: 20px; right: 20px; z-index: 1050; min-width: 300px;';
                alert.innerHTML = `
                    <i class="fas fa-check-circle me-2"></i>Dashboard refreshed successfully!
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alert);

                // Auto-remove after 3 seconds
                setTimeout(() => {
                    if (alert.parentNode) {
                        alert.remove();
                    }
                }, 3000);
            }, 1500);
        }
    </script>
}
