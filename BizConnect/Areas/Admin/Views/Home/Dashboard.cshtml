@model DashboardViewModel
@{
    ViewData["Title"] = "KBank ODD Dashboard";
    ViewBag.Subtitle = "Monitor ODD registrations, OTAC codes, and system performance";
    ViewBag.BreadcrumbSection = "Dashboard";
}

@section HeaderActions {
    <div class="d-flex gap-2">
        <button class="btn-modern btn-outline-modern" onclick="refreshDashboard()">
            <i class="fas fa-sync-alt"></i>Refresh
        </button>
        <div class="dropdown dropdown-modern">
            <button class="btn-modern btn-primary-modern dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-download"></i>Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-excel"></i>Excel Report</a></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-pdf"></i>PDF Report</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-chart-bar"></i>Analytics</a></li>
            </ul>
        </div>
    </div>
}


<div class="admin-dashboard">
    <!-- KBank ODD Overview Widgets -->
    <div class="row g-4 mb-4">
        <!-- ODD Registrations Today -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-widget fade-in-up">
                <div class="stats-icon">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <div class="stats-number" data-target="@Model.TodayOddRegistrations" data-duration="2000">
                    @Model.TodayOddRegistrations
                </div>
                <div class="stats-label">Today's Registrations</div>
                <div class="d-flex justify-content-between mt-3">
                    <div class="text-center">
                        <div class="badge-modern badge-warning">@Model.PendingOddRegistrations</div>
                        <small class="d-block text-muted mt-1">Pending</small>
                    </div>
                    <div class="text-center">
                        <div class="badge-modern badge-success">@Model.CompletedOddRegistrations</div>
                        <small class="d-block text-muted mt-1">Completed</small>
                    </div>
                </div>
                <div class="position-absolute top-0 end-0 p-3">
                    <small class="text-success d-flex align-items-center">
                        <i class="fas fa-arrow-up me-1"></i>
                        +@((Model.TodayOddRegistrations > 0 ? ((double)Model.TodayOddRegistrations / Math.Max(Model.TotalOddRegistrations - Model.TodayOddRegistrations, 1) * 100) : 0).ToString("F0"))%
                    </small>
                </div>
            </div>
        </div>

        <!-- OTAC Codes Generated -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-widget fade-in-up" style="animation-delay: 0.1s;">
                <div class="stats-icon" style="background: var(--gradient-success);">
                    <i class="fas fa-key"></i>
                </div>
                <div class="stats-number" data-target="@Model.ActiveOtacCodes" data-duration="2000">
                    @Model.ActiveOtacCodes
                </div>
                <div class="stats-label">Active OTAC Codes</div>
                <div class="progress-modern mt-3">
                    <div class="progress-bar-modern" data-value="@(Model.OtacUsageRate)%" style="background: var(--gradient-success);"></div>
                </div>
                <small class="text-muted d-flex justify-content-between mt-2">
                    <span>Usage Rate</span>
                    <span class="fw-semibold">@Model.OtacUsageRate%</span>
                </small>
                <div class="position-absolute top-0 end-0 p-3">
                    <small class="text-success d-flex align-items-center">
                        <i class="fas fa-plus me-1"></i>
                        @Model.TodayOtacGenerated
                    </small>
                </div>
            </div>
        </div>

        <!-- Success Rate -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-widget fade-in-up" style="animation-delay: 0.2s;">
                <div class="stats-icon" style="background: var(--gradient-primary);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stats-number" data-target="@Model.SuccessRate" data-duration="2000">
                    @Model.SuccessRate%
                </div>
                <div class="stats-label">Success Rate</div>
                <div class="d-flex justify-content-center mt-3">
                    <div class="position-relative" style="width: 80px; height: 80px;">
                        <svg class="w-100 h-100" viewBox="0 0 80 80" style="transform: rotate(-90deg);">
                            <circle cx="40" cy="40" r="30" stroke="var(--gray-200)" stroke-width="6" fill="none" />
                            <circle cx="40" cy="40" r="30" stroke="var(--primary-blue)" stroke-width="6" fill="none"
                                    stroke-dasharray="@(188.5 * Model.SuccessRate / 100) 188.5" 
                                    stroke-linecap="round" class="transition-all duration-1000" />
                        </svg>
                        <div class="position-absolute top-50 start-50 translate-middle text-center">
                            <div class="fw-bold text-primary-modern" style="font-size: 0.9rem;">@Model.SuccessRate%</div>
                        </div>
                    </div>
                </div>
                <small class="text-muted text-center d-block mt-2">
                    @Model.CompletedOddRegistrations of @Model.TotalOddRegistrations completed
                </small>
            </div>
        </div>

        <!-- Monthly Summary -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-widget fade-in-up" style="animation-delay: 0.3s;">
                <div class="stats-icon" style="background: var(--gradient-gold);">
                    <i class="fas fa-calendar-month"></i>
                </div>
                <div class="stats-number" data-target="@Model.ThisMonthOddRegistrations" data-duration="2000">
                    @Model.ThisMonthOddRegistrations
                </div>
                <div class="stats-label">Monthly Registrations</div>
                <div class="d-flex justify-content-between mt-3">
                    <div class="text-center">
                        <div class="badge-modern badge-danger">@Model.FailedOddRegistrations</div>
                        <small class="d-block text-muted mt-1">Failed</small>
                    </div>
                    <div class="text-center">
                        <div class="badge-modern badge-primary">@Model.ExpiredOtacCodes</div>
                        <small class="d-block text-muted mt-1">Expired</small>
                    </div>
                </div>
                <div class="position-absolute top-0 end-0 p-3">
                    <small class="text-gold d-flex align-items-center">
                        <i class="fas fa-calendar me-1"></i>
                        This Month
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity and Quick Actions -->
    <div class="row g-4">
        <!-- Recent ODD Registrations -->
        <div class="col-lg-8">
            <div class="glass-card fade-in-up" style="animation-delay: 0.4s;">
                <div class="card-modern-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-modern-title">
                            <i class="fas fa-clock me-2 text-kbank"></i>
                            Recent ODD Registrations
                        </h3>
                        <a href="#" class="btn-modern btn-outline-modern">
                            <i class="fas fa-list"></i>View All
                        </a>
                    </div>
                </div>
                <div class="card-modern-body">
                    @if (Model.RecentRegistrations.Any())
                    {
                        <div class="recent-activity">
                            @foreach (var registration in Model.RecentRegistrations)
                            {
                                <div class="d-flex align-items-center p-3 mb-3 glass rounded-3 transition-all hover:shadow-md">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="status-indicator status-@(registration?.Status?.ToLower())">
                                            <div class="status-dot"></div>
                                            <span>@registration.Status</span>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold text-dark mb-1">Registration @registration.ExternalReference</div>
                                        <div class="text-muted small">
                                            <i class="fas fa-clock me-1"></i>@registration.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                            @if (!string.IsNullOrEmpty(registration.FullName))
                                            {
                                                <span class="ms-3"><i class="fas fa-user me-1"></i>@registration.FullName</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <div class="action-group">
                                            <a href="#" class="action-btn action-btn-view" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fas fa-inbox"></i>
                            </div>
                            <h4 class="empty-state-title">No Recent Registrations</h4>
                            <p class="empty-state-message">No ODD registrations have been created recently. Check back later for updates.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions & System Status -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="glass-card mb-4 fade-in-up" style="animation-delay: 0.5s;">
                <div class="card-modern-header">
                    <h3 class="card-modern-title">
                        <i class="fas fa-bolt me-2 text-gold"></i>
                        Quick Actions
                    </h3>
                </div>
                <div class="card-modern-body">
                    <div class="d-grid gap-3">
                        <a asp-controller="Otac" asp-action="Index" asp-area="Admin" class="btn-modern btn-kbank">
                            <i class="fas fa-key"></i>Generate OTAC
                        </a>
                        <a href="#" class="btn-modern btn-primary-modern">
                            <i class="fas fa-upload"></i>Import Excel
                        </a>
                        <a href="#" class="btn-modern btn-gold">
                            <i class="fas fa-download"></i>Export Data
                        </a>
                        <a asp-controller="Users" asp-action="Create" asp-area="Admin" class="btn-modern btn-outline-modern">
                            <i class="fas fa-user-plus"></i>Add User
                        </a>
                    </div>
                </div>
            </div>

            <!-- System Status -->
            <div class="glass-card fade-in-up" style="animation-delay: 0.6s;">
                <div class="card-modern-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-modern-title">
                            <i class="fas fa-server me-2 text-primary-modern"></i>
                            System Status
                        </h3>
                        <span class="badge-modern badge-success">Online</span>
                    </div>
                </div>
                <div class="card-modern-body">
                    <div class="space-y-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-database me-2 text-kbank"></i>
                                <span class="text-muted">Database</span>
                            </div>
                            <span class="badge-modern badge-success">Healthy</span>
                        </div>
                        <div class="progress-modern mb-4">
                            <div class="progress-bar-modern" data-value="95%" style="background: var(--gradient-success);"></div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-key me-2 text-kbank"></i>
                                <span class="text-muted">OTAC Service</span>
                            </div>
                            <span class="badge-modern badge-success">Active</span>
                        </div>
                        <div class="progress-modern mb-4">
                            <div class="progress-bar-modern" data-value="100%" style="background: var(--gradient-success);"></div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-cloud me-2 text-kbank"></i>
                                <span class="text-muted">API Status</span>
                            </div>
                            <span class="badge-modern badge-warning">Monitoring</span>
                        </div>
                        <div class="progress-modern mb-4">
                            <div class="progress-bar-modern" data-value="85%" style="background: linear-gradient(135deg, var(--warning) 0%, var(--warning-dark) 100%);"></div>
                        </div>
                        
                        <div class="text-center pt-3 border-top border-glass">
                            <small class="text-muted d-flex align-items-center justify-content-center">
                                <i class="fas fa-sync-alt me-2"></i>
                                Last updated: @DateTime.Now.ToString("HH:mm:ss")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function refreshDashboard() {
            // Add loading state using modern UI interactions
            const refreshBtn = document.querySelector('[onclick="refreshDashboard()"]');
            if (refreshBtn && window.uiInteractions) {
                window.uiInteractions.showButtonLoading(refreshBtn);
                
                // Simulate refresh (in real app, this would make an AJAX call)
                setTimeout(() => {
                    window.uiInteractions.hideButtonLoading(refreshBtn);
                    
                    // Re-animate counters after refresh
                    const counters = document.querySelectorAll('.stats-number[data-target]');
                    counters.forEach(counter => {
                        const target = parseInt(counter.dataset.target);
                        const duration = parseInt(counter.dataset.duration) || 2000;
                        if (window.uiInteractions.animateCounter) {
                            window.uiInteractions.animateCounter(counter, 0, target, duration);
                        }
                    });
                    
                    // Show success toast
                    if (window.uiInteractions.showToast) {
                        window.uiInteractions.showToast('success', 'Dashboard Refreshed', 'All data has been updated successfully');
                    }
                }, 1500);
            }
        }

        // Initialize dashboard when DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            // Add staggered animation to widgets
            const widgets = document.querySelectorAll('.stats-widget, .glass-card');
            widgets.forEach((widget, index) => {
                widget.style.animationDelay = `${index * 0.1}s`;
                widget.classList.add('fade-in-up');
            });

            // Initialize progress bars after page load
            setTimeout(() => {
                const progressBars = document.querySelectorAll('.progress-bar-modern[data-value]');
                progressBars.forEach(bar => {
                    bar.style.width = bar.dataset.value;
                });
            }, 500);

            // Real-time clock update
            function updateClock() {
                const clockElements = document.querySelectorAll('[data-clock]');
                clockElements.forEach(element => {
                    element.textContent = new Date().toLocaleTimeString();
                });
            }
            
            setInterval(updateClock, 1000);
        });
    </script>
}
