    private async Task<List<SuspiciousPattern>> DetectTimeBasedAnomaliesAsync(List<SecurityEvent> events)
    {
        var patterns = new List<SuspiciousPattern>();
        
        // Detect off-hours activity spikes
        var offHoursEvents = events.Where(e => e.Timestamp.Hour < 6 || e.Timestamp.Hour > 22).ToList();
        var groupedByIp = offHoursEvents.GroupBy(e => e.IpAddress);
        
        foreach (var group in groupedByIp)
        {
            if (group.Count() >= 10) // Significant off-hours activity
            {
                patterns.Add(new SuspiciousPattern
                {
                    PatternType = "OffHoursActivity",
                    Description = $"IP {group.Key} had {group.Count()} events during off-hours",
                    DetectedAt = _dateTimeProvider.UtcNow,
                    IpAddress = group.Key,
                    EventCount = group.Count(),
                    Severity = ThreatSeverity.Medium,
                    Confidence = 0.7,
                    Evidence = new Dictionary<string, object>
                    {
                        ["OffHoursEvents"] = group.Count(),
                        ["Hours"] = group.Select(e => e.Timestamp.Hour).Distinct().ToList()
                    }
                });
            }
        }
        
        return patterns;
    }
    
    // Response execution methods
    private List<SecurityResponseRule> GetApplicableResponseRules(DetectedThreat threat)
    {
        return _responseRules.Values
            .Where(r => r.IsEnabled && 
                       (r.ThreatType == "*" || r.ThreatType == threat.ThreatType) &&
                       r.MinSeverity <= threat.Severity)
            .ToList();
    }
    
    private async Task ExecuteResponseActionAsync(SecurityResponseAction action, DetectedThreat threat)
    {
        switch (action.ActionType.ToUpper())
        {
            case "BLOCK_IP":
                await BlockIpAddressAsync(threat.IpAddress, action.Parameters);
                break;
            case "LOCKOUT_USER":
                if (!string.IsNullOrEmpty(threat.Username))
                    await LockoutUserAsync(threat.Username, action.Parameters);
                break;
            case "ALERT_ADMIN":
                await CreateSecurityAlertAsync(threat);
                break;
            case "INCREASE_MONITORING":
                await IncreaseMonitoringAsync(threat.IpAddress, action.Parameters);
                break;
            case "LOG_EVENT":
                _logger.LogWarning("Security response action executed for threat {ThreatId}: {ThreatType}", 
                    threat.Id, threat.ThreatType);
                break;
        }
    }
    
    private async Task BlockIpAddressAsync(string ipAddress, Dictionary<string, object> parameters)
    {
        var duration = parameters.ContainsKey("DurationMinutes") 
            ? TimeSpan.FromMinutes(Convert.ToInt32(parameters["DurationMinutes"]))
            : TimeSpan.FromHours(1);
            
        var blockKey = $"SecurityBlock:IP:{ipAddress}";
        await _cacheService.SetAsync(new { BlockedAt = _dateTimeProvider.UtcNow, Reason = "Automated security response" }, 
            blockKey, duration);
            
        _logger.LogWarning("Blocked IP {IpAddress} for {Duration} minutes", ipAddress, duration.TotalMinutes);
    }
    
    private async Task LockoutUserAsync(string username, Dictionary<string, object> parameters)
    {
        var duration = parameters.ContainsKey("DurationMinutes")
            ? TimeSpan.FromMinutes(Convert.ToInt32(parameters["DurationMinutes"]))
            : TimeSpan.FromMinutes(30);
            
        var lockoutKey = $"SecurityLockout:User:{username}";
        await _cacheService.SetAsync(new { LockedAt = _dateTimeProvider.UtcNow, Reason = "Automated security response" }, 
            lockoutKey, duration);
            
        _logger.LogWarning("Locked out user {Username} for {Duration} minutes", username, duration.TotalMinutes);
    }
    
    private async Task CreateSecurityAlertAsync(DetectedThreat threat)
    {
        var alert = new SecurityAlert
        {
            Title = $"Security Threat Detected: {threat.ThreatType}",
            Description = $"Threat detected from IP {threat.IpAddress} with severity {threat.Severity}",
            Severity = threat.Severity,
            CreatedAt = _dateTimeProvider.UtcNow,
            Status = SecurityAlertStatus.New,
            IpAddress = threat.IpAddress,
            Username = threat.Username,
            RelatedEventIds = threat.RelatedEvents.Select(e => e.Id).ToList(),
            Metadata = new Dictionary<string, object>
            {
                ["ThreatId"] = threat.Id,
                ["ThreatType"] = threat.ThreatType,
                ["ThreatIndicators"] = threat.ThreatIndicators
            }
        };
        
        var alertKey = $"{AlertPrefix}:{alert.Id}";
        await _cacheService.SetAsync(alert, alertKey, TimeSpan.FromDays(30));
        
        _logger.LogWarning("Created security alert {AlertId} for threat {ThreatId}", alert.Id, threat.Id);
    }
    
    private async Task IncreaseMonitoringAsync(string ipAddress, Dictionary<string, object> parameters)
    {
        var duration = parameters.ContainsKey("DurationMinutes")
            ? TimeSpan.FromMinutes(Convert.ToInt32(parameters["DurationMinutes"]))
            : TimeSpan.FromHours(4);
            
        var monitoringKey = $"SecurityMonitoring:Enhanced:{ipAddress}";
        await _cacheService.SetAsync(new { StartedAt = _dateTimeProvider.UtcNow }, monitoringKey, duration);
        
        _logger.LogInformation("Increased monitoring for IP {IpAddress} for {Duration} minutes", 
            ipAddress, duration.TotalMinutes);
    }
    
    // Data retrieval methods
    private async Task<List<SecurityEvent>> GetRecentSecurityEventsAsync(DateTime cutoffTime)
    {
        var events = new List<SecurityEvent>();
        var currentHour = _dateTimeProvider.UtcNow;
        
        // Get events from recent hours
        for (int i = 0; i <= (int)(_dateTimeProvider.UtcNow - cutoffTime).TotalHours + 1; i++)
        {
            var hour = currentHour.AddHours(-i);
            var timeKey = $"{SecurityEventPrefix}:ByTime:{hour:yyyyMMddHH}";
            var eventIds = await _cacheService.GetAsync<List<string>>(timeKey);
            
            if (eventIds != null)
            {
                foreach (var eventId in eventIds)
                {
                    var eventKey = $"{SecurityEventPrefix}:{eventId}";
                    var securityEvent = await _cacheService.GetAsync<SecurityEvent>(eventKey);
                    if (securityEvent != null && securityEvent.Timestamp >= cutoffTime)
                    {
                        events.Add(securityEvent);
                    }
                }
            }
        }
        
        return events.OrderBy(e => e.Timestamp).ToList();
    }
    
    private async Task<List<SecurityEvent>> GetIpSecurityEventsAsync(string ipAddress, TimeSpan timeWindow)
    {
        var events = new List<SecurityEvent>();
        var ipKey = $"{SecurityEventPrefix}:ByIp:{ipAddress}";
        var eventIds = await _cacheService.GetAsync<List<string>>(ipKey);
        
        if (eventIds != null)
        {
            var cutoffTime = _dateTimeProvider.UtcNow - timeWindow;
            
            foreach (var eventId in eventIds)
            {
                var eventKey = $"{SecurityEventPrefix}:{eventId}";
                var securityEvent = await _cacheService.GetAsync<SecurityEvent>(eventKey);
                if (securityEvent != null && securityEvent.Timestamp >= cutoffTime)
                {
                    events.Add(securityEvent);
                }
            }
        }
        
        return events.OrderBy(e => e.Timestamp).ToList();
    }
    
    // Additional helper methods for dashboard and statistics
    private async Task<SecurityMetrics> GetSecurityMetricsAsync(DateTime cutoffTime)
    {
        var recentEvents = await GetRecentSecurityEventsAsync(cutoffTime);
        var threatEvents = recentEvents.Where(e => e.Severity >= ThreatSeverity.Medium).Count();
        var activeAlerts = await GetActiveAlertsAsync();
        
        return new SecurityMetrics
        {
            TotalEvents = recentEvents.Count,
            ThreatEvents = threatEvents,
            BlockedAttempts = recentEvents.Count(e => e.EventType.Contains("Blocked")),
            ActiveAlerts = activeAlerts.Count,
            WatchlistedIps = await GetWatchlistedIpCountAsync(),
            ThreatDetectionRate = recentEvents.Any() ? (double)threatEvents / recentEvents.Count : 0,
            FalsePositiveRate = 0.05 // Placeholder
        };
    }
    
    private async Task<List<TopThreatIp>> GetTopThreatIpsAsync(int count, DateTime cutoffTime)
    {
        var recentEvents = await GetRecentSecurityEventsAsync(cutoffTime);
        var ipGroups = recentEvents.GroupBy(e => e.IpAddress);
        
        var topIps = ipGroups
            .Select(g => new TopThreatIp
            {
                IpAddress = g.Key,
                EventCount = g.Count(),
                FailedAttempts = g.Count(e => e.EventType.Contains("Failed")),
                LastActivity = g.Max(e => e.Timestamp),
                ThreatScore = CalculateSimpleThreatScore(g.ToList()),
                ThreatTypes = g.Select(e => e.EventType).Distinct().ToList()
            })
            .OrderByDescending(ip => ip.ThreatScore)
            .Take(count)
            .ToList();
            
        return topIps;
    }
    
    private double CalculateSimpleThreatScore(List<SecurityEvent> events)
    {
        var score = events.Count * 2; // Base score
        score += events.Count(e => e.EventType.Contains("Failed")) * 5; // Failed attempts
        score += events.Count(e => e.Severity >= ThreatSeverity.High) * 10; // High severity events
        return Math.Min(100, score);
    }
    
    private async Task<List<SecurityEventSummary>> GetRecentSecurityEventSummariesAsync(DateTime cutoffTime, int count)
    {
        var recentEvents = await GetRecentSecurityEventsAsync(cutoffTime);
        return recentEvents
            .OrderByDescending(e => e.Timestamp)
            .Take(count)
            .Select(e => new SecurityEventSummary
            {
                Id = e.Id,
                Timestamp = e.Timestamp,
                EventType = e.EventType,
                IpAddress = e.IpAddress,
                Severity = e.Severity,
                Description = e.Details ?? e.EventType
            })
            .ToList();
    }
    
    private async Task<Dictionary<string, int>> GetEventTypeCountsAsync(DateTime cutoffTime)
    {
        var recentEvents = await GetRecentSecurityEventsAsync(cutoffTime);
        return recentEvents.GroupBy(e => e.EventType)
            .ToDictionary(g => g.Key, g => g.Count());
    }
    
    private async Task<Dictionary<string, int>> GetThreatTrendDataAsync(TimeSpan timeRange)
    {
        // Generate hourly threat counts for the given time range
        var trendData = new Dictionary<string, int>();
        var currentTime = _dateTimeProvider.UtcNow;
        
        for (int i = 0; i < (int)timeRange.TotalHours; i++)
        {
            var hour = currentTime.AddHours(-i);
            var hourKey = hour.ToString("HH:mm");
            
            var timeKey = $"{SecurityEventPrefix}:ByTime:{hour:yyyyMMddHH}";
            var eventIds = await _cacheService.GetAsync<List<string>>(timeKey);
            var threatCount = 0;
            
            if (eventIds != null)
            {
                foreach (var eventId in eventIds)
                {
                    var eventKey = $"{SecurityEventPrefix}:{eventId}";
                    var securityEvent = await _cacheService.GetAsync<SecurityEvent>(eventKey);
                    if (securityEvent != null && securityEvent.Severity >= ThreatSeverity.Medium)
                    {
                        threatCount++;
                    }
                }
            }
            
            trendData[hourKey] = threatCount;
        }
        
        return trendData;
    }
    
    private async Task<double> CalculateIpThreatScoreAsync(string ipAddress)
    {
        var events = await GetIpSecurityEventsAsync(ipAddress, TimeSpan.FromDays(7));
        return CalculateSimpleThreatScore(events);
    }
    
    private ThreatSeverity DetermineThreatSeverity(double threatScore)
    {
        return threatScore switch
        {
            >= 80 => ThreatSeverity.Critical,
            >= 60 => ThreatSeverity.High,
            >= 40 => ThreatSeverity.Medium,
            _ => ThreatSeverity.Low
        };
    }
    
    private async Task<List<string>> GetThreatCategoriesAsync(string ipAddress)
    {
        var events = await GetIpSecurityEventsAsync(ipAddress, TimeSpan.FromDays(30));
        var categories = new List<string>();
        
        if (events.Any(e => e.EventType.Contains("Failed"))) categories.Add("Brute Force");
        if (events.Any(e => e.EventType.Contains("OTAC"))) categories.Add("OTAC Abuse");
        if (events.Count(e => e.Timestamp.Hour < 6 || e.Timestamp.Hour > 22) > events.Count / 2) 
            categories.Add("Off-Hours Activity");
        if (events.GroupBy(e => e.EventType).Count() == 1) categories.Add("Focused Attack");
        
        return categories;
    }
    
