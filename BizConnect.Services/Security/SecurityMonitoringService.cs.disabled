    private async Task<SecurityMonitoringStatistics> CalculateStatisticsAsync()
    {
        var cutoffTime = _dateTimeProvider.UtcNow.AddHours(-24);
        var recentEvents = await GetRecentSecurityEventsAsync(cutoffTime);
        
        return new SecurityMonitoringStatistics
        {
            GeneratedAt = _dateTimeProvider.UtcNow,
            TotalEventsProcessed = recentEvents.Count,
            ThreatsDetected = recentEvents.Count(e => e.Severity >= ThreatSeverity.Medium),
            AlertsGenerated = (await GetActiveAlertsAsync()).Count,
            ResponsesExecuted = 0, // Would track from actual responses
            AverageResponseTime = 2.5, // Placeholder
            ThreatTypeBreakdown = recentEvents.GroupBy(e => e.EventType).ToDictionary(g => g.Key, g => g.Count()),
            ResponseActionBreakdown = new Dictionary<string, int>() // Would track actual responses
        };
    }
    
    private SecurityMonitoringConfiguration LoadConfiguration()
    {
        var config = new SecurityMonitoringConfiguration();
        _configuration.GetSection("SecurityMonitoring").Bind(config);
        
        // Set defaults
        if (config.ThreatThreshold == 0) config.ThreatThreshold = 60;
        if (config.PatternDetectionIntervalMinutes == 0) config.PatternDetectionIntervalMinutes = 1;
        if (config.EventRetentionDays == 0) config.EventRetentionDays = 30;
        
        return config;
    }
    
    private void LoadDefaultResponseRules()
    {
        var defaultRules = new List<SecurityResponseRule>
        {
            new SecurityResponseRule
            {
                Name = "Critical Threat Response",
                ThreatType = "*",
                MinSeverity = ThreatSeverity.Critical,
                Actions = new List<SecurityResponseAction>
                {
                    new SecurityResponseAction { ActionType = "BLOCK_IP", Parameters = new Dictionary<string, object> { ["DurationMinutes"] = 1440 } },
                    new SecurityResponseAction { ActionType = "ALERT_ADMIN" },
                    new SecurityResponseAction { ActionType = "INCREASE_MONITORING", Parameters = new Dictionary<string, object> { ["DurationMinutes"] = 480 } }
                },
                Priority = 1
            },
            new SecurityResponseRule
            {
                Name = "High Threat Response",
                ThreatType = "*",
                MinSeverity = ThreatSeverity.High,
                Actions = new List<SecurityResponseAction>
                {
                    new SecurityResponseAction { ActionType = "BLOCK_IP", Parameters = new Dictionary<string, object> { ["DurationMinutes"] = 240 } },
                    new SecurityResponseAction { ActionType = "ALERT_ADMIN" },
                    new SecurityResponseAction { ActionType = "INCREASE_MONITORING", Parameters = new Dictionary<string, object> { ["DurationMinutes"] = 120 } }
                },
                Priority = 2
            }
        };
        
        foreach (var rule in defaultRules)
        {
            _responseRules.TryAdd(rule.Id, rule);
        }
    }
    
    private void PerformPatternDetection(object? state)
    {
        Task.Run(async () =>
        {
            try
            {
                var patterns = await DetectSuspiciousPatternsAsync(TimeSpan.FromMinutes(_config.PatternDetectionIntervalMinutes));
                
                // Process detected patterns
                foreach (var pattern in patterns.Where(p => p.Severity >= ThreatSeverity.High))
                {
                    var threat = new DetectedThreat
                    {
                        ThreatType = pattern.PatternType,
                        Severity = pattern.Severity,
                        IpAddress = pattern.IpAddress,
                        DetectedAt = pattern.DetectedAt,
                        ThreatIndicators = new List<string> { pattern.Description },
                        RequiresImmediateAction = pattern.Severity == ThreatSeverity.Critical
                    };
                    
                    await ExecuteAutomatedResponseAsync(threat);
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error during pattern detection");
            }
        });
    }
    
    private void PerformCleanup(object? state)
    {
        Task.Run(async () =>
        {
            try
            {
                // Cleanup old events
                var cutoffTime = _dateTimeProvider.UtcNow.AddDays(-_config.EventRetentionDays);
                // Implementation would remove old events from cache
                
                _logger.LogDebug("Performed security monitoring cleanup");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error during security monitoring cleanup");
            }
        });
    }
    
    public void Dispose()
    {
        _patternDetectionTimer?.Dispose();
        _cleanupTimer?.Dispose();
    }

    #endregion
}

#region Supporting Classes

public class SecurityMonitoringConfiguration
{
    public double ThreatThreshold { get; set; } = 60;
    public int PatternDetectionIntervalMinutes { get; set; } = 1;
    public int EventRetentionDays { get; set; } = 30;
    public bool EnableAutomatedResponse { get; set; } = true;
    public bool EnableGeolocationChecks { get; set; } = false;
    public bool EnableReputationChecks { get; set; } = false;
}

public class WatchlistEntry
{
    public string IpAddress { get; set; } = string.Empty;
    public string Reason { get; set; } = string.Empty;
    public ThreatSeverity Severity { get; set; }
    public DateTime AddedAt { get; set; }
    public bool IsActive { get; set; }
    public string? AddedBy { get; set; }
}

#endregion